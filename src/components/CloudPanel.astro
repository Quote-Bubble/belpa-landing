---
// The cloudscape panel — a full-bleed band of live WebGL clouds that the page
// content floats on. Extracted from the old satellite section when its roof
// animation was promoted into the hero: the sky is the page's only blue
// stretch and the visual rhythm falls apart without it, so it moved here
// rather than being deleted with the rest of that section.
//
// Renders a soft gradient fallback until the shader's first frame, and if
// WebGL is unavailable or the device is low-memory / on save-data the canvas
// removes itself and the gradient is all you get. Pauses when scrolled off
// screen or when the tab is hidden.
---

<div class="cp-bg" aria-hidden="true">
  <canvas class="cp-clouds" data-clouds></canvas>
</div>

<style>
  .cp-bg {
    position: absolute;
    /* Reach well into the hero so blob + sky overlap in the same band */
    top: -380px;
    bottom: -200px;
    left: 0;
    right: 0;
    max-width: 100%;
    overflow: hidden;
    background:
      radial-gradient(ellipse 48% 32% at 18% 34%, rgba(255, 255, 255, 0.72), transparent 68%),
      radial-gradient(ellipse 42% 28% at 68% 38%, rgba(255, 255, 255, 0.65), transparent 66%),
      radial-gradient(ellipse 36% 26% at 42% 58%, rgba(255, 255, 255, 0.45), transparent 70%),
      radial-gradient(ellipse 34% 24% at 82% 62%, rgba(255, 255, 255, 0.55), transparent 65%),
      radial-gradient(ellipse 30% 20% at 28% 70%, rgba(220, 235, 255, 0.4), transparent 68%),
      linear-gradient(180deg, #1f57f0 0%, #2f6bff 45%, #4f8bff 100%);
    /* Soft wide band — longer TOP fade so it dissolves into the blob */
    -webkit-mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.12) 5%,
        rgba(0, 0, 0, 0.5) 12%,
        #000 22%,
        #000 78%,
        rgba(0, 0, 0, 0.5) 88%,
        rgba(0, 0, 0, 0.12) 95%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.08) 10%,
        rgba(0, 0, 0, 0.35) 20%,
        rgba(0, 0, 0, 0.75) 32%,
        #000 42%,
        #000 72%,
        rgba(0, 0, 0, 0.55) 84%,
        rgba(0, 0, 0, 0.15) 92%,
        transparent 100%
      );
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.12) 5%,
        rgba(0, 0, 0, 0.5) 12%,
        #000 22%,
        #000 78%,
        rgba(0, 0, 0, 0.5) 88%,
        rgba(0, 0, 0, 0.12) 95%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.08) 10%,
        rgba(0, 0, 0, 0.35) 20%,
        rgba(0, 0, 0, 0.75) 32%,
        #000 42%,
        #000 72%,
        rgba(0, 0, 0, 0.55) 84%,
        rgba(0, 0, 0, 0.15) 92%,
        transparent 100%
      );
    mask-composite: intersect;
    pointer-events: none;
  }
  /* Mobile: same soft, blended sky as desktop — long fade ramps on every
     side and enough top bleed to hand off from the hero blob's fade tail. */
  @media (max-width: 640px) {
    .cp-bg {
      top: -72px;
      bottom: -80px;
      /* Full-bleed on phones: drop the left/right fades (they framed the blue
         like a white box on a narrow screen) and keep only the top/bottom fade
         for a clean handoff into the page above and below. */
      -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.1) 6%,
        rgba(0, 0, 0, 0.4) 13%,
        rgba(0, 0, 0, 0.8) 20%,
        #000 27%,
        #000 78%,
        rgba(0, 0, 0, 0.5) 89%,
        rgba(0, 0, 0, 0.12) 96%,
        transparent 100%
      );
      -webkit-mask-composite: source-over;
      mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.1) 6%,
        rgba(0, 0, 0, 0.4) 13%,
        rgba(0, 0, 0, 0.8) 20%,
        #000 27%,
        #000 78%,
        rgba(0, 0, 0, 0.5) 89%,
        rgba(0, 0, 0, 0.12) 96%,
        transparent 100%
      );
      mask-composite: add;
    }
  }
  .cp-clouds {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  /* Deep blue scrim under the copy zone: clouds can drift behind the text
     but can never get bright enough there to wash the white type out */
  /* Deep blue scrim under the content. Clouds drift behind white type and
     their tops get bright enough to wash it out entirely, so this guarantees
     contrast no matter what frame the shader is on.
     Centred and wide: the old satellite section had left-aligned copy so this
     was an ellipse at 24%, which left centred content sitting over bare cloud.
     Any layout using this panel must keep its text inside this pool. */
  .cp-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 78% 58% at 50% 46%,
      rgba(13, 42, 140, 0.78) 0%,
      rgba(20, 62, 190, 0.6) 38%,
      rgba(28, 80, 230, 0.28) 62%,
      rgba(31, 87, 240, 0.08) 80%,
      transparent 100%
    );
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .cp-bg::after {
      background: radial-gradient(
        ellipse 95% 58% at 50% 28%,
        rgba(16, 48, 150, 0.62) 0%,
        rgba(24, 70, 200, 0.35) 45%,
        rgba(31, 87, 240, 0.1) 70%,
        transparent 80%
      );
    }
  }
</style>
<script>
  // Cloudscape — sharp WebGL at normal resolution; pauses offscreen.
  // Colors match the hero blob (#1f57f0 / #2f6bff / #4f8bff family).
  const CLOUD_VERT = `
attribute vec2 position;
void main() { gl_Position = vec4(position, 0.0, 1.0); }
`;

  const CLOUD_FRAG = `
precision highp float;
uniform vec2 u_resolution;
uniform float u_time;
uniform vec3 u_colorBottom;
uniform vec3 u_colorMid;
uniform vec3 u_colorTop;

float hash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}
float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}
float fbm(vec2 p) {
  float v = 0.0;
  float a = 0.5;
  mat2 r = mat2(0.8, 0.6, -0.6, 0.8);
  for (int i = 0; i < 5; i++) {
    v += a * noise(p);
    p = r * p * 2.01 + vec2(17.1, 9.3);
    a *= 0.5;
  }
  return v;
}
void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution;
  vec2 p = (uv - 0.5) * vec2(u_resolution.x / max(u_resolution.y, 1.0), 1.0);
  p = mat2(0.96, 0.28, -0.28, 0.96) * p;
  vec2 wind = vec2(u_time * 0.085, u_time * 0.024);
  float large = fbm(p * 0.75 - wind * 0.45);
  float midN = fbm(p * 1.5 - wind + 3.7);
  float fine = fbm(p * 2.6 - wind * 1.2 + 8.0);
  float n = large * 0.5 + midN * 0.35 + fine * 0.15;
  /* Slightly brighter toward the top so it matches the washed blob edge */
  vec3 sky = mix(u_colorMid, u_colorBottom, uv.y * 0.55);
  float cover = smoothstep(0.28, 0.5, n);
  float peaks = smoothstep(0.42, 0.65, n);
  float clouds = clamp(cover * 0.9 + peaks * 0.7, 0.0, 1.0);
  /* Soften cloud intensity near the top handoff into the blob */
  clouds *= mix(0.55, 1.0, smoothstep(0.0, 0.45, uv.y));
  gl_FragColor = vec4(mix(sky, u_colorTop, clouds), 1.0);
}
`;

  const CLOUD_COLORS: [number, number, number][] = [
    [31 / 255, 87 / 255, 240 / 255],   // #1f57f0 — blob core
    [79 / 255, 139 / 255, 255 / 255],  // #4f8bff — blob mid
    [1.0, 1.0, 1.0],                  // bright cloud tops
  ];
  const CLOUD_VER = "blob-4";
  const FRAME_MS = 1000 / 24;

  function preferCssOnly(): boolean {
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    if (nav.connection?.saveData) return true;
    if (typeof nav.deviceMemory === "number" && nav.deviceMemory <= 2) return true;
    return false;
  }

  function initClouds() {
    document.querySelectorAll<HTMLCanvasElement>("canvas[data-clouds]").forEach((canvas) => {
      if (canvas.dataset.cloudVer === CLOUD_VER) return;
      const host = canvas.parentElement;
      if (!host) return;

      if (preferCssOnly()) {
        canvas.remove();
        return;
      }

      const old = canvas.getContext("webgl");
      if (old) old.getExtension("WEBGL_lose_context")?.loseContext();
      const next = canvas.cloneNode(false) as HTMLCanvasElement;
      canvas.replaceWith(next);
      canvas = next;

      const gl = canvas.getContext("webgl", {
        antialias: false,
        alpha: false,
        depth: false,
        stencil: false,
        powerPreference: "low-power",
        preserveDrawingBuffer: false,
      });
      if (!gl) {
        canvas.remove();
        return;
      }
      canvas.dataset.cloudVer = CLOUD_VER;

      const compile = (type: number, src: string) => {
        const s = gl.createShader(type);
        if (!s) return null;
        gl.shaderSource(s, src);
        gl.compileShader(s);
        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
          gl.deleteShader(s);
          return null;
        }
        return s;
      };

      const vert = compile(gl.VERTEX_SHADER, CLOUD_VERT);
      const frag = compile(gl.FRAGMENT_SHADER, CLOUD_FRAG);
      if (!vert || !frag) {
        canvas.remove();
        return;
      }

      const program = gl.createProgram();
      if (!program) {
        canvas.remove();
        return;
      }
      gl.attachShader(program, vert);
      gl.attachShader(program, frag);
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
        canvas.remove();
        return;
      }
      gl.useProgram(program);

      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const pos = gl.getAttribLocation(program, "position");
      gl.enableVertexAttribArray(pos);
      gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

      const uRes = gl.getUniformLocation(program, "u_resolution");
      const uTime = gl.getUniformLocation(program, "u_time");
      gl.uniform3f(gl.getUniformLocation(program, "u_colorBottom"), ...CLOUD_COLORS[0]);
      gl.uniform3f(gl.getUniformLocation(program, "u_colorMid"), ...CLOUD_COLORS[1]);
      gl.uniform3f(gl.getUniformLocation(program, "u_colorTop"), ...CLOUD_COLORS[2]);

      let raf = 0;
      let lastFrame = 0;
      let running = false;
      const t0 = performance.now();

      const resize = () => {
        // Clouds are soft-focus: render at 1x and let the compositor upscale.
        // Indistinguishable for fbm noise, ~4x fewer shaded pixels on retina.
        const dpr = Math.min(window.devicePixelRatio || 1, 1);
        const rect = host.getBoundingClientRect();
        const w = Math.max(1, Math.floor(rect.width * dpr));
        const h = Math.max(1, Math.floor(rect.height * dpr));
        if (canvas.width === w && canvas.height === h) return;
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
        gl.uniform2f(uRes, w, h);
      };

      const draw = (now: number) => {
        gl.uniform1f(uTime, (now - t0) / 1000);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      };

      const loop = (now: number) => {
        if (!running) return;
        if (now - lastFrame >= FRAME_MS) {
          lastFrame = now;
          draw(now);
        }
        raf = requestAnimationFrame(loop);
      };

      const start = () => {
        if (running) return;
        running = true;
        resize();
        lastFrame = 0;
        raf = requestAnimationFrame(loop);
      };
      const stop = () => {
        running = false;
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
      };

      resize();
      draw(t0 + 12);

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reducedMotion) {
        let resizeTimer = 0;
        new ResizeObserver(() => {
          clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            resize();
            draw(t0 + 12);
          }, 150);
        }).observe(host);
        return;
      }

      // Run once the canvas is on-screen — but let the hero bloom own the
      // GPU for its first beat, then warm the clouds. Pause when scrolled
      // offscreen or when the tab itself is hidden.
      let onScreen = false;
      let pageVisible = !document.hidden;
      let warmReady = false;

      const sync = () => {
        if (warmReady && onScreen && pageVisible) start();
        else stop();
      };

      window.setTimeout(() => {
        warmReady = true;
        sync();
      }, 1500);

      new IntersectionObserver(
        ([entry]) => {
          onScreen = !!entry?.isIntersecting;
          sync();
        },
        { rootMargin: "10% 0px" },
      ).observe(canvas);

      document.addEventListener(
        "visibilitychange",
        () => {
          pageVisible = !document.hidden;
          sync();
        },
        { passive: true },
      );

      let resizeTimer = 0;
      new ResizeObserver(() => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          resize();
          if (running) draw(performance.now());
          else draw(t0 + 12);
        }, 150);
      }).observe(host);
    });
  }
  initClouds();
  document.addEventListener("astro:after-swap", initClouds);
</script>

