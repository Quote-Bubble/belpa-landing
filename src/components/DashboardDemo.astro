  }
  .dd-body { margin: 0; color: var(--color-ink-soft); line-height: 1.6; }
  @media (min-width: 1024px) {
    .dd-body { margin-left: auto; }
  }

  /* =====================================================================
     The recording. One 20s timeline; every track shares it so the cursor,
     the view swap and the zoom stay in step. Only runs while on screen.
     Hook classnames are unchanged from the previous implementation, just
     retargeted onto the now-real, ported markup above.
