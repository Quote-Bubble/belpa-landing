       its X axis as it enters, so it needs a perspective ancestor to read as
       real 3D rather than a flat squash. */
    perspective: 1800px;
  }
  .dd-frame {
    transform-origin: center 80%;
  }
  @media (min-width: 1024px) {
    .dd { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 3rem; }
  }
  @media (min-width: 1200px) {
    .dd { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 3.25rem; }
  }

  /* Same card treatment as .sat-card so the two sections read as a pair. */
  .dd-frame {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
