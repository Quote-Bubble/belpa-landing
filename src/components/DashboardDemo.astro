/**
 * A replica of the real roofer dashboard (quoter-dashboard-frontend), played
 * back as a looping fake screen recording.
 *
 * Unlike a hand-drawn approximation, the markup below is PORTED VERBATIM from
 * the real dashboard components — same Tailwind utility classes, same JSX
 * structure, same SVG icon paths, same chart geometry constants. This works
 * because quoter-landing and quoter-dashboard-frontend share one design-token
 * system (see src/styles/global.css's @theme block vs the dashboard's
 * src/app/globals.css — both define identical --color-brand-*, --color-ink,
 * --shadow-soft etc.), so the same class names resolve to the same pixels in
 * both repos. `.surface` / `.field` / `.archive-btn` are the dashboard's own
 * small utility classes, not yet in the landing's shared stylesheet — ported
 * here scoped to this component (Astro <style> is scoped by default) rather
 * than touching the global stylesheet for a landing-page-only need.
 *
 * Sources ported from (quoter-dashboard-frontend):
 *   src/components/DashboardShell.tsx      (sidebar width/glass, main padding)
 *   src/components/Sidebar.tsx             (wordmark, nav icons, roofer card)
 *   src/components/PageHeader.tsx          (title/subtitle typography)
 *   src/components/QuotesTable.tsx         (grid template, row/pill/icon markup)
 *   src/components/StatusPicker.tsx        (closed-state status pill)
 *   src/components/QuoteDetailPanel.tsx    (ColLabel/Figure typography)
 *   src/components/AnalyticsClient.tsx     (cards, filter pills, bar rows)
 *   src/components/charts/LineChart.tsx    (SVG geometry, byte-identical)
 *   src/lib/format.ts                      (labels, status colours, money fmt)
 *
 * The expanded detail is ported from the REDESIGNED QuoteDetailPanel — an
 * action rail (estimate, status, intent, contact) beside an evidence column
 * (roof plan, then survey figures grouped into clusters). It was previously a
 * hand-drawn four-cell strip, which is exactly what the paragraph above says
 * this file doesn't do; the loop now holds on it long enough to be read, so
 * it has to be the real thing.
 *
 * Not ported: RoofPlan's projection maths (lib/roof-plan.ts). The plan here is
 * a fixed outline drawn with RoofPlan.tsx's own colours, grid pattern and
 * span caption — there are no real polygon coords on a static page to project.
 * The panel's controls are inert: StatusPicker's menu and the archive action
 * have no state to change in a recording.
 *
 * Note the two screens carry DIFFERENT filter bars on purpose — Quotes has
 * seven filters with counts (QuotesClient.tsx), Analytics has five plain ones
 * (AnalyticsClient.tsx). They are not meant to match.
 *
 * PERFORMANCE: the real markup is authored at 1040x780 (sidebar 256px +
 * content) inside `.dd-fit`, then scaled to whatever size the frame renders
 * at with ONE `transform: scale()` recomputed only on resize (a few lines of
 * JS, ResizeObserver-driven). This canvas is deliberately smaller than the
 * real dashboard's own natural width — QuotesTable's fixed-px column
 * minimums (220/190/170/140/130px) need ~1034px just for themselves, more
 * than a compact preview card should scale down to and still read as
 * legible, so `.dd-row-grid` below uses the SAME column proportions as
 * QuotesTable's GRID_TEMPLATE but as flexible fr tracks instead of fixed
 * floors — same visual shape, no hard minimum forcing either an oversized
 * canvas or clipped columns. Everything that plays every frame during the
 * 15s loop (`.dd-zoom`, `.dd-cursor`, opacity crossfades) is a separate,
 * purely-animated CSS layer nested inside the static fit-scale, so the
 * animation itself is exactly as cheap (GPU-composited transform/opacity
 * only, zero JS) as before — this is strictly additive, not a regression.
 */

type Status = "new" | "contacted" | "won" | "lost";
type Job =
  | "full_replacement"
  | "tile_or_slate_repair"
  | "gutters_fascias_soffits"
  | "flat_roof_replacement";

type Seed = {
  name: string;
  phone: string;
  job: Job;
  value: number;
  status: Status;
  /** 0 = six days ago … 6 = today. */
  day: number;
};

// 20 leads across a 7-day window. Day counts: [0,1,7,5,4,0,3].
const LEADS: Seed[] = [
  { name: "Alan Morgan", phone: "07700 900318", job: "tile_or_slate_repair", value: 1200, status: "contacted", day: 1 },

  { name: "Priya Raval", phone: "07700 900142", job: "full_replacement", value: 8400, status: "contacted", day: 2 },
  { name: "Tom Whitfield", phone: "07700 900774", job: "full_replacement", value: 9200, status: "new", day: 2 },
  { name: "Dan Okafor", phone: "07700 900521", job: "tile_or_slate_repair", value: 1350, status: "new", day: 2 },
  { name: "Helen Brooks", phone: "07700 900983", job: "tile_or_slate_repair", value: 1450, status: "contacted", day: 2 },
  { name: "Marcus Reid", phone: "07700 900265", job: "gutters_fascias_soffits", value: 2200, status: "new", day: 2 },
  { name: "Sofia Lindqvist", phone: "07700 900607", job: "full_replacement", value: 9800, status: "won", day: 2 },
  { name: "Ray Chandra", phone: "07700 900431", job: "tile_or_slate_repair", value: 1550, status: "new", day: 2 },

  { name: "Nina Alvarez", phone: "07700 900876", job: "full_replacement", value: 10400, status: "contacted", day: 3 },
  { name: "Greg Sutton", phone: "07700 900190", job: "tile_or_slate_repair", value: 1600, status: "lost", day: 3 },
  { name: "Yusuf Kaya", phone: "07700 900355", job: "gutters_fascias_soffits", value: 2350, status: "new", day: 3 },
  { name: "Claire Bennett", phone: "07700 900712", job: "full_replacement", value: 11200, status: "new", day: 3 },
  { name: "Owen Pryce", phone: "07700 900044", job: "tile_or_slate_repair", value: 1750, status: "lost", day: 3 },

  { name: "Ellie Hartman", phone: "07700 900928", job: "full_replacement", value: 9800, status: "contacted", day: 4 },
  { name: "Rob Ingram", phone: "07700 900583", job: "tile_or_slate_repair", value: 1900, status: "new", day: 4 },
  { name: "Amara Boateng", phone: "07700 900237", job: "gutters_fascias_soffits", value: 2400, status: "won", day: 4 },
  { name: "Stef Novak", phone: "07700 900469", job: "flat_roof_replacement", value: 5075, status: "new", day: 4 },

  { name: "Jed Marsh", phone: "07700 900801", job: "full_replacement", value: 8900, status: "new", day: 6 },
  { name: "Lucy Fairbairn", phone: "07700 900116", job: "tile_or_slate_repair", value: 2100, status: "new", day: 6 },
  { name: "Kofi Mensah", phone: "07700 900650", job: "gutters_fascias_soffits", value: 2600, status: "new", day: 6 },
];

// ---------------------------------------------------------------------------
// Ported verbatim from src/lib/format.ts
// ---------------------------------------------------------------------------
const JOB_LABELS: Record<Job, string> = {
  full_replacement: "Full replacement",
  tile_or_slate_repair: "Tile / slate repair",
  gutters_fascias_soffits: "Gutters, fascias & soffits",
  flat_roof_replacement: "Flat roof replacement",
};
// The internal value stays "won"; roofers see "Completed" (format.ts's
// STATUS_LABELS). Both the table pill and the analytics breakdown card read
// from here, exactly as the real app reads both from statusLabel().
const STATUS_LABELS: Record<Status, string> = {
  new: "New",
  contacted: "Contacted",
  won: "Completed",
  lost: "Lost",
};
const STATUS_COLOR: Record<Status, { fg: string; bg: string }> = {
  new: { fg: "#1546c9", bg: "#eef4ff" },
  contacted: { fg: "#6d28d9", bg: "#f3e8ff" },
  won: { fg: "#0d6b3c", bg: "#e6f6ee" },
  lost: { fg: "#c02626", bg: "#fdeaea" },
};

const gbp = new Intl.NumberFormat("en-GB", {
  style: "currency",
  currency: "GBP",
  maximumFractionDigits: 0,
});
const money = (v: number) => gbp.format(v);
// Ported from AnalyticsClient.tsx's local compactMoney/formatCount/formatPercent.
const compactMoney = (v: number) =>
  v >= 10_000 ? `£${Math.round(v / 1000)}K` : v >= 1000 ? `£${(v / 1000).toFixed(1)}K` : money(v);
const pct = (v: number) => `${Math.round(v)}%`;
const count = (v: number) => String(Math.round(v));

function median(values: number[]): number | null {
  if (values.length === 0) return null;
  const s = [...values].sort((a, b) => a - b);
  const mid = Math.floor(s.length / 2);
  return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
}

// Day labels, computed at build time so the window always reads as recent.
const DAYS = 7;
const now = new Date();
const dayLabels = Array.from({ length: DAYS }, (_, i) => {
  const d = new Date(now);
  d.setDate(d.getDate() - (DAYS - 1 - i));
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
});

const byDay = Array.from({ length: DAYS }, (_, i) => LEADS.filter((l) => l.day === i));

// --- the three trend cards ------------------------------------------------
const countPoints = byDay.map((rows, i) => ({ label: dayLabels[i], value: rows.length }));
const medianPoints = byDay.map((rows, i) => ({
  label: dayLabels[i],
  value: median(rows.map((r) => r.value)) ?? 0,
}));
const winRatePoints = byDay.map((rows, i) => {
  const w = rows.filter((r) => r.status === "won").length;
  const l = rows.filter((r) => r.status === "lost").length;
  return { label: dayLabels[i], value: w + l > 0 ? (w / (w + l)) * 100 : 0 };
});

const totalCount = LEADS.length;
const medianValue = median(LEADS.map((l) => l.value));
const wonRows = LEADS.filter((l) => l.status === "won");
const lostRows = LEADS.filter((l) => l.status === "lost");
const winRate = wonRows.length + lostRows.length > 0
  ? (wonRows.length / (wonRows.length + lostRows.length)) * 100
  : null;

// --- today / yesterday ----------------------------------------------------
const todayRows = byDay[DAYS - 1];
const yesterdayRows = byDay[DAYS - 2];
const todayMedian = median(todayRows.map((r) => r.value));

// --- value by job type ----------------------------------------------------
const jobRows = (Object.keys(JOB_LABELS) as Job[])
  .map((job) => {
    const values = LEADS.filter((l) => l.job === job).map((l) => l.value);
    return { job, count: values.length, median: median(values) ?? 0 };
  })
  .filter((r) => r.count > 0)
  .sort((a, b) => b.median - a.median);
const maxJobMedian = Math.max(1, ...jobRows.map((r) => r.median));

// --- won vs lost ----------------------------------------------------------
const wonMedian = median(wonRows.map((r) => r.value));
const lostMedian = median(lostRows.map((r) => r.value));
const maxOutcome = Math.max(1, wonMedian ?? 0, lostMedian ?? 0);

/**
 * Geometry lifted verbatim from charts/LineChart.tsx (same constants,
 * same path-building math) so the curve, padding, grid lines and end dot
 * land in exactly the same relative places as the real app.
 */
const W = 640, H = 180, PAD_TOP = 16, PAD_BOTTOM = 8, PAD_LEFT = 4, PAD_RIGHT = 54;
function chart(data: { label: string; value: number }[], fmt: (v: number) => string) {
  const plotW = W - PAD_LEFT - PAD_RIGHT;
  const plotH = H - PAD_TOP - PAD_BOTTOM;
  const maxValue = Math.max(1, ...data.map((d) => d.value));
  const xAt = (i: number) =>
    data.length <= 1 ? PAD_LEFT + plotW / 2 : PAD_LEFT + (i / (data.length - 1)) * plotW;
  const yAt = (v: number) => PAD_TOP + plotH - (Math.max(0, v) / maxValue) * plotH;
  const pts = data.map((d, i) => ({ x: xAt(i), y: yAt(d.value) }));
  const line = pts.map((p, i) => `${i === 0 ? "M" : "L"} ${p.x} ${p.y}`).join(" ");
  const last = pts[pts.length - 1];
  const area = last ? `${line} L ${last.x} ${PAD_TOP + plotH} L ${PAD_LEFT} ${PAD_TOP + plotH} Z` : "";
  const grid = [0, 0.5, 1].map((s) => ({
    y: PAD_TOP + plotH - s * plotH,
    label: fmt(maxValue * s),
  }));
  return { line, area, last, grid, first: data[0]?.label ?? "", lastLabel: data[data.length - 1]?.label ?? "" };
}

const cCount = chart(countPoints, count);
const cMedian = chart(medianPoints, compactMoney);
const cWin = chart(winRatePoints, pct);

const STAT_CARDS = [
  { title: "Quotes received", value: count(totalCount), delta: "0 previous period", c: cCount },
  { title: "Median quote value", value: medianValue != null ? money(medianValue) : "—", delta: "No quotes previous period", c: cMedian },
  { title: "Win rate", value: winRate != null ? pct(winRate) : "—", delta: "No won/lost previous period", c: cWin },
];

// Most recent first, like the real inbox. The newest one is the quote that
// "arrives" mid-demo — it is still one of the 20 seed leads, so the analytics
// on the next screen continue to add up.
const inbox = [...LEADS]
  .sort((a, b) => b.day - a.day)
  .slice(0, 5)
  .map((l, i) => ({ ...l, received: l.day === 6 ? `${2 + i}h ago` : `${6 - l.day}d ago` }));
const newLead = { ...inbox[0], received: "just now" };
const restRows = inbox.slice(1);

/**
 * The real filter bar (QuotesClient.tsx's `order` + FILTER_COLORS, rendered by
 * FilterBar.tsx): seven filters, each carrying a count, with the active one
 * wearing a solid bubble in its own colour rather than a generic black pill.
 * "Follow-up" is not a status — it's the estimate-only browsers, i.e. the
 * intent tiering the detail panel now shows on the lead itself.
 */
const FILTER_COLORS: Record<string, { ink: string; solid: string }> = {
  all: { ink: "#3d4148", solid: "#0a0b0d" },
  new: { ink: "#1546c9", solid: "#2f6bff" },
  contacted: { ink: "#6d28d9", solid: "#7c3aed" },
  won: { ink: "#0d6b3c", solid: "#12915a" },
  lost: { ink: "#c02626", solid: "#dc2626" },
  followup: { ink: "#475569", solid: "#64748b" },
  archived: { ink: "#9a6510", solid: "#d99a17" },
};

const statusCount = (s: Status) => LEADS.filter((l) => l.status === s).length;

// Archived renders as an icon rather than a word, like FilterBar.tsx's
// `{f.icon ?? f.label}`.
const ARCHIVE_ICON = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-label="Archived"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg>`;

// Counts come off the same 20-lead seed the tables and charts use, so the
// numbers on the tabs agree with everything else on screen. Follow-up and
// Archived are drawn from outside the visible inbox, so they carry standing
// counts rather than ones derived from `status`.
const QUOTE_FILTERS: {
  key: string;
  label: string;
  count: number;
  icon?: string;
}[] = [
  { key: "all", label: "All", count: LEADS.length },
  { key: "new", label: STATUS_LABELS.new, count: statusCount("new") },
  { key: "contacted", label: STATUS_LABELS.contacted, count: statusCount("contacted") },
  { key: "won", label: STATUS_LABELS.won, count: statusCount("won") },
  { key: "lost", label: STATUS_LABELS.lost, count: statusCount("lost") },
  { key: "followup", label: "Follow-up", count: 3 },
  { key: "archived", label: "Archived", count: 2, icon: ARCHIVE_ICON },
];

/**
 * Analytics deliberately carries a DIFFERENT filter set from Quotes: five
 * plain pills, no counts, no Follow-up/Archived (AnalyticsClient.tsx:35-38),
 * styled bg-ink/white rather than per-filter colours. The two screens are not
 * meant to match, so the demo keeps them apart too.
 */
const ANALYTICS_FILTERS = [
  "All",
  STATUS_LABELS.new,
  STATUS_LABELS.contacted,
  STATUS_LABELS.won,
  STATUS_LABELS.lost,
];

// Ported verbatim from Sidebar.tsx's NAV array (same viewBox/paths).
const iconProps = 'width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const NAV = [
  { key: "quotes", label: "Quotes", icon: `<svg ${iconProps}><path d="M4 5h16M4 12h16M4 19h10"/></svg>` },
  { key: "analytics", label: "Analytics", icon: `<svg ${iconProps}><path d="M4 19V5M4 19h16M8 19v-6M13 19V9M18 19v-9"/></svg>` },
  { key: "account", label: "Account", icon: `<svg ${iconProps}><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg>` },
  { key: "support", label: "Support", icon: `<svg ${iconProps}><circle cx="12" cy="12" r="9"/><path d="M9.3 9.3a2.7 2.7 0 0 1 5.2 1c0 1.8-2.7 2.2-2.7 4"/><path d="M12 17.5h.01"/></svg>` },
];
