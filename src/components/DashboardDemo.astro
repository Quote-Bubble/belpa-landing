  /* cubic-bezier(0.65,0,0.35,1) is a SYMMETRIC ease-in-out ("easeInOutCubic") —
     deliberately NOT var(--ease-out-soft) here. That curve front-loads almost
     all its motion into the first fraction of a segment then coasts nearly
     still for the rest before stopping dead — fine for a single arrival, but
     chained across many waypoints in a row it reads as burst-coast-stop,
     burst-coast-stop, i.e. exactly the "start stop" feeling. A true ease-in-out
     spreads velocity across the WHOLE segment instead, so the multi-point
     travel/pan sequences below flow as one continuous motion. Cursor and
     camera share this curve so they still move with the same character;
     individual keyframe steps override it for the snappy click pulses only. */
  .dd-frame.playing .dd-cursor { animation: dd-cursor 15s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  .dd-frame.playing .dd-zoom { animation: dd-zoom 15s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  .dd-frame.playing .dd-view--quotes { animation: dd-quotes 15s ease-in-out infinite; }
  .dd-frame.playing .dd-view--analytics { animation: dd-analytics 15s ease-in-out infinite; }
  .dd-frame.playing .dd-scroll { animation: dd-scroll 15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="0"] .dd-chart-line { animation: dd-chart-line-0 15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="0"] .dd-chart-area { animation: dd-chart-area-0 15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="0"] .dd-chart-dot  { animation: dd-chart-dot-0  15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="1"] .dd-chart-line { animation: dd-chart-line-1 15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="1"] .dd-chart-area { animation: dd-chart-area-1 15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="1"] .dd-chart-dot  { animation: dd-chart-dot-1  15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="2"] .dd-chart-line { animation: dd-chart-line-2 15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="2"] .dd-chart-area { animation: dd-chart-area-2 15s ease-in-out infinite; }
  .dd-frame.playing [data-chart="2"] .dd-chart-dot  { animation: dd-chart-dot-2  15s ease-in-out infinite; }
  .dd-frame.playing .dd-row-collapse { animation: dd-newrow 15s ease-in-out infinite; }
  .dd-frame.playing .dd-newdot { animation: dd-newdot 15s ease-in-out infinite; }
  .dd-frame.playing .dd-row--new { animation: dd-rowbg 15s ease-in-out infinite; }
  .dd-frame.playing .dd-detail { animation: dd-detail 15s ease-in-out infinite; }
  .dd-frame.playing .dd-nav-item[data-nav="quotes"] { animation: dd-nav-quotes-text 15s ease-in-out infinite; }
  .dd-frame.playing .dd-nav-item[data-nav="quotes"] .dd-nav-pill { animation: dd-nav-quotes-pill 15s ease-in-out infinite; }
  .dd-frame.playing .dd-nav-item[data-nav="quotes"] .dd-nav-icon { animation: dd-nav-quotes-icon 15s ease-in-out infinite; }
  .dd-frame.playing .dd-nav-item[data-nav="analytics"] { animation: dd-nav-analytics-text 15s ease-in-out infinite; }
  .dd-frame.playing .dd-nav-item[data-nav="analytics"] .dd-nav-pill { animation: dd-nav-analytics-pill 15s ease-in-out infinite; }
  .dd-frame.playing .dd-nav-item[data-nav="analytics"] .dd-nav-icon { animation: dd-nav-analytics-icon 15s ease-in-out infinite; }

  /* Cursor: lands on the arriving quote, reads the panel it opens, then
     crosses to Analytics and tours the charts. Percentages are the shared
     15s clock.

     Targets below were MEASURED off the rendered stage (getBoundingClientRect
     as a percentage of .dd-stage) rather than estimated from the authored
     layout — the previous estimates put the nav at 7% and the row at 52%,
     when they actually sit at 12% and 62%, so the cursor clicked next to its
     targets rather than on them:
       Quotes nav item centre      ~ (12%, 15%)
       Analytics nav item centre   ~ (12%, 21%)
       New-lead row centre         ~ (62%, 30%)   spans x 28-97, y 26-34
       Panel                       ~ (62%, 57%)   spans x 28-97, y 34-80
       Panel action rail (money)   ~ (36%, 40%)
       Panel contact block         ~ (36%, 62%)
       Panel evidence column       ~ (75%, 50%)
       Stat-card chart centres     ~ (39%,53%) (62%,53%) (86%,53%)
       Breakdown cards, scrolled   ~ (45%,54%) (80%,54%)

     SEAM CONTRACT — every track below holds IDENTICAL values at 0% and 100%,
     and every reset happens either while the analytics view is opaque over
     the top (52-92%) or after it has fully faded back out (96%+). A track
     whose start and end differ, or which resets while visible, shows a jump
     when the loop wraps. Check both properties when editing any of these. */
  @keyframes dd-cursor {
    0%    { opacity: 0; left: 60%; top: 88%; transform: scale(1); }
    3%    { opacity: 1; left: 60%; top: 88%; transform: scale(1); }
    /* travel to the new row, with a slight arc rather than a dead-straight line */
    8%    { opacity: 1; left: 58%; top: 55%; transform: scale(1); }
    12%   { opacity: 1; left: 62%; top: 30%; transform: scale(1); animation-timing-function: ease; }
    15%   { opacity: 1; left: 62%; top: 30%; transform: scale(0.82); animation-timing-function: ease; }  /* click */
    18%   { opacity: 1; left: 62%; top: 30%; transform: scale(1); }
    /* read down the panel the click opened: rail, contact, then the evidence */
    25%   { opacity: 1; left: 36%; top: 40%; transform: scale(1); }
    33%   { opacity: 1; left: 36%; top: 62%; transform: scale(1); }
    40%   { opacity: 1; left: 75%; top: 50%; transform: scale(1); }
    /* arc across to the Analytics nav item */
    46%   { opacity: 1; left: 12%; top: 21%; transform: scale(1); animation-timing-function: ease; }
    49%   { opacity: 1; left: 12%; top: 21%; transform: scale(0.82); animation-timing-function: ease; }  /* click */
    52%   { opacity: 1; left: 12%; top: 21%; transform: scale(1); }
    /* sweep left to right across the three trend-card charts */
    57%   { opacity: 1; left: 39%; top: 53%; transform: scale(1); }
    65%   { opacity: 1; left: 62%; top: 53%; transform: scale(1); }
    73%   { opacity: 1; left: 86%; top: 53%; transform: scale(1); }
    /* down to the two breakdown cards, once the page has scrolled to them */
    80%   { opacity: 1; left: 45%; top: 54%; transform: scale(1); }
    87%   { opacity: 1; left: 80%; top: 54%; transform: scale(1); }
    /* back to Quotes — the loop closes with a click, not a fade */
    90%   { opacity: 1; left: 12%; top: 15%; transform: scale(1); animation-timing-function: ease; }
    92%   { opacity: 1; left: 12%; top: 15%; transform: scale(0.82); animation-timing-function: ease; }  /* click */
    94%   { opacity: 1; left: 12%; top: 15%; transform: scale(1); }
    /* Fade out BEFORE returning to the idle spot, so the long diagonal back
       to (60%, 88%) is travelled invisibly instead of read as a swoop. */
    97%   { opacity: 0; left: 12%; top: 15%; transform: scale(1); }
    100%  { opacity: 0; left: 60%; top: 88%; transform: scale(1); }
  }

  /* Camera: ONE push-in per act, not a zoom cycle per point of interest.
     Act 1 pushes in for the row click, then eases back to a slightly wider
     framing that holds the WHOLE opened panel (rail + evidence) while the
     cursor reads it — the panel is now a two-column layout, so framing it as
     tightly as the old four-cell strip would crop half of it. Act 2 pushes in
     once for the analytics tour and only PANS across it. */
  @keyframes dd-zoom {
    0%, 5%    { transform: scale(1);    transform-origin: 50% 20%; }
    /* transform-origin is NOT a camera centre. Scaling about O shows
       [O - O/s, O + (W-O)/s], so the window is asymmetric about O and a
       "centre the subject" origin crops it. Both framings below were solved
       against the rendered boxes (row spans x 28-97 y 26-34; panel spans
       x 28-97 y 34-80 of the stage) until the subject sat fully inside the
       viewport — not derived from where the subject's centre is. */
    12%, 20%  { transform: scale(1.4);  transform-origin: 92% 30%; }  /* whole row, cursor centred */
    26%, 40%  { transform: scale(1.3);  transform-origin: 105% 50%; } /* whole panel in frame */
    46%       { transform: scale(1);    transform-origin: 40% 24%; }
    51%       { transform: scale(1);    transform-origin: 50% 20%; }
    57%       { transform: scale(1.55); transform-origin: 39% 53%; }  /* push in once for Analytics */
    65%       { transform: scale(1.55); transform-origin: 62% 53%; }  /* pan, same scale */
    73%       { transform: scale(1.55); transform-origin: 86% 53%; }  /* pan, same scale */
    80%       { transform: scale(1.4);  transform-origin: 45% 54%; }  /* ease down to the bars */
    87%       { transform: scale(1.4);  transform-origin: 80% 54%; }  /* pan, same scale */
    93%, 100% { transform: scale(1);    transform-origin: 50% 20%; }
  }

  /* Scrolls the analytics page down to the breakdown cards, then back. */
  @keyframes dd-scroll {
    0%, 76%   { transform: translateY(0); }
    82%, 89%  { transform: translateY(-26%); }
    94%, 100% { transform: translateY(0); }
  }

  /* Each chart draws in as the camera arrives at it (matching dd-cursor's
     57%/65%/73% arrivals), then STAYS drawn while the camera moves on — a real
     dashboard doesn't erase a chart because you looked away. All three reset
     together at 96-97%, after the analytics view has fully faded, so nothing
     visibly un-draws. */
  @keyframes dd-chart-line-0 {
    0%, 51%   { stroke-dashoffset: 1; }
    57%, 96%  { stroke-dashoffset: 0; }
    97%, 100% { stroke-dashoffset: 1; }
  }
  @keyframes dd-chart-area-0 {
    0%, 53%   { opacity: 0; }
    59%, 96%  { opacity: 0.1; }
    97%, 100% { opacity: 0; }
  }
  @keyframes dd-chart-dot-0 {
    0%, 56%   { opacity: 0; }
    60%, 96%  { opacity: 1; }
    97%, 100% { opacity: 0; }
  }
  @keyframes dd-chart-line-1 {
    0%, 59%   { stroke-dashoffset: 1; }
    65%, 96%  { stroke-dashoffset: 0; }
    97%, 100% { stroke-dashoffset: 1; }
  }
  @keyframes dd-chart-area-1 {
    0%, 61%   { opacity: 0; }
    67%, 96%  { opacity: 0.1; }
    97%, 100% { opacity: 0; }
  }
  @keyframes dd-chart-dot-1 {
    0%, 64%   { opacity: 0; }
    68%, 96%  { opacity: 1; }
    97%, 100% { opacity: 0; }
  }
  @keyframes dd-chart-line-2 {
    0%, 67%   { stroke-dashoffset: 1; }
    73%, 96%  { stroke-dashoffset: 0; }
    97%, 100% { stroke-dashoffset: 1; }
  }
  @keyframes dd-chart-area-2 {
    0%, 69%   { opacity: 0; }
    75%, 96%  { opacity: 0.1; }
    97%, 100% { opacity: 0; }
  }
  @keyframes dd-chart-dot-2 {
    0%, 72%   { opacity: 0; }
    76%, 96%  { opacity: 1; }
    97%, 100% { opacity: 0; }
  }

  /* Both views swap on a click, never a cross-fade to nothing. */
  @keyframes dd-quotes {
    0%, 46%   { opacity: 1; }
    51%, 92%  { opacity: 0; }
    96%, 100% { opacity: 1; }
  }
  @keyframes dd-analytics {
    0%, 46%   { opacity: 0; }
    51%, 92%  { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  /* The arriving quote slides open, gets clicked, then resets to closed WHILE
     THE ANALYTICS VIEW IS COVERING IT (51-92%). Resetting it on screen would
     read as the lead being deleted, and leaving it open would make the loop
     wrap visibly pop. */
  @keyframes dd-newrow {
    0%, 8%    { grid-template-rows: 0fr; }
    12%, 52%  { grid-template-rows: 1fr; }
    58%, 100% { grid-template-rows: 0fr; }
  }
  /* The row tints only once it has been opened, matching the real table where
     bg-brand-50 is the expanded state. Click lands at 15%. */
  @keyframes dd-rowbg {
    0%, 15%   { background-color: transparent; }
    18%, 52%  { background-color: var(--color-brand-50); }
    58%, 100% { background-color: transparent; }
  }
  @keyframes dd-newdot {
    0%, 9%    { scale: 0; opacity: 0; }
    13%       { scale: 1.6; opacity: 1; }
    18%, 52%  { scale: 1; opacity: 1; }
    58%, 100% { scale: 0; opacity: 0; }
  }
  /* Opens just after the click at 15% and HOLDS until the analytics view has
     covered it. The old timing collapsed the panel on screen at 38%, several
     beats before the view actually changed. */
  @keyframes dd-detail {
    0%, 15%   { grid-template-rows: 0fr; }
    21%, 52%  { grid-template-rows: 1fr; }
    58%, 100% { grid-template-rows: 0fr; }
  }
  @keyframes dd-nav-quotes-text {
    0%, 47%   { color: var(--color-brand-700); font-weight: 600; }
    51%, 92%  { color: var(--color-ink-soft); font-weight: 500; }
    96%, 100% { color: var(--color-brand-700); font-weight: 600; }
  }
  @keyframes dd-nav-quotes-pill {
    0%, 47%   { background: var(--color-brand-50); }
    51%, 92%  { background: transparent; }
    96%, 100% { background: var(--color-brand-50); }
  }
  @keyframes dd-nav-quotes-icon {
    0%, 47%   { color: var(--color-brand-600); }
    51%, 92%  { color: var(--color-muted); }
    96%, 100% { color: var(--color-brand-600); }
  }
  @keyframes dd-nav-analytics-text {
    0%, 47%   { color: var(--color-ink-soft); font-weight: 500; }
    51%, 92%  { color: var(--color-brand-700); font-weight: 600; }
    96%, 100% { color: var(--color-ink-soft); font-weight: 500; }
  }
  @keyframes dd-nav-analytics-pill {
    0%, 47%   { background: transparent; }
    51%, 92%  { background: var(--color-brand-50); }
    96%, 100% { background: transparent; }
  }
  @keyframes dd-nav-analytics-icon {
    0%, 47%   { color: var(--color-muted); }
    51%, 92%  { color: var(--color-brand-600); }
    96%, 100% { color: var(--color-muted); }
  }

  /* One honest static frame instead of motion. */
  @media (prefers-reduced-motion: reduce) {
    .dd-frame.playing .dd-cursor,
    .dd-frame.playing .dd-zoom,
    .dd-frame.playing .dd-view--quotes,
    .dd-frame.playing .dd-view--analytics,
    .dd-frame.playing .dd-row-collapse,
    .dd-frame.playing .dd-newdot,
    .dd-frame.playing .dd-newdot::after,
    .dd-frame.playing .dd-row--new,
    .dd-frame.playing .dd-detail,
    .dd-frame.playing .dd-scroll,
    .dd-frame.playing [data-chart] .dd-chart-line,
    .dd-frame.playing [data-chart] .dd-chart-area,
    .dd-frame.playing [data-chart] .dd-chart-dot,
    .dd-frame.playing .dd-nav-item[data-nav="quotes"],
    .dd-frame.playing .dd-nav-item[data-nav="quotes"] .dd-nav-pill,
    .dd-frame.playing .dd-nav-item[data-nav="quotes"] .dd-nav-icon,
    .dd-frame.playing .dd-nav-item[data-nav="analytics"],
    .dd-frame.playing .dd-nav-item[data-nav="analytics"] .dd-nav-pill,
    .dd-frame.playing .dd-nav-item[data-nav="analytics"] .dd-nav-icon { animation: none; }
    .dd-view--analytics { opacity: 1; }
    .dd-view--quotes { opacity: 0; }
    /* Static frame shows Analytics permanently, so its charts should read
       as fully drawn, not stuck mid-reveal. */
    [data-chart] .dd-chart-line { stroke-dashoffset: 0; }
    [data-chart] .dd-chart-area { opacity: 0.1; }
    [data-chart] .dd-chart-dot { opacity: 1; }
    .dd-nav-item[data-nav="quotes"] { color: var(--color-ink-soft); font-weight: 500; }
    .dd-nav-item[data-nav="quotes"] .dd-nav-pill { background: transparent; }
    .dd-nav-item[data-nav="quotes"] .dd-nav-icon { color: var(--color-muted); }
    .dd-nav-item[data-nav="analytics"] { color: var(--color-brand-700); font-weight: 600; }
    .dd-nav-item[data-nav="analytics"] .dd-nav-pill { background: var(--color-brand-50); }
    .dd-nav-item[data-nav="analytics"] .dd-nav-icon { color: var(--color-brand-600); }
  }

  @media (max-width: 1023px) {
    .dd-copy { order: -1; }
  }
</style>

<script>
  // Fit the real-proportions markup to whatever size the frame
  // actually renders at. Runs once on load and again on resize — NOT during
  // the animation loop, so it costs nothing while the recording plays.
  const NATURAL_W = 1040;
  const frame = document.querySelector<HTMLElement>(".dd-frame");
  const viewport = frame?.querySelector<HTMLElement>(".dd-viewport");
  const fit = frame?.querySelector<HTMLElement>(".dd-fit");

  if (frame && viewport && fit) {
    const applyScale = () => {
      const scale = viewport.clientWidth / NATURAL_W;
      fit.style.transform = `scale(${scale})`;
    };
    applyScale();
    new ResizeObserver(applyScale).observe(viewport);

    // Same gating as the satellite loop: don't burn frames off-screen.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          frame.classList.toggle("playing", entry.isIntersecting);
        }
      },
      { threshold: 0.45 },
    );
    io.observe(frame);
  }
</script>
