---
/**
 * The satellite photo, visible only through the letterforms — and you fly
 * through them.
 *
 * Type this size is the whole trick: photo-in-text needs weight and scale to
 * read as an image rather than as grey. The hero's h1 tops out at 44px
 * semibold, which is why this is its own moment between the hero and the
 * numbers rather than a treatment applied to the headline. The conversion path
 * is untouched — nothing here delays the widget, and a visitor who never
 * scrolls never sees it.
 *
 * Scroll drives one transform on one element. No illustration, no new asset:
 * it reuses the aerial RoofStory already loads, so the words are made of the
 * thing they describe.
 */
import { WORDS } from "../data/fly-through";
---

<section class="ft" data-fly-through aria-label="Measured from space">
  <div class="ft-sticky">
    <h2 class="ft-type" data-ft-type>
      {WORDS.map((word) => <span class="ft-line">{word}</span>)}
    </h2>
  </div>
</section>

<style>
  /* The tall spacer is what gives the fly-through room to happen. Shorter and
     the type snaps past; much longer and it reads as being stuck. */
  .ft {
    /* 200vh leaves exactly one screen of scrolling (200 - 100 sticky) to
       complete the fly-through. Less and the type rockets past; more and the
       panel outstays its welcome. */
    position: relative;
    height: 200vh;
  }

  .ft-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    /* Clips the type as it grows past the edges, so you pass THROUGH the words
       instead of watching them overflow the section. */
  }

  .ft-type {
    margin: 0;
    padding: 0 4vw;
    text-align: center;
    font-family: var(--font-display, inherit);
    /* As large and as heavy as the line will take. Below about 800 the counters
       close up and the image inside stops being legible as an image. */
    font-size: clamp(2.75rem, 14vw, 12rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-transform: uppercase;

    /* Fallback for anything without background-clip: solid ink, which is just
       a large heading. Nothing looks broken, it simply is not masked. */
    color: var(--color-ink);

    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .ft-line {
    display: block;
  }

  @supports (-webkit-background-clip: text) or (background-clip: text) {
    .ft-type {
      /* The darkening layer is not decoration. Raw aerial is mid-tone — greys,
         browns, lawn green — and clipped into type it reads as washed-out grey
         rather than as a photograph. Multiplied down, the letters read as dark
         type with real texture inside them, which is both more legible and more
         obviously a photo. */
      background-image:
        linear-gradient(rgba(6, 14, 33, 0.55), rgba(6, 14, 33, 0.55)),
        url("/satellite-roof.webp");
      background-size: cover;
      background-position: center 42%;
      background-repeat: no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  /* No scroll-linked scaling for reduced motion, and none on narrow screens
     where a 200vh section of one phrase is a long way to scroll past. The mask
     still applies — it costs nothing and is the better half of the effect. */
  @media (prefers-reduced-motion: reduce), (max-width: 767px) {
    .ft {
      height: auto;
    }
    .ft-sticky {
      position: static;
      height: auto;
      padding: 18vh 0;
    }
    .ft-type {
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  import { ensureScrollFlight } from "../scripts/scroll-flight";
  import { clamp01 } from "../scripts/scroll-helpers";

  function initFlyThrough() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!window.matchMedia("(min-width: 768px)").matches) return;

    const section = document.querySelector<HTMLElement>("[data-fly-through]");
    const type = document.querySelector<HTMLElement>("[data-ft-type]");
    if (!section || !type) return;

    const flight = ensureScrollFlight();

    // Cached, never read per frame. Reading offsetTop inside paint would force
    // a layout on every scroll frame, which is the exact fault this codebase
    // just had removed from section-fx.
    let top = 0;
    let span = 1;
    function measure() {
      const rect = section!.getBoundingClientRect();
      top = rect.top + window.scrollY;
      // The animation runs while the sticky panel is pinned: from the section
      // reaching the top of the viewport to its last screenful.
      span = Math.max(1, section!.offsetHeight - window.innerHeight);
    }

    function paint() {
      const p = clamp01((flight.y - top) / span);

      // Scale accelerates rather than running linear. A constant rate reads as
      // a zoom; accelerating reads as approach, which is what selling the last
      // moment before you pass through the letters depends on.
      const eased = p * p;
      const scale = 1 + eased * 7.5;

      // Hold full opacity until the type is genuinely large, then go quickly —
      // fading early would just look like a dissolve rather than a pass-through.
      const fade = p < 0.62 ? 1 : 1 - (p - 0.62) / 0.38;

      type!.style.transform = `scale(${scale.toFixed(4)})`;
      type!.style.opacity = clamp01(fade).toFixed(3);
    }

    measure();
    const off = flight.on(paint);
    window.addEventListener("resize", measure, { passive: true });
    document.fonts?.ready?.then(measure).catch(() => undefined);
    paint();
    flight.kick();

    document.addEventListener(
      "astro:before-swap",
      () => {
        off();
        window.removeEventListener("resize", measure);
      },
      { once: true },
    );
  }

  initFlyThrough();
  document.addEventListener("astro:after-swap", initFlyThrough);
</script>
