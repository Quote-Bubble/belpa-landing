---
const year = new Date().getFullYear();
---

<!-- Sharp closer: sends people back to the address field -->
<section
  class="footer-cta cv-auto relative mx-auto max-w-3xl px-4 pt-5 pb-6 text-center sm:px-6 sm:pt-8 sm:pb-16"
  data-reveal="scale"
>
  <p class="footer-cta-line font-display">Want free roof quotes on your website?</p>
  <button type="button" data-try class="footer-cta-link">
    Try now
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</section>

<footer class="footer-giant relative">
  <div class="giant-wrap" data-reveal="brand-echo">
    <div class="giant-word" aria-hidden="true" data-fx="punch">Quoter</div>
  </div>

  <div class="footer-legal">
    <div class="footer-legal-links">
      <a href="/terms">Terms of Service</a>
      <a href="/privacy">Privacy Policy</a>
    </div>
    <span class="footer-legal-copy">© {year} Quoter. All rights reserved.</span>
  </div>
</footer>

<style>
  .footer-cta-line {
    margin: 0;
    font-size: clamp(1.6rem, 4.5vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--color-ink);
  }

  .footer-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.85rem;
    padding: 0.35rem 0.25rem;
    border: 0;
    background: none;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-brand-600);
    cursor: pointer;
    transition: color 0.15s ease, transform 0.2s var(--ease-out-soft, ease);
  }
  .footer-cta-link:hover {
    color: var(--color-brand-700);
  }
  .footer-cta-link:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* Soft white → solid brand blue so the giant word always sits on blue,
     never on the page’s white/dot-grid (especially tight on mobile). */
  .footer-giant {
    overflow: hidden;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      #d7e5ff 14%,
      #9bbfff 36%,
      #5f93ff 62%,
      #2f6bff 100%
    );
  }

  .giant-wrap {
    display: flex;
    justify-content: center;
    padding-inline: 0.5rem;
  }

  .giant-word {
    margin-top: clamp(2rem, 5vw, 3.25rem);
    margin-bottom: -0.08em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(4.2rem, 22vw, 22rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-align: center;
    white-space: nowrap;
    color: #ffffff;
    opacity: 1;
    user-select: none;
    pointer-events: none;
    /* Keeps the word readable if a soft gradient band peeks through */
    text-shadow: 0 6px 28px rgba(15, 55, 160, 0.28);
  }

  .footer-legal {
    position: relative;
    z-index: 5;
    background: #2f6bff;
    padding: 16px 20px calc(16px + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    font-size: 12.5px;
  }
  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 22px;
  }
  .footer-legal a {
    color: #ffffff;
    transition: opacity 0.15s ease;
  }
  .footer-legal a:hover {
    opacity: 0.88;
    text-decoration: underline;
  }
  .footer-legal-copy {
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 640px) {
    .footer-giant {
      /* No transparent top on mobile — white page would kill white type */
      background: linear-gradient(
        180deg,
        #cfe0ff 0%,
        #7eafff 32%,
        #3f7fff 68%,
        #2f6bff 100%
      );
    }
    .giant-word {
      /* Keep enough top air that the word sits in the blue band, not the
         pale page fade that made white type disappear. */
      margin-top: 2.25rem;
      font-size: clamp(3.6rem, 24vw, 7rem);
    }
    .footer-legal {
      padding: 14px 16px calc(18px + env(safe-area-inset-bottom, 0px));
      font-size: 12px;
    }
  }
</style>
