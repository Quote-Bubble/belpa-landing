---
import LiveWidget from "./LiveWidget.astro";
import RoofStory from "./RoofStory.astro";

// Keep in sync with Nav.astro meetingUrl
const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
---

<!--
  Left-aligned hero. The wordmark opens large and flies up into the nav on
  scroll — Nav.astro owns the visible flying mark, everything here marked
  data-brand-spacer / data-widget-spacer / data-meeting-spacer is layout-only
  and gets handed off to it (see brand-dock.ts).

  The roof scan is the proof: it traces the outline and reads the roof back as
  facts, which explains the product faster than the paragraph does. The widget
  sits underneath at its own full width.

  ⚠️ The widget column must stay WIDER THAN 640px. The embed picks its mobile
  layout from its own width, so a narrower column makes it request the
  fullscreen overlay on desktop — which is exactly the flap the split hero
  caused. 740px keeps it comfortably clear.
-->
<section class="hero relative flex min-h-[100svh] flex-col">
  <div class="hero-stage relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-5 sm:px-6">
    <!-- Deliberately not a heading. This is the brand mark, and its only
         content is an image with an empty alt — so as a top-level heading it
         was literally empty to a crawler, while the actual promise sat in a
         paragraph below. The promise is the heading now; the brand is
         announced by the header link, so this is decorative. -->
    <div class="hero-brand" aria-hidden="true">
      <span class="hero-brand-spacer" data-brand-spacer>
        <img
          src="/belpa-wordmark.png"
          alt=""
          width="900"
          height="279"
          fetchpriority="high"
          decoding="sync"
        />
      </span>
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="font-display hero-promise sub-load">
          Stop losing leads with slow quotes.
        </h1>
        <p class="hero-support sub-load sub-load-late">
          We'll give your customers instant, indicative quotes from satellite
          imagery, so you know which jobs are worth the visit.
        </p>

        <a
          href={meetingUrl}
          class="hero-book meeting-load"
          data-meeting-spacer
          data-meeting-cta
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="2"/>
            <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Book a call
          <span class="hero-book-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-scan sub-load sub-load-late">
        <RoofStory />
      </div>
    </div>

    <!-- The embed is the real widget, unmodified — the same one roofers put on
         their own sites. Its button says "Get quote" because that is what a
         homeowner is doing; it must NOT be relabelled to something like "try
         it free", which would be nonsense on a customer's site. -->
    <div class="hero-widget widget-load" data-widget-shell>
      <!-- Holds layout while #belpa-widget is position:fixed during the dock morph -->
      <div class="hero-widget-spacer" data-widget-spacer aria-hidden="true"></div>
      <LiveWidget />
    </div>

    <!-- Nothing sits under the widget. Two attempts have been made: an
         instruction above it ("Try it free. Put in any UK postcode…"), which
         had to shout to earn its space, and a reassurance row underneath
         ("Free to try · No sign-up · Any UK address"), which read as template
         filler — it answered objections this page doesn't create, since the
         flow asks for nothing until the very end. If the demo needs an
         invitation, it belongs inside the control (the embed's placeholder,
         scoped to the belpa-landing-demo roofer) rather than as furniture
         bolted around it. -->

  </div>

  <button
    type="button"
    class="hero-scroll"
    data-hero-scroll
    aria-label="Scroll to see what quoting costs you"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</section>

<style>
  .hero-stage {
    padding-top: max(5.5rem, calc(env(safe-area-inset-top, 0px) + 5rem));
    padding-bottom: clamp(2.5rem, 6svh, 4rem);
  }

  /* —— Brand —— */
  .hero-brand {
    margin: 0;
    /* Zero strut so the inline-block spacer isn't sitting on a baseline with a
       descender gap under it — the line box is then exactly the logo's height. */
    line-height: 0;
  }
  /* font-size is the single size knob: brand-dock.ts reads
     getComputedStyle(spacer).fontSize and drives the docked wordmark off it,
     and the img is sized in `em`. Change the size here, never on the img. */
  .hero-brand-spacer {
    position: relative;
    display: inline-block;
    font-size: clamp(3rem, 6.5vw, 4.75rem);
    line-height: 0;
    user-select: none;
    pointer-events: none;
    opacity: 0;
    transform: translateY(0.3em) scale(1.35);
    filter: blur(14px);
    transform-origin: 0% 100%;
    animation: brand-enter 1.2s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) 0.18s forwards;
  }
  .hero-brand-spacer img {
    display: block;
    height: 1em;
    width: auto;
  }
  /* Sheen clipped to the logo's alpha with a mask — background-clip:text only
     works on glyphs, and this is an image. */
  .hero-brand-spacer::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(91, 140, 255, 0.9) 50%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 200% 50%;
    -webkit-mask-image: url("/belpa-wordmark.png");
    mask-image: url("/belpa-wordmark.png");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: brand-sheen 9s linear 1.4s infinite;
  }
  /* Hidden only once the fixed wordmark is placed — no mid-scroll handoff */
  :global(html.is-brand-morphing) .hero-brand-spacer {
    visibility: hidden;
  }

  @keyframes brand-enter {
    50% { opacity: 1; filter: blur(2.5px); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }
  @keyframes brand-sheen {
    0% { background-position: 200% 50%; }
    32% { background-position: -200% 50%; }
    100% { background-position: -200% 50%; }
  }

  /* —— Copy beside proof —— */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.25rem);
    align-items: center;
    width: 100%;
    margin-top: clamp(1.1rem, 3svh, 1.9rem);
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
      gap: clamp(2rem, 4.5vw, 3.25rem);
    }
  }

  .hero-copy {
    text-align: left;
  }

  .hero-promise {
    margin: 0;
    max-width: 15em;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.06;
    color: var(--color-ink);
  }

  .hero-support {
    margin: 1.05rem 0 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.7vw, 1.1rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* Deliberately a quiet link, not a filled slab: the widget below is the
     primary action and a saturated button here out-shouted it. */
  .hero-book {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.35rem;
    padding: 0.6rem 0;
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--color-brand-600);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .hero-book svg { flex: none; }
  .hero-book-arrow {
    transition: transform 0.25s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .hero-book:hover { color: var(--color-brand-700, var(--color-brand-600)); }
  .hero-book:hover .hero-book-arrow { transform: translateX(3px); }
  .hero-book:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .hero-scan {
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .hero-scan {
      max-width: none;
      margin-inline: 0;
    }
  }

  /* —— The widget ——
     Centred, not left-aligned with the copy. Left-aligned it sat under the
     copy column while the space beneath the scan card stayed empty, so it
     read as floating loose on the blob rather than belonging to the hero.
     Centred, with the line above naming it, it reads as its own demo band.
     Width stays >640px — see the warning at the top of this file. */
  .hero-widget {
    position: relative;
    width: 100%;
    max-width: 740px;
    margin-top: clamp(1.6rem, 3.8svh, 2.5rem);
    margin-inline: auto;
  }
  .hero-widget-spacer {
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  /* —— Responsive —— */
  @media (max-width: 1023px) {
    .hero-stage {
      padding-top: max(5rem, calc(env(safe-area-inset-top, 0px) + 4.75rem));
    }
    .hero-widget { margin-inline: auto; }
  }

  @media (max-width: 640px) {
    .hero { min-height: 100svh; }
    .hero-stage {
      padding-top: max(4.5rem, calc(env(safe-area-inset-top, 0px) + 4.25rem));
      padding-bottom: max(2rem, env(safe-area-inset-bottom, 0px));
    }
    .hero-brand-spacer { font-size: clamp(2.75rem, 11vw, 3.5rem); }
    .hero-grid { gap: 1.3rem; margin-top: 1rem; }
    .hero-promise {
      font-size: clamp(1.75rem, 7.4vw, 2.15rem);
      line-height: 1.1;
      max-width: 13em;
    }
    .hero-support {
      margin-top: 0.8rem;
      font-size: 1rem;
      line-height: 1.5;
      max-width: 24rem;
    }
    .hero-book { margin-top: 1rem; }
    .hero-scroll {
      bottom: max(0.65rem, calc(env(safe-area-inset-bottom, 0px) + 0.35rem));
    }
  }

  /* Short laptops: keep the whole stack inside the fold. */
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero-stage {
      padding-top: 5rem;
      padding-bottom: 1.75rem;
    }
    .hero-brand-spacer { font-size: clamp(2.5rem, 4.5vw, 3.25rem); }
    .hero-promise { font-size: clamp(1.75rem, 3.2vw, 2.35rem); }
  }

  /* Phones can't fit wordmark + copy + scan + widget in one screen. rafil is
     right that something has to go, and it's the scan: the widget is the demo
     and the copy is the pitch, so the animation is the only expendable one.
     Words carry the story below this height. */
  @media (max-width: 640px) and (max-height: 780px) {
    .hero-scan { display: none; }
  }

  /* —— Scroll cue —— */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    z-index: 12;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translate3d(-50%, 6px, 0);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.7s var(--ease-out-soft, ease),
      transform 0.7s var(--ease-out-soft, ease),
      color 0.15s ease;
  }
  .hero-scroll.is-shown {
    opacity: 0.62;
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
    animation: hero-scroll-drift 2.2s var(--ease-out-soft, ease-in-out) 0.5s infinite;
  }
  .hero-scroll.is-gone {
    opacity: 0;
    transform: translate3d(-50%, 8px, 0);
    pointer-events: none;
    animation: none;
  }
  .hero-scroll:hover { opacity: 0.85; color: var(--color-ink); }
  .hero-scroll:focus-visible {
    opacity: 0.9;
    color: var(--color-ink);
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .hero-scroll svg { width: 24px; height: 24px; }

  @keyframes hero-scroll-drift {
    0%, 100% { transform: translate3d(-50%, 0, 0); }
    50% { transform: translate3d(-50%, 5px, 0); }
  }

  @media (max-height: 700px) {
    .hero-scroll { bottom: 0.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brand-spacer {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-brand-spacer::after { content: none; animation: none; }
    .hero-scroll.is-shown { animation: none; }
  }
</style>

<script>
  function initTryCta() {
    const card = document.getElementById("belpa-widget");
    if (!card) return;
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", () => {
        // Always return to the top search
        const lenis = window.__lenis;
        if (lenis?.scrollTo) lenis.scrollTo(0, { duration: 1.1 });
        else window.scrollTo({ top: 0, behavior: "smooth" });
        // The search input lives inside the widget iframe now — focus it
        // across the frame boundary via the host bridge.
        const focusEmbed = (window as unknown as { __belpaFocus?: () => void })
          .__belpaFocus;
        const input = card.querySelector("[data-input]") as HTMLInputElement | null;
        window.setTimeout(() => {
          if (focusEmbed) focusEmbed();
          else input?.focus({ preventScroll: true });
        }, 650);
      });
    });
  }

  // Freeze the rise at its end state so the compositor doesn't snap when
  // keyframes finish.
  function settleLoad(selector: string) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el || el.dataset.settleBound === "1") return;
    el.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== el) return;
      if (e.animationName !== "widget-rise") return;
      el.classList.add("is-settled");
      el.removeEventListener("animationend", done);
    };
    el.addEventListener("animationend", done);
  }

  function initHeroScrollCue() {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (!cue || cue.dataset.bound === "1") return;
    cue.dataset.bound = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let gone = false;

    const dismiss = () => {
      if (gone) return;
      gone = true;
      cue.classList.remove("is-shown");
      cue.classList.add("is-gone");
    };

    const show = () => {
      if (gone) return;
      // Already scrolled (e.g. restored) — never flash the cue
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 24) {
        dismiss();
        return;
      }
      cue.classList.add("is-shown");
    };

    window.setTimeout(show, reduce ? 400 : 2600);

    const onScroll = () => {
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 18) dismiss();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    const lenis = window.__lenis;
    lenis?.on?.("scroll", onScroll);

    cue.addEventListener("click", () => {
      dismiss();
      const target = document.querySelector("#numbers") || document.querySelector("#how");
      if (!target) return;
      const l = window.__lenis;
      if (l?.scrollTo) l.scrollTo(target as HTMLElement, { offset: -24, duration: 1.2 });
      else (target as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function boot() {
    initTryCta();
    settleLoad("[data-widget-shell]");
    settleLoad("[data-meeting-cta]");
    initHeroScrollCue();
  }

  boot();
  document.addEventListener("astro:after-swap", () => {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (cue) delete cue.dataset.bound;
    boot();
  });
</script>

