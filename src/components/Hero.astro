---
import LiveWidget from "./LiveWidget.astro";
---

<!--
  Hero without brand wordmark — Quoter lives in the glass nav.
  One live quote embed; headline leads.
-->
<section class="hero relative flex min-h-[100svh] flex-col" aria-labelledby="hero-heading">
  <div
    class="hero-stage relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col items-center px-5 text-center sm:px-6"
  >
    <div class="hero-cluster w-full">
      <h1 id="hero-heading" class="font-display hero-promise sub-load">
        Stop losing leads with slow quotes.
      </h1>
      <p class="hero-support sub-load sub-load-late">
        We'll give potential clients visiting your site accurate, instant quotes using satellite imagery.
      </p>

      <div
        class="hero-widget mx-auto w-full max-w-[740px] widget-load"
        id="demo"
        data-widget-shell
      >
        <div class="hero-widget-spacer" data-widget-spacer aria-hidden="true"></div>
        <LiveWidget />
      </div>

      <p class="hero-helper">Instant estimate. No payment needed. Beta.</p>
    </div>
  </div>

  <button
    type="button"
    class="hero-scroll"
    data-hero-scroll
    aria-label="Scroll to see how Quoter measures roofs"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</section>

<style>
  .hero-stage {
    justify-content: center;
    padding-top: max(5.5rem, calc(env(safe-area-inset-top, 0px) + 4.5rem));
    padding-bottom: clamp(1.25rem, 3.5svh, 2.75rem);
  }

  .hero-promise {
    margin: 0 auto;
    max-width: 16em;
    font-size: clamp(2rem, 5.2vw, 3.15rem);
    font-weight: 600;
    letter-spacing: -0.042em;
    line-height: 1.08;
    color: var(--color-ink);
  }

  .hero-support {
    margin: 0.85rem auto 0;
    max-width: 38rem;
    font-size: clamp(1.02rem, 1.8vw, 1.15rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.55;
    color: #1c2430;
  }

  .hero-widget {
    position: relative;
    margin-top: clamp(1.35rem, 3.4svh, 2.25rem);
  }
  .hero-widget-spacer {
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  .hero-helper {
    margin: 0.7rem auto 0;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #3d4148;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
    }
    .hero-stage {
      justify-content: center;
      padding-top: max(5rem, calc(env(safe-area-inset-top, 0px) + 4.1rem));
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    }
    .hero-promise {
      font-size: clamp(1.7rem, 7.2vw, 2.15rem);
      max-width: 14em;
    }
    .hero-support {
      margin-top: 0.65rem;
      font-size: 1.02rem;
    }
    .hero-widget {
      margin-top: 1.35rem;
    }
    .hero-scroll {
      bottom: max(0.65rem, calc(env(safe-area-inset-bottom, 0px) + 0.35rem));
    }
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    z-index: 12;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translate3d(-50%, 6px, 0);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.7s var(--ease-out-soft, ease),
      transform 0.7s var(--ease-out-soft, ease),
      color 0.15s ease;
  }
  .hero-scroll.is-shown {
    opacity: 0.62;
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
    animation: hero-scroll-drift 2.2s var(--ease-out-soft, ease-in-out) 0.5s infinite;
  }
  .hero-scroll.is-gone {
    opacity: 0;
    transform: translate3d(-50%, 8px, 0);
    pointer-events: none;
    animation: none;
  }
  .hero-scroll:hover {
    opacity: 0.85;
    color: var(--color-ink);
  }
  .hero-scroll:focus-visible {
    opacity: 0.9;
    color: var(--color-ink);
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
    border-radius: 999px;
  }
  @keyframes hero-scroll-drift {
    0%,
    100% {
      transform: translate3d(-50%, 0, 0);
    }
    50% {
      transform: translate3d(-50%, 5px, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll.is-shown {
      animation: none;
    }
  }
</style>

<script>
  function initTryCta() {
    const card = document.getElementById("quoter-widget");
    if (!card) return;
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        const demo = document.getElementById("demo");
        const lenis = window.__lenis;
        if (demo) {
          if (lenis?.scrollTo) lenis.scrollTo(demo, { offset: -96, duration: 1.0 });
          else demo.scrollIntoView({ behavior: "smooth", block: "center" });
        } else if (lenis?.scrollTo) {
          lenis.scrollTo(0, { duration: 1.1 });
        } else {
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
        window.setTimeout(() => {
          (window as unknown as { __quoterFocus?: () => void }).__quoterFocus?.();
        }, 550);
      });
    });
  }

  function settleWidgetLoad() {
    const shell = document.querySelector<HTMLElement>("[data-widget-shell]");
    if (!shell || shell.dataset.settleBound === "1") return;
    shell.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== shell) return;
      if (e.animationName !== "widget-rise") return;
      shell.classList.add("is-settled");
      shell.removeEventListener("animationend", done);
    };
    shell.addEventListener("animationend", done);
  }

  function initHeroScrollCue() {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (!cue || cue.dataset.bound === "1") return;
    cue.dataset.bound = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let gone = false;

    const dismiss = () => {
      if (gone) return;
      gone = true;
      cue.classList.remove("is-shown");
      cue.classList.add("is-gone");
    };

    const show = () => {
      if (gone) return;
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 24) {
        dismiss();
        return;
      }
      cue.classList.add("is-shown");
    };

    window.setTimeout(show, reduce ? 400 : 2200);

    const onScroll = () => {
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 18) dismiss();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.__lenis?.on?.("scroll", onScroll);

    cue.addEventListener("click", () => {
      dismiss();
      const target =
        document.querySelector("#product") || document.querySelector("#pricing");
      if (!target) return;
      const l = window.__lenis;
      if (l?.scrollTo) l.scrollTo(target as HTMLElement, { offset: -72, duration: 1.2 });
      else (target as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  initTryCta();
  settleWidgetLoad();
  initHeroScrollCue();
  document.addEventListener("astro:after-swap", () => {
    document.querySelectorAll("[data-try]").forEach((btn) => {
      delete (btn as HTMLElement).dataset.tryBound;
    });
    initTryCta();
    settleWidgetLoad();
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (cue) delete cue.dataset.bound;
    initHeroScrollCue();
  });
</script>
