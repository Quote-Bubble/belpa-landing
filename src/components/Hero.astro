---
import LiveWidget from "./LiveWidget.astro";
import RoofStory from "./RoofStory.astro";

---

<!--
  Left-aligned hero. The wordmark opens large and flies up into the nav on
  scroll — Nav.astro owns the visible flying mark, everything here marked
  data-brand-spacer / data-widget-spacer is layout-only
  and gets handed off to it (see brand-dock.ts).

  Structure: one rail on the left — brand, promise, sub-line, then the live
  widget — with the roof scan beside it as support. Everything in the rail
  shares a left edge and reads top to bottom. The brand and the widget used to
  live outside that column (above and below the grid), which is what made the
  hero read as four loose objects arranged around a card.

  The roof scan is the proof: it traces the outline and reads the roof back as
  facts, which explains the product faster than the paragraph does. It is
  deliberately the smaller of the two — it narrates, the widget does.

  ⚠️ The rail must stay WIDER THAN 640px. The embed picks its mobile layout
  from its own width, so a narrower rail makes it request the fullscreen
  overlay on desktop — the flap that a fractional column caused before. The
  rail is a fixed 680px for exactly this reason: a fraction silently drops
  under the threshold at some viewport, a fixed width cannot.
-->
<section class="hero relative flex min-h-[100svh] flex-col">
  <div class="hero-stage relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-5 sm:px-6">
    <div class="hero-grid">
      <!-- One rail, read top to bottom: who we are, what we fix, how you say
           it, then the control that does it. The brand and the widget used to
           sit OUTSIDE this column — the brand above the grid, the widget below
           it — which is what made the hero read as four unrelated objects
           scattered around a card. -->
      <div class="hero-copy">
        <!-- Deliberately not a heading. This is the brand mark, and its only
             content is an image with an empty alt — so as a top-level heading
             it was literally empty to a crawler, while the actual promise sat
             in a paragraph below. The promise is the heading; the brand is
             announced by the header link, so this is decorative. -->
        <div class="hero-brand" aria-hidden="true">
          <span class="hero-brand-spacer" data-brand-spacer>
            <img
              src="/belpa-wordmark.png"
              alt=""
              width="900"
              height="279"
              fetchpriority="high"
              decoding="sync"
            />
          </span>
        </div>

        <h1 class="font-display hero-promise sub-load">
          Stop losing leads with slow quotes.
        </h1>
        <p class="hero-support sub-load sub-load-late">
          We'll give your customers instant, indicative quotes from satellite
          imagery, so you know which jobs are worth the visit.
        </p>

        <!-- The embed is the real widget, unmodified — the same one roofers put
             on their own sites. Its button says "Get quote" because that is what
             a homeowner is doing; it must NOT be relabelled to something like
             "try it free", which would be nonsense on a customer's site. -->
        <div class="hero-widget widget-load" data-widget-shell>
          <!-- Holds layout while #belpa-widget is position:fixed in overlay mode -->
          <div class="hero-widget-spacer" data-widget-spacer aria-hidden="true"></div>
          <LiveWidget />
        </div>
      </div>

      <div class="hero-scan sub-load sub-load-late">
        <RoofStory />
      </div>
    </div>

    <!-- Nothing sits under the widget. Two attempts have been made: an
         instruction above it ("Try it free. Put in any UK postcode…"), which
         had to shout to earn its space, and a reassurance row underneath
         ("Free to try · No sign-up · Any UK address"), which read as template
         filler — it answered objections this page doesn't create, since the
         flow asks for nothing until the very end. If the demo needs an
         invitation, it belongs inside the control (the embed's placeholder,
         scoped to the belpa-landing-demo roofer) rather than as furniture
         bolted around it. -->

  </div>

  <button
    type="button"
    class="hero-scroll"
    data-hero-scroll
    aria-label="Scroll to see what quoting costs you"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</section>

<style>
  .hero-stage {
    padding-top: max(5.5rem, calc(env(safe-area-inset-top, 0px) + 5rem));
    padding-bottom: clamp(2.5rem, 6svh, 4rem);
  }

  /* —— Brand —— */
  .hero-brand {
    /* Opens the rail, so it needs air beneath it rather than sitting on the
       headline. It is no longer the biggest thing on screen — the promise is,
       which is the right way round for a brand nobody recognises yet. */
    margin: 0 0 clamp(1.4rem, 3.2svh, 2.25rem);
    /* Zero strut so the inline-block spacer isn't sitting on a baseline with a
       descender gap under it — the line box is then exactly the logo's height. */
    line-height: 0;
  }
  /* font-size is the single size knob: brand-dock.ts reads
     getComputedStyle(spacer).fontSize and drives the docked wordmark off it,
     and the img is sized in `em`. Change the size here, never on the img. */
  .hero-brand-spacer {
    position: relative;
    display: inline-block;
    font-size: clamp(2.4rem, 4.4vw, 3.5rem);
    line-height: 0;
    user-select: none;
    pointer-events: none;
    opacity: 0;
    transform: translateY(0.3em) scale(1.35);
    filter: blur(14px);
    transform-origin: 0% 100%;
    animation: brand-enter 1.2s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) 0.18s forwards;
  }
  .hero-brand-spacer img {
    display: block;
    height: 1em;
    width: auto;
  }
  /* Sheen clipped to the logo's alpha with a mask — background-clip:text only
     works on glyphs, and this is an image. */
  .hero-brand-spacer::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(91, 140, 255, 0.9) 50%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 200% 50%;
    -webkit-mask-image: url("/belpa-wordmark.png");
    mask-image: url("/belpa-wordmark.png");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: brand-sheen 9s linear 1.4s infinite;
  }
  /* Hidden only once the fixed wordmark is placed — no mid-scroll handoff */
  :global(html.is-brand-morphing) .hero-brand-spacer {
    visibility: hidden;
  }

  @keyframes brand-enter {
    50% { opacity: 1; filter: blur(2.5px); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }
  @keyframes brand-sheen {
    0% { background-position: 200% 50%; }
    32% { background-position: -200% 50%; }
    100% { background-position: -200% 50%; }
  }

  /* —— Copy beside proof —— */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.25rem);
    align-items: center;
    width: 100%;
  }
  /* The rail is a FIXED 680px, not a fraction.

     Two reasons. It has to clear 640px or the embed inside it switches to its
     mobile fullscreen layout (the overlay flap warned about at the top of this
     file) — a fractional column silently drops under that at some viewport and
     the bug comes back. And fixing it makes the widget's geometry deterministic,
     so the bar's alignment below is a constant rather than something that has
     to be re-derived per breakpoint.

     Splitting at 1200px rather than 1024px: 680 + gap + a usable panel does not
     fit below that, so the layout stacks instead of cramming. */
  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: 680px minmax(0, 1fr);
      column-gap: clamp(2.75rem, 4vw, 4.5rem);
      align-items: center;
    }
  }

  .hero-copy {
    text-align: left;
  }

  .hero-promise {
    margin: 0;
    max-width: 15em;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.06;
    color: var(--color-ink);
  }

  .hero-support {
    margin: 1.05rem 0 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.7vw, 1.1rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }


  /* The panel is support, not a second hero. Beside the rail it takes whatever
     the grid leaves (~480px), which keeps it clearly secondary to the control
     on the left — the two used to sit at matching weight, which is why the page
     read as having two competing search bars. */
  .hero-scan {
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }
  @media (min-width: 1200px) {
    .hero-scan {
      max-width: none;
      margin-inline: 0;
    }
  }

  /* —— The widget ——
     Last item in the rail: the control you actually use, directly under the
     sentence that promises it. Everything above sets it up. */
  .hero-widget {
    position: relative;
    width: 100%;
    max-width: 740px;
    margin-top: clamp(1.85rem, 4svh, 2.9rem);
    margin-inline: auto;
  }

  /* Line the visible BAR up with the headline, not the iframe.

     The embed centres its own card inside the frame, so left-aligning the
     frame still leaves the bar floating inside it. The offset is half the
     leftover — and `min()` makes it self-correcting across both stages rather
     than two hand-written numbers: collapsed the card is 620 in a 680 frame
     (-30px), in flow it wants 700 but the frame caps it at 680, so the
     leftover is zero and the bar simply stays put as the panel opens.

     ⚠️ 620/700 mirror --quote-collapsed-width / --quote-shell-width in
     belpa-widget-frontend/app/globals.css. If those move, move these. */
  @media (min-width: 1200px) {
    .hero-widget {
      --q-frame-w: 680px;
      --q-card-w: 620px;
      margin-inline: calc(
          (min(var(--q-card-w), var(--q-frame-w)) - var(--q-frame-w)) / 2
        )
        auto;
    }
    .hero-widget:has(#belpa-widget[data-stage="flow"]) {
      --q-card-w: 700px;
    }
  }
  .hero-widget-spacer {
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  /* —— Responsive —— */
  @media (max-width: 1023px) {
    .hero-stage {
      padding-top: max(5rem, calc(env(safe-area-inset-top, 0px) + 4.75rem));
    }
  }

  @media (max-width: 640px) {
    .hero { min-height: 100svh; }
    .hero-stage {
      padding-top: max(4.5rem, calc(env(safe-area-inset-top, 0px) + 4.25rem));
      padding-bottom: max(2rem, env(safe-area-inset-bottom, 0px));
    }
    .hero-brand-spacer { font-size: clamp(2.75rem, 11vw, 3.5rem); }
    .hero-grid { gap: 1.3rem; }
    .hero-promise {
      font-size: clamp(1.75rem, 7.4vw, 2.15rem);
      line-height: 1.1;
      max-width: 13em;
    }
    .hero-support {
      margin-top: 0.8rem;
      font-size: 1rem;
      line-height: 1.5;
      max-width: 24rem;
    }
    .hero-scroll {
      bottom: max(0.65rem, calc(env(safe-area-inset-bottom, 0px) + 0.35rem));
    }
  }

  /* Short laptops: keep the whole stack inside the fold. */
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero-stage {
      padding-top: 5rem;
      padding-bottom: 1.75rem;
    }
    .hero-brand-spacer { font-size: clamp(2.5rem, 4.5vw, 3.25rem); }
    .hero-promise { font-size: clamp(1.75rem, 3.2vw, 2.35rem); }
  }

  /* Phones can't fit wordmark + copy + scan + widget in one screen. rafil is
     right that something has to go, and it's the scan: the widget is the demo
     and the copy is the pitch, so the animation is the only expendable one.
     Words carry the story below this height. */
  @media (max-width: 640px) and (max-height: 780px) {
    .hero-scan { display: none; }
  }

  /* —— Scroll cue —— */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    z-index: 12;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translate3d(-50%, 6px, 0);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.7s var(--ease-out-soft, ease),
      transform 0.7s var(--ease-out-soft, ease),
      color 0.15s ease;
  }
  .hero-scroll.is-shown {
    opacity: 0.62;
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
    animation: hero-scroll-drift 2.2s var(--ease-out-soft, ease-in-out) 0.5s infinite;
  }
  .hero-scroll.is-gone {
    opacity: 0;
    transform: translate3d(-50%, 8px, 0);
    pointer-events: none;
    animation: none;
  }
  .hero-scroll:hover { opacity: 0.85; color: var(--color-ink); }
  .hero-scroll:focus-visible {
    opacity: 0.9;
    color: var(--color-ink);
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .hero-scroll svg { width: 24px; height: 24px; }

  @keyframes hero-scroll-drift {
    0%, 100% { transform: translate3d(-50%, 0, 0); }
    50% { transform: translate3d(-50%, 5px, 0); }
  }

  @media (max-height: 700px) {
    .hero-scroll { bottom: 0.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brand-spacer {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-brand-spacer::after { content: none; animation: none; }
    .hero-scroll.is-shown { animation: none; }
  }
</style>

<script>
  function initTryCta() {
    const card = document.getElementById("belpa-widget");
    if (!card) return;
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", () => {
        // Always return to the top search
        const lenis = window.__lenis;
        if (lenis?.scrollTo) lenis.scrollTo(0, { duration: 1.1 });
        else window.scrollTo({ top: 0, behavior: "smooth" });
        // The search input lives inside the widget iframe now — focus it
        // across the frame boundary via the host bridge.
        const focusEmbed = (window as unknown as { __belpaFocus?: () => void })
          .__belpaFocus;
        const input = card.querySelector("[data-input]") as HTMLInputElement | null;
        window.setTimeout(() => {
          if (focusEmbed) focusEmbed();
          else input?.focus({ preventScroll: true });
        }, 650);
      });
    });
  }

  // Freeze the rise at its end state so the compositor doesn't snap when
  // keyframes finish.
  function settleLoad(selector: string) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el || el.dataset.settleBound === "1") return;
    el.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== el) return;
      if (e.animationName !== "widget-rise") return;
      el.classList.add("is-settled");
      el.removeEventListener("animationend", done);
    };
    el.addEventListener("animationend", done);
  }

  function initHeroScrollCue() {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (!cue || cue.dataset.bound === "1") return;
    cue.dataset.bound = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let gone = false;

    const dismiss = () => {
      if (gone) return;
      gone = true;
      cue.classList.remove("is-shown");
      cue.classList.add("is-gone");
    };

    const show = () => {
      if (gone) return;
      // Already scrolled (e.g. restored) — never flash the cue
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 24) {
        dismiss();
        return;
      }
      cue.classList.add("is-shown");
    };

    window.setTimeout(show, reduce ? 400 : 2600);

    const onScroll = () => {
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 18) dismiss();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    const lenis = window.__lenis;
    lenis?.on?.("scroll", onScroll);

    cue.addEventListener("click", () => {
      dismiss();
      const target = document.querySelector("#numbers") || document.querySelector("#how");
      if (!target) return;
      const l = window.__lenis;
      if (l?.scrollTo) l.scrollTo(target as HTMLElement, { offset: -24, duration: 1.2 });
      else (target as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function boot() {
    initTryCta();
    settleLoad("[data-widget-shell]");
    initHeroScrollCue();
  }

  boot();
  document.addEventListener("astro:after-swap", () => {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (cue) delete cue.dataset.bound;
    boot();
  });
</script>

