---
import LiveWidget from "./LiveWidget.astro";

// Keep in sync with Nav.astro meetingUrl
const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
---

<!--
  Split hero. Copy leads on the left, the product proves itself on the right:
  the aerial scan says "measured from satellite imagery" in the fold, and the
  live widget under it lets you actually try the thing.

  The brand lives in the header now, not here — see Nav.astro for why the old
  centred-wordmark scroll-morph was retired.
-->
<section class="hero relative flex min-h-[100svh] flex-col">
  <div class="hero-stage relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-5 sm:px-6">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="font-display hero-promise sub-load">
          Stop losing leads with slow quotes.
        </h1>
        <p class="hero-support sub-load sub-load-late">
          We'll give potential clients visiting your site accurate, instant quotes using satellite imagery.
        </p>

        <!-- Deliberately a quiet link, not a filled slab: the widget opposite
             is the primary action, and a saturated button here out-shouted it. -->
        <a
          href={meetingUrl}
          class="hero-book meeting-load"
          data-meeting-cta
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="2"/>
            <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Book a call
          <span class="hero-book-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-demo">
        <!-- Proof, not decoration: an aerial roof under a measuring pass.
             Stylised treatment only — no figures, nothing claimed. -->
        <figure class="hero-scan sub-load sub-load-late" aria-hidden="true">
          <img
            src="/roof-scan.webp"
            alt=""
            width="1100"
            height="686"
            loading="eager"
            fetchpriority="high"
          />
          <span class="hero-scan-sweep"></span>
          <!-- vector-effect must be a per-shape attribute: it isn't inherited,
               so setting it on the <svg> in CSS would do nothing and the short-
               viewport aspect-ratio overrides below would squash the strokes. -->
          <svg class="hero-scan-marks" viewBox="0 0 100 62" preserveAspectRatio="none">
            <path d="M6 16V8h9" vector-effect="non-scaling-stroke" />
            <path d="M94 16V8h-9" vector-effect="non-scaling-stroke" />
            <path d="M6 46v8h9" vector-effect="non-scaling-stroke" />
            <path d="M94 46v8h-9" vector-effect="non-scaling-stroke" />
          </svg>
          <figcaption class="hero-scan-chip">
            <span class="hero-scan-dot"></span>
            Satellite measurement
          </figcaption>
        </figure>

        <div class="hero-widget widget-load" data-widget-shell>
          <LiveWidget />
        </div>
      </div>
    </div>
  </div>

  <button
    type="button"
    class="hero-scroll"
    data-hero-scroll
    aria-label="Scroll to see how Belpa measures roofs"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</section>

<style>
  .hero-stage {
    /* Clear the fixed header, then centre what's left. */
    padding-top: max(6rem, calc(env(safe-area-inset-top, 0px) + 5.5rem));
    padding-bottom: clamp(3rem, 8svh, 5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 2.75rem);
    align-items: center;
    width: 100%;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      /* Copy gets a touch less than half — the demo is the thing to look at. */
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: clamp(2.25rem, 5vw, 4rem);
    }
  }

  /* —— Left: the pitch —— */
  .hero-copy {
    text-align: center;
  }
  @media (min-width: 1024px) {
    .hero-copy {
      text-align: left;
    }
  }

  .hero-promise {
    margin: 0;
    max-width: 15em;
    font-size: clamp(2.1rem, 4.6vw, 3.35rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.06;
    color: var(--color-ink);
  }
  @media (max-width: 1023px) {
    .hero-promise {
      margin-inline: auto;
    }
  }

  .hero-support {
    margin: 1.15rem 0 0;
    max-width: 34rem;
    font-size: clamp(1.02rem, 1.8vw, 1.15rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  @media (max-width: 1023px) {
    .hero-support {
      margin-inline: auto;
    }
  }

  .hero-book {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.6rem;
    padding: 0.6rem 0;
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--color-brand-600);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .hero-book svg {
    flex: none;
  }
  .hero-book-arrow {
    transition: transform 0.25s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .hero-book:hover {
    color: var(--color-brand-700, var(--color-brand-600));
  }
  .hero-book:hover .hero-book-arrow {
    transform: translateX(3px);
  }
  .hero-book:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* —— Right: the proof + the demo —— */
  .hero-demo {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 2vw, 1.15rem);
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .hero-demo {
      max-width: none;
      margin-inline: 0;
    }
  }

  .hero-scan {
    position: relative;
    /* Contain the sweep's mix-blend-mode: without a stacking context here it
       would blend against the page/blob behind the card, not just the photo. */
    isolation: isolate;
    overflow: hidden;
    margin: 0;
    border-radius: 20px;
    aspect-ratio: 100 / 62;
    background: #dfe6ef;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.5) inset,
      0 2px 8px rgba(16, 24, 40, 0.08),
      0 28px 60px -28px rgba(23, 60, 160, 0.45);
  }
  .hero-scan img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The measuring pass. A single soft band crossing the roof — reads as
     "being scanned" without inventing any numbers on top of a stock photo. */
  /* A fixed-height band translated top-to-bottom. Deliberately transform and
     opacity rather than an animated background-position: only these two are
     compositor properties, and the percentage maths on an oversized gradient
     is far harder to reason about than moving a band by its own height. */
  .hero-scan-sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 42%;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(91, 140, 255, 0) 0%,
      rgba(120, 176, 255, 0.45) 42%,
      rgba(255, 255, 255, 0.8) 50%,
      rgba(120, 176, 255, 0.45) 58%,
      rgba(91, 140, 255, 0) 100%
    );
    mix-blend-mode: screen;
    opacity: 0;
    /* -110% clears the top edge; 340% of a 42%-tall band clears the bottom. */
    transform: translate3d(0, -110%, 0);
    animation: hero-scan-pass 7s cubic-bezier(0.5, 0, 0.5, 1) 1.6s infinite;
  }
  @keyframes hero-scan-pass {
    0% {
      transform: translate3d(0, -110%, 0);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    50% {
      opacity: 1;
    }
    58% {
      transform: translate3d(0, 340%, 0);
      opacity: 0;
    }
    100% {
      transform: translate3d(0, 340%, 0);
      opacity: 0;
    }
  }

  .hero-scan-marks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    fill: none;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 0.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 1px 2px rgba(6, 20, 48, 0.45));
  }

  .hero-scan-chip {
    position: absolute;
    left: clamp(0.7rem, 2.5%, 1.1rem);
    bottom: clamp(0.7rem, 2.5%, 1.1rem);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    /* Deliberately NOT backdrop-filter. The card carries `sub-load`, which
       animates `filter: blur()`, and global.css documents that filter on an
       element with a glass child snaps the compositor when the keyframes
       finish. A flat scrim over a photo is indistinguishable anyway. */
    background: rgba(9, 20, 42, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.95);
    white-space: nowrap;
  }
  .hero-scan-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #6ea8ff;
    box-shadow: 0 0 0 3px rgba(110, 168, 255, 0.25);
    animation: hero-scan-blink 2.4s ease-in-out infinite;
  }
  @keyframes hero-scan-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .hero-widget {
    position: relative;
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scan-sweep,
    .hero-scan-dot {
      animation: none;
    }
    .hero-scan-sweep {
      opacity: 0;
    }
  }

  @media (max-width: 1023px) {
    .hero-stage {
      padding-top: max(5.25rem, calc(env(safe-area-inset-top, 0px) + 5rem));
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
    }
    .hero-stage {
      padding-top: max(4.75rem, calc(env(safe-area-inset-top, 0px) + 4.5rem));
      padding-bottom: max(2.25rem, env(safe-area-inset-bottom, 0px));
    }
    .hero-grid {
      gap: 1.6rem;
    }
    .hero-promise {
      font-size: clamp(1.85rem, 8vw, 2.3rem);
      line-height: 1.1;
      max-width: 13em;
    }
    .hero-support {
      margin-top: 0.85rem;
      font-size: 1.02rem;
      line-height: 1.5;
      max-width: 24rem;
    }
    .hero-book {
      margin-top: 1.1rem;
    }
    .hero-scan {
      border-radius: 16px;
    }
    .hero-scroll {
      /* Keep the cue inside the hero, above Safari chrome */
      bottom: max(0.65rem, calc(env(safe-area-inset-bottom, 0px) + 0.35rem));
    }
  }

  /* Short phones: the scan is the first thing to give up room. */
  @media (max-width: 640px) and (max-height: 760px) {
    .hero-scan {
      aspect-ratio: 100 / 46;
    }
    .hero-promise {
      font-size: clamp(1.7rem, 7.4vw, 2rem);
    }
    .hero-book {
      margin-top: 0.85rem;
    }
  }

  /* Very short phones (SE-class): copy + scan + widget can't all fit the fold,
     and the widget is the one that has to survive — it's the demo. Drop the
     scan entirely rather than shipping a hero you have to scroll to use. */
  @media (max-width: 640px) and (max-height: 700px) {
    .hero-scan {
      display: none;
    }
  }

  /* Short laptops: don't let the stack overflow the fold. */
  @media (min-width: 1024px) and (max-height: 760px) {
    .hero-stage {
      padding-top: 5.5rem;
      padding-bottom: 2rem;
    }
    .hero-promise {
      font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    }
    .hero-scan {
      aspect-ratio: 100 / 50;
    }
  }

  /* Late, quiet scroll cue — appears after entrance, leaves on first scroll */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    z-index: 12;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translate3d(-50%, 6px, 0);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.7s var(--ease-out-soft, ease),
      transform 0.7s var(--ease-out-soft, ease),
      color 0.15s ease;
  }
  .hero-scroll.is-shown {
    opacity: 0.62;
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
    animation: hero-scroll-drift 2.2s var(--ease-out-soft, ease-in-out) 0.5s infinite;
  }
  .hero-scroll.is-gone {
    opacity: 0;
    transform: translate3d(-50%, 8px, 0);
    pointer-events: none;
    animation: none;
  }
  .hero-scroll:hover {
    opacity: 0.85;
    color: var(--color-ink);
  }
  .hero-scroll:focus-visible {
    opacity: 0.9;
    color: var(--color-ink);
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .hero-scroll svg {
    width: 24px;
    height: 24px;
  }

  @keyframes hero-scroll-drift {
    0%,
    100% {
      transform: translate3d(-50%, 0, 0);
    }
    50% {
      transform: translate3d(-50%, 5px, 0);
    }
  }

  @media (max-height: 700px) {
    .hero-scroll {
      bottom: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll.is-shown {
      animation: none;
    }
  }
</style>

<script>
  function initTryCta() {
    const card = document.getElementById("belpa-widget");
    if (!card) return;
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", () => {
        // Always return to the top search
        const lenis = window.__lenis;
        if (lenis?.scrollTo) lenis.scrollTo(0, { duration: 1.1 });
        else window.scrollTo({ top: 0, behavior: "smooth" });
        // The search input lives inside the widget iframe now — focus it
        // across the frame boundary via the host bridge.
        const focusEmbed = (window as unknown as { __belpaFocus?: () => void })
          .__belpaFocus;
        const input = card.querySelector("[data-input]") as HTMLInputElement | null;
        window.setTimeout(() => {
          if (focusEmbed) focusEmbed();
          else input?.focus({ preventScroll: true });
        }, 650);
      });
    });
  }

  // Freeze the rise at its end state so the compositor doesn't snap when
  // keyframes finish.
  function settleLoad(selector: string) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el || el.dataset.settleBound === "1") return;
    el.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== el) return;
      if (e.animationName !== "widget-rise") return;
      el.classList.add("is-settled");
      el.removeEventListener("animationend", done);
    };
    el.addEventListener("animationend", done);
  }

  function initHeroScrollCue() {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (!cue || cue.dataset.bound === "1") return;
    cue.dataset.bound = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let gone = false;

    const dismiss = () => {
      if (gone) return;
      gone = true;
      cue.classList.remove("is-shown");
      cue.classList.add("is-gone");
    };

    const show = () => {
      if (gone) return;
      // Already scrolled (e.g. restored) — never flash the cue
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 24) {
        dismiss();
        return;
      }
      cue.classList.add("is-shown");
    };

    window.setTimeout(show, reduce ? 400 : 2600);

    const onScroll = () => {
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 18) dismiss();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    const lenis = window.__lenis;
    lenis?.on?.("scroll", onScroll);

    cue.addEventListener("click", () => {
      dismiss();
      const target = document.querySelector("#tech") || document.querySelector("#how");
      if (!target) return;
      const l = window.__lenis;
      if (l?.scrollTo) l.scrollTo(target as HTMLElement, { offset: -24, duration: 1.2 });
      else (target as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function boot() {
    initTryCta();
    settleLoad("[data-widget-shell]");
    settleLoad("[data-meeting-cta]");
    initHeroScrollCue();
  }

  boot();
  document.addEventListener("astro:after-swap", () => {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (cue) delete cue.dataset.bound;
    boot();
  });
</script>
