---
import LiveWidget from "./LiveWidget.astro";

const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
---

<!--
  Hybrid hero: morph spacer (brand-dock target) + one live quote embed.
  No second fake form. Book a call is secondary; trust strip sits under the embed.
-->
<section class="hero relative flex min-h-[100svh] flex-col" aria-labelledby="hero-heading">
  <div
    class="hero-stage relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col items-center px-5 text-center sm:px-6"
  >
    <div class="hero-cluster w-full">
      <h1 class="font-display hero-brand" aria-label="Quoter">
        <span class="hero-brand-spacer" data-brand-spacer aria-hidden="true">Quoter</span>
      </h1>
      <p id="hero-heading" class="font-display hero-promise sub-load">
        Stop losing leads with slow quotes.
      </p>
      <p class="hero-support sub-load sub-load-late">
        We'll give potential clients visiting your site accurate, instant quotes using satellite imagery.
      </p>

      <div
        class="hero-widget mx-auto w-full max-w-[740px] widget-load"
        id="demo"
        data-widget-shell
      >
        <div class="hero-widget-spacer" data-widget-spacer aria-hidden="true"></div>
        <LiveWidget />
      </div>

      <p class="hero-helper">Instant estimate. No payment needed. Beta.</p>

      <ul class="hero-trust" aria-label="Trust signals">
        <li>Powered by satellite imagery</li>
        <li>No payment needed</li>
        <li>Beta</li>
      </ul>

      <a
        href={meetingUrl}
        class="hero-meeting-takeoff meeting-load"
        data-meeting-spacer
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="2"/>
          <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Book a call
      </a>
    </div>
  </div>

  <button
    type="button"
    class="hero-scroll"
    data-hero-scroll
    aria-label="Scroll to see how Quoter measures roofs"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</section>

<style>
  .hero-stage {
    justify-content: center;
    /* Clear the fixed hybrid header */
    padding-top: max(4.75rem, calc(env(safe-area-inset-top, 0px) + 3.75rem));
    padding-bottom: clamp(1.25rem, 3.5svh, 2.75rem);
  }

  .hero-brand {
    margin: 0;
    line-height: 0.92;
  }

  .hero-brand-spacer {
    position: relative;
    display: inline-block;
    font-size: clamp(3.6rem, 11vw, 6.75rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.92;
    user-select: none;
    pointer-events: none;
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(0.4em) scale(1.55);
    filter: blur(14px);
    transform-origin: 50% 100%;
    animation: brand-enter 1.2s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) 0.18s forwards;
  }
  .hero-brand-spacer::after {
    content: "Quoter";
    position: absolute;
    left: 0;
    top: 0;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    white-space: nowrap;
    pointer-events: none;
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(91, 140, 255, 0.9) 50%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 200% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: brand-sheen 9s linear 1.4s infinite;
  }
  :global(html.is-brand-morphing) .hero-brand-spacer {
    visibility: hidden;
  }

  @keyframes brand-enter {
    50% {
      opacity: 1;
      filter: blur(2.5px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }
  @keyframes brand-sheen {
    0% {
      background-position: 200% 50%;
    }
    32% {
      background-position: -200% 50%;
    }
    100% {
      background-position: -200% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brand-spacer {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
      color: var(--color-ink);
    }
    .hero-brand-spacer::after {
      content: none;
      animation: none;
    }
  }

  .hero-promise {
    margin: 0.85rem auto 0;
    max-width: 20em;
    font-size: clamp(1.55rem, 3.8vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.038em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .hero-support {
    margin: 0.65rem auto 0;
    max-width: 38rem;
    font-size: clamp(1.02rem, 1.8vw, 1.15rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.55;
    color: #1c2430;
  }

  .hero-widget {
    position: relative;
    margin-top: clamp(1.2rem, 3svh, 2.1rem);
  }
  .hero-widget-spacer {
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  .hero-helper {
    margin: 0.7rem auto 0;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #3d4148;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.6rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 24, 40, 0.1);
    background: rgba(255, 255, 255, 0.9);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1c2430;
  }

  /* Secondary outline — not the same filled primary as the embed CTA */
  .hero-meeting-takeoff {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    position: relative;
    z-index: 2;
    width: min(100% - var(--q-embed-pad-x) * 2, 620px);
    margin: calc(0.85rem - var(--q-shadow-room)) auto 0;
    padding: 0.8rem 1.05rem;
    border-radius: 28px;
    border: 1.5px solid rgba(31, 87, 240, 0.35);
    background: rgba(255, 255, 255, 0.78);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-brand-700);
    text-decoration: none;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7) inset;
    box-sizing: border-box;
    transition: box-shadow 0.35s var(--ease-out-expo, ease), background 0.2s ease;
  }
  .hero-meeting-takeoff:hover {
    background: #fff;
    border-color: rgba(31, 87, 240, 0.55);
    box-shadow: 0 8px 22px -14px rgba(31, 87, 240, 0.45);
  }
  .hero-meeting-takeoff:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
  }
  .hero-meeting-takeoff svg {
    flex: none;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
    }
    .hero-stage {
      justify-content: center;
      padding-top: max(4.25rem, calc(env(safe-area-inset-top, 0px) + 3.5rem));
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    }
    .hero-brand-spacer {
      font-size: clamp(3.1rem, 11vw, 4.25rem);
    }
    .hero-promise {
      margin-top: 0.75rem;
      font-size: clamp(1.4rem, 5vw, 1.65rem);
    }
    .hero-support {
      margin-top: 0.55rem;
      font-size: 1.02rem;
    }
    .hero-widget {
      margin-top: 1.25rem;
    }
    .hero-scroll {
      bottom: max(0.65rem, calc(env(safe-area-inset-bottom, 0px) + 0.35rem));
    }
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    z-index: 12;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translate3d(-50%, 6px, 0);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.7s var(--ease-out-soft, ease),
      transform 0.7s var(--ease-out-soft, ease),
      color 0.15s ease;
  }
  .hero-scroll.is-shown {
    opacity: 0.62;
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
    animation: hero-scroll-drift 2.2s var(--ease-out-soft, ease-in-out) 0.5s infinite;
  }
  .hero-scroll.is-gone {
    opacity: 0;
    transform: translate3d(-50%, 8px, 0);
    pointer-events: none;
    animation: none;
  }
  .hero-scroll:hover {
    opacity: 0.85;
    color: var(--color-ink);
  }
  .hero-scroll:focus-visible {
    opacity: 0.9;
    color: var(--color-ink);
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
    border-radius: 999px;
  }
  @keyframes hero-scroll-drift {
    0%,
    100% {
      transform: translate3d(-50%, 0, 0);
    }
    50% {
      transform: translate3d(-50%, 5px, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll.is-shown {
      animation: none;
    }
  }
</style>

<script>
  function initTryCta() {
    const card = document.getElementById("quoter-widget");
    if (!card) return;
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        const demo = document.getElementById("demo");
        const lenis = window.__lenis;
        if (demo) {
          if (lenis?.scrollTo) lenis.scrollTo(demo, { offset: -96, duration: 1.0 });
          else demo.scrollIntoView({ behavior: "smooth", block: "center" });
        } else if (lenis?.scrollTo) {
          lenis.scrollTo(0, { duration: 1.1 });
        } else {
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
        window.setTimeout(() => {
          (window as unknown as { __quoterFocus?: () => void }).__quoterFocus?.();
        }, 550);
      });
    });
  }

  function settleWidgetLoad() {
    const shell = document.querySelector<HTMLElement>("[data-widget-shell]");
    if (!shell || shell.dataset.settleBound === "1") return;
    shell.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== shell) return;
      if (e.animationName !== "widget-rise") return;
      shell.classList.add("is-settled");
      shell.removeEventListener("animationend", done);
    };
    shell.addEventListener("animationend", done);
  }

  function settleMeetingLoad() {
    const btn = document.querySelector<HTMLElement>("[data-meeting-spacer]");
    if (!btn || btn.dataset.settleBound === "1") return;
    btn.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== btn) return;
      if (e.animationName !== "widget-rise") return;
      btn.classList.add("is-settled");
      btn.removeEventListener("animationend", done);
    };
    btn.addEventListener("animationend", done);
  }

  function initHeroScrollCue() {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (!cue || cue.dataset.bound === "1") return;
    cue.dataset.bound = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let gone = false;

    const dismiss = () => {
      if (gone) return;
      gone = true;
      cue.classList.remove("is-shown");
      cue.classList.add("is-gone");
    };

    const show = () => {
      if (gone) return;
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 24) {
        dismiss();
        return;
      }
      cue.classList.add("is-shown");
    };

    window.setTimeout(show, reduce ? 400 : 2600);

    const onScroll = () => {
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (y > 18) dismiss();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.__lenis?.on?.("scroll", onScroll);

    cue.addEventListener("click", () => {
      dismiss();
      const target =
        document.querySelector("#product") || document.querySelector("#pricing");
      if (!target) return;
      const l = window.__lenis;
      if (l?.scrollTo) l.scrollTo(target as HTMLElement, { offset: -72, duration: 1.2 });
      else (target as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  initTryCta();
  settleWidgetLoad();
  settleMeetingLoad();
  initHeroScrollCue();
  document.addEventListener("astro:after-swap", () => {
    document.querySelectorAll("[data-try]").forEach((btn) => {
      delete (btn as HTMLElement).dataset.tryBound;
    });
    initTryCta();
    settleWidgetLoad();
    settleMeetingLoad();
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (cue) delete cue.dataset.bound;
    initHeroScrollCue();
  });
</script>
