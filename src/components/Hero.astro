---
import LiveWidget from "./LiveWidget.astro";

const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 id="hero-heading" class="font-display hero-promise">
        Stop losing leads with slow quotes.
      </h1>
      <p class="hero-support">
        Give homeowners on your site an accurate instant quote from satellite
        imagery — without driving out first.
      </p>
    </div>

    <form class="hero-form" data-hero-form novalidate>
      <div class="hero-form-row">
        <label class="sr-only" for="hero-postcode">Postcode</label>
        <input
          id="hero-postcode"
          class="hero-input"
          name="postcode"
          type="text"
          inputmode="text"
          autocomplete="postal-code"
          placeholder="Enter your postcode"
          aria-describedby="hero-helper hero-form-status"
          required
        />
        <button type="submit" class="hero-submit" data-hero-submit>
          <span data-hero-submit-label>Generate a sample quote</span>
        </button>
      </div>
      <p id="hero-helper" class="hero-helper">
        Instant estimate. No payment needed. Beta.
      </p>
      <p
        id="hero-form-status"
        class="hero-status"
        data-hero-status
        role="status"
        aria-live="polite"
      ></p>
    </form>

    <div class="hero-secondary">
      <a
        href={meetingUrl}
        class="hero-book"
        data-meeting-spacer
        data-track="hero_book_call_click"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call
      </a>
    </div>

    <div class="hero-widget widget-load" id="demo" data-widget-shell>
      <div class="hero-widget-spacer" data-widget-spacer aria-hidden="true"></div>
      <LiveWidget />
    </div>

    <ul class="hero-trust" aria-label="Trust signals">
      <li>Powered by satellite imagery</li>
      <li>No payment needed</li>
      <li>Beta</li>
    </ul>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero {
    position: relative;
    z-index: 10;
    padding: 1.25rem 1.25rem 2.5rem;
  }
  @media (min-width: 640px) {
    .hero {
      padding: 1.75rem 1.5rem 3.25rem;
    }
  }

  /* 12-column grid aligned with the sticky header max width. */
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1rem;
    width: min(100%, 72rem);
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .hero-copy,
  .hero-form,
  .hero-secondary,
  .hero-widget,
  .hero-trust {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .hero-copy,
    .hero-form,
    .hero-secondary,
    .hero-trust {
      grid-column: 3 / 11;
    }
    .hero-widget {
      grid-column: 2 / 12;
    }
  }

  .hero-promise {
    margin: 0;
    max-width: 18em;
    font-size: clamp(1.85rem, 4.4vw, 2.65rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.12;
    color: var(--color-ink);
  }

  .hero-support {
    margin: 0.55rem auto 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.7vw, 1.12rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.5;
    color: #1c2430;
  }

  .hero-form {
    width: 100%;
    max-width: 40rem;
    margin-top: 1.35rem;
  }

  .hero-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
  }
  @media (min-width: 640px) {
    .hero-form-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.7rem;
    }
  }

  .hero-input {
    width: 100%;
    min-height: 3.15rem;
    padding: 0.85rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid rgba(16, 24, 40, 0.14);
    background: rgba(255, 255, 255, 0.96);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 10px 28px -18px rgba(15, 40, 100, 0.35);
  }
  .hero-input::placeholder {
    color: #5b6472;
  }
  .hero-input:focus {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow:
      0 0 0 3px rgba(47, 107, 255, 0.22),
      0 10px 28px -18px rgba(15, 40, 100, 0.35);
  }
  .hero-form.is-error .hero-input {
    border-color: #c02626;
  }
  .hero-form.is-error .hero-input:focus {
    box-shadow: 0 0 0 3px rgba(192, 38, 38, 0.2);
  }

  .hero-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.15rem;
    padding: 0.85rem 1.35rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    cursor: pointer;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 10px 22px -10px rgba(31, 87, 240, 0.55);
  }
  .hero-submit:hover:not(:disabled) {
    filter: brightness(1.04);
  }
  .hero-submit:focus-visible {
    outline: 2px solid var(--color-brand-700);
    outline-offset: 3px;
  }
  .hero-submit:disabled {
    opacity: 0.72;
    cursor: wait;
  }

  .hero-helper {
    margin: 0.65rem 0 0;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #3d4148;
  }

  .hero-status {
    margin: 0.45rem 0 0;
    min-height: 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1c2430;
  }
  .hero-form.is-error .hero-status {
    color: #b42318;
  }
  .hero-form.is-success .hero-status {
    color: #0d6b3c;
  }
  .hero-form.is-loading .hero-status {
    color: var(--color-brand-700);
  }

  .hero-secondary {
    margin-top: 0.85rem;
  }

  .hero-book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    border: 1.5px solid rgba(31, 87, 240, 0.35);
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-brand-700);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .hero-book:hover {
    background: #fff;
    border-color: rgba(31, 87, 240, 0.55);
  }
  .hero-book:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
  }

  .hero-widget {
    position: relative;
    width: 100%;
    max-width: 740px;
    margin-top: 1.5rem;
  }
  .hero-widget-spacer {
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem 0.65rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 24, 40, 0.1);
    background: rgba(255, 255, 255, 0.88);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1c2430;
  }
</style>

<script>
  import { track, logQuoteError, bindAnalytics } from "../scripts/analytics";

  const UK_POSTCODE =
    /^(GIR\s?0AA|[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2})$/i;

  function normalizePostcode(raw: string) {
    return raw.trim().replace(/\s+/g, " ").toUpperCase();
  }

  function initHeroForm() {
    const form = document.querySelector<HTMLFormElement>("[data-hero-form]");
    if (!form || form.dataset.bound === "1") return;
    form.dataset.bound = "1";
    bindAnalytics();

    const input = form.querySelector<HTMLInputElement>("#hero-postcode");
    const submit = form.querySelector<HTMLButtonElement>("[data-hero-submit]");
    const label = form.querySelector<HTMLElement>("[data-hero-submit-label]");
    const status = form.querySelector<HTMLElement>("[data-hero-status]");
    if (!input || !submit || !label || !status) return;

    const setState = (
      state: "idle" | "loading" | "success" | "error",
      message = "",
    ) => {
      form.classList.toggle("is-loading", state === "loading");
      form.classList.toggle("is-success", state === "success");
      form.classList.toggle("is-error", state === "error");
      status.textContent = message;
      submit.disabled = state === "loading";
      label.textContent =
        state === "loading" ? "Generating…" : "Generate a sample quote";
      input.setAttribute("aria-invalid", state === "error" ? "true" : "false");
    };

    const openDemo = () => {
      const focusEmbed = (window as unknown as { __quoterFocus?: () => void })
        .__quoterFocus;
      const demo = document.getElementById("demo");
      const lenis = window.__lenis;
      if (demo) {
        if (lenis?.scrollTo) lenis.scrollTo(demo, { offset: -88, duration: 0.9 });
        else demo.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      window.setTimeout(() => focusEmbed?.(), 450);
    };

    input.addEventListener("focus", () => track("hero_input_focus"));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const postcode = normalizePostcode(input.value);
      track("hero_generate_click", { postcode_len: postcode.length });

      if (!UK_POSTCODE.test(postcode)) {
        setState(
          "error",
          "Enter a valid UK postcode, for example SW1A 1AA.",
        );
        logQuoteError("invalid_postcode", { postcode });
        input.focus();
        return;
      }

      input.value = postcode;
      setState("loading", "Checking your postcode…");

      try {
        await new Promise((resolve) => window.setTimeout(resolve, 700));
        setState(
          "success",
          `Ready for ${postcode}. Continue in the quote demo below.`,
        );
        track("hero_form_success", { postcode });
        openDemo();
      } catch (err) {
        const message =
          err instanceof Error ? err.message : "Could not start the sample quote.";
        setState("error", message);
        logQuoteError("generate_failed", { message });
      }
    });

    form.querySelectorAll<HTMLElement>("[data-track]").forEach((el) => {
      el.addEventListener("click", () => {
        const name = el.dataset.track;
        if (name) track(name);
      });
    });
  }

  function initTryCta() {
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", (event) => {
        // Allow hash navigation; still scroll + focus the embed.
        const card = document.getElementById("quoter-widget");
        const input = document.querySelector<HTMLInputElement>("#hero-postcode");
        const lenis = window.__lenis;
        const demo = document.getElementById("demo");
        if (demo) {
          event.preventDefault();
          if (lenis?.scrollTo) lenis.scrollTo(demo, { offset: -88, duration: 0.9 });
          else demo.scrollIntoView({ behavior: "smooth", block: "center" });
        }
        window.setTimeout(() => {
          input?.focus({ preventScroll: true });
          (window as unknown as { __quoterFocus?: () => void }).__quoterFocus?.();
        }, 500);
        void card;
      });
    });
  }

  function initBookTracking() {
    document
      .querySelectorAll<HTMLElement>("[data-track='hero_book_call_click']")
      .forEach((el) => {
        if (el.dataset.bookBound === "1") return;
        el.dataset.bookBound = "1";
        el.addEventListener("click", () => track("hero_book_call_click"));
      });
  }

  function settleWidgetLoad() {
    const shell = document.querySelector<HTMLElement>("[data-widget-shell]");
    if (!shell || shell.dataset.settleBound === "1") return;
    shell.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== shell) return;
      shell.classList.add("is-settled");
      shell.removeEventListener("animationend", done);
    };
    shell.addEventListener("animationend", done);
  }

  initHeroForm();
  initTryCta();
  initBookTracking();
  settleWidgetLoad();
  document.addEventListener("astro:after-swap", () => {
    const form = document.querySelector<HTMLFormElement>("[data-hero-form]");
    if (form) delete form.dataset.bound;
    document.querySelectorAll("[data-try]").forEach((btn) => {
      delete (btn as HTMLElement).dataset.tryBound;
    });
    initHeroForm();
    initTryCta();
    initBookTracking();
    settleWidgetLoad();
  });
</script>
