---
import LiveWidget from "./LiveWidget.astro";

const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
---

<!--
  Single hero entry: the live Quoter embed only. No second fake postcode form.
-->
<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 id="hero-heading" class="font-display hero-promise">
        Stop losing leads with slow quotes.
      </h1>
      <p class="hero-support">
        Give homeowners on your site an accurate instant quote from satellite
        imagery — without driving out first.
      </p>
    </div>

    <div class="hero-entry" id="demo">
      <p class="hero-entry-label" id="hero-demo-label">
        Try a live sample quote
      </p>
      <div
        class="hero-widget widget-load"
        data-widget-shell
        role="region"
        aria-labelledby="hero-demo-label"
      >
        <div class="hero-widget-spacer" data-widget-spacer aria-hidden="true"></div>
        <LiveWidget />
      </div>
      <p class="hero-helper" id="hero-helper">
        Instant estimate. No payment needed. Beta.
      </p>
    </div>

    <ul class="hero-trust" aria-label="Trust signals">
      <li>Powered by satellite imagery</li>
      <li>No payment needed</li>
      <li>Beta</li>
    </ul>

    <div class="hero-secondary">
      <a
        href={meetingUrl}
        class="hero-book"
        data-meeting-spacer
        data-track="hero_book_call_click"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 10;
    padding: 0.85rem 1.25rem 2.25rem;
  }
  @media (min-width: 640px) {
    .hero {
      padding: 1.15rem 1.5rem 3rem;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1rem;
    row-gap: 0;
    width: min(100%, 72rem);
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .hero-copy,
  .hero-entry,
  .hero-secondary,
  .hero-trust {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .hero-copy,
    .hero-secondary,
    .hero-trust {
      grid-column: 3 / 11;
    }
    .hero-entry {
      grid-column: 2 / 12;
    }
  }

  .hero-promise {
    margin: 0;
    max-width: 18em;
    font-size: clamp(1.85rem, 4.4vw, 2.65rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.12;
    color: var(--color-ink);
  }

  .hero-support {
    margin: 0.5rem auto 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.7vw, 1.12rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.5;
    color: #1c2430;
  }

  .hero-entry {
    width: 100%;
    max-width: 740px;
    margin-top: 1.15rem;
  }

  .hero-entry-label {
    margin: 0 0 0.55rem;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #3d4148;
  }

  .hero-widget {
    position: relative;
    width: 100%;
  }
  .hero-widget-spacer {
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  .hero-helper {
    margin: 0.7rem 0 0;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #3d4148;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem 0.65rem;
    margin: 1.15rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 24, 40, 0.1);
    background: rgba(255, 255, 255, 0.9);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1c2430;
  }

  .hero-secondary {
    margin-top: 1rem;
  }

  .hero-book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    border: 1.5px solid rgba(31, 87, 240, 0.35);
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-brand-700);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .hero-book:hover {
    background: #fff;
    border-color: rgba(31, 87, 240, 0.55);
  }
  .hero-book:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
  }
</style>

<script>
  import { track, bindAnalytics } from "../scripts/analytics";

  function focusDemo() {
    const demo = document.getElementById("demo");
    const lenis = window.__lenis;
    if (demo) {
      if (lenis?.scrollTo) lenis.scrollTo(demo, { offset: -88, duration: 0.85 });
      else demo.scrollIntoView({ behavior: "smooth", block: "center" });
    }
    window.setTimeout(() => {
      (window as unknown as { __quoterFocus?: () => void }).__quoterFocus?.();
      track("hero_input_focus", { source: "host_focus" });
    }, 420);
  }

  function initTryCta() {
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        track("hero_generate_click", { source: "try_demo" });
        focusDemo();
      });
    });
  }

  function initBookTracking() {
    document
      .querySelectorAll<HTMLElement>("[data-track='hero_book_call_click']")
      .forEach((el) => {
        if (el.dataset.bookBound === "1") return;
        el.dataset.bookBound = "1";
        el.addEventListener("click", () => track("hero_book_call_click"));
      });
  }

  /** Mirror embed funnel stages into landing analytics (once per session). */
  function initEmbedAnalytics() {
    const w = window as unknown as {
      __heroEmbedAnalytics?: boolean;
      __heroTrackedFocus?: boolean;
      __heroTrackedExpand?: boolean;
    };
    if (w.__heroEmbedAnalytics) return;
    w.__heroEmbedAnalytics = true;

    window.addEventListener("message", (event) => {
      const data = event.data as {
        source?: string;
        mode?: string;
        stage?: string;
      } | null;
      if (!data || data.source !== "quoter-embed") return;

      if (
        !w.__heroTrackedFocus &&
        (data.mode === "suggesting" || data.stage === "input")
      ) {
        w.__heroTrackedFocus = true;
        track("hero_input_focus", {
          mode: data.mode ?? "",
          stage: data.stage ?? "",
        });
      }

      if (
        !w.__heroTrackedExpand &&
        (data.mode === "expanded" || data.mode === "overlay")
      ) {
        w.__heroTrackedExpand = true;
        track("hero_form_success", {
          mode: data.mode,
          stage: data.stage ?? "",
        });
      }
    });
  }

  function settleWidgetLoad() {
    const shell = document.querySelector<HTMLElement>("[data-widget-shell]");
    if (!shell || shell.dataset.settleBound === "1") return;
    shell.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== shell) return;
      shell.classList.add("is-settled");
      shell.removeEventListener("animationend", done);
    };
    shell.addEventListener("animationend", done);
  }

  bindAnalytics();
  initTryCta();
  initBookTracking();
  initEmbedAnalytics();
  settleWidgetLoad();
  document.addEventListener("astro:after-swap", () => {
    document.querySelectorAll("[data-try]").forEach((btn) => {
      delete (btn as HTMLElement).dataset.tryBound;
    });
    initTryCta();
    initBookTracking();
    settleWidgetLoad();
  });
</script>
