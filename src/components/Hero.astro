---
import LiveWidget from "./LiveWidget.astro";
import RoofStory from "./RoofStory.astro";

---

<!--
  Left-aligned hero. The wordmark opens large and flies up into the nav on
  scroll — Nav.astro owns the visible flying mark, everything here marked
  data-brand-spacer / data-widget-spacer is layout-only
  and gets handed off to it (see brand-dock.ts).

  Structure: one rail on the left — brand, promise, sub-line, then the live
  widget — with the roof scan beside it as support. Everything in the rail
  shares a left edge and reads top to bottom. The brand and the widget used to
  live outside that column (above and below the grid), which is what made the
  hero read as four loose objects arranged around a card.

  The roof scan is the proof: it traces the outline and reads the roof back as
  facts, which explains the product faster than the paragraph does. It is
  deliberately the smaller of the two — it narrates, the widget does.

  ⚠️ The rail must stay WIDER THAN 640px. The embed picks its mobile layout
  from its own width, so a narrower rail makes it request the fullscreen
  overlay on desktop — the flap that a fractional column caused before. The
  rail is a fixed 680px for exactly this reason: a fraction silently drops
  under the threshold at some viewport, a fixed width cannot.
-->
<section class="hero relative flex min-h-[100svh] flex-col">
  <div class="hero-stage relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-5 sm:px-6">
    <div class="hero-grid">
      <!-- One rail, read top to bottom: who we are, what we fix, how you say
           it, then the control that does it. The brand and the widget used to
           sit OUTSIDE this column — the brand above the grid, the widget below
           it — which is what made the hero read as four unrelated objects
           scattered around a card. -->
      <div class="hero-copy">
        <!-- Deliberately not a heading. This is the brand mark, and its only
             content is an image with an empty alt — so as a top-level heading
             it was literally empty to a crawler, while the actual promise sat
             in a paragraph below. The promise is the heading; the brand is
             announced by the header link, so this is decorative. -->
        <div class="hero-brand" aria-hidden="true">
          <span class="hero-brand-spacer" data-brand-spacer>
            <img
              src="/belpa-wordmark.png"
              alt=""
              width="900"
              height="279"
              fetchpriority="high"
              decoding="sync"
            />
          </span>
        </div>

        <h1 class="font-display hero-promise sub-load">
          Stop losing leads with slow quotes.
        </h1>
        <!-- The lead-in names the audience, which nothing above it does: the
             wordmark is a name and the promise is a symptom ("slow quotes")
             that a builder, a plumber or a window fitter would all recognise.
             A visitor arriving from search needs to know in the first line
             whether this is for them.

             It sits inside the paragraph rather than as an eyebrow above the
             h1 on purpose — an eyebrow would add a fourth object to a rail
             that was deliberately restructured down to brand → promise →
             support → widget, and would push the widget further from the fold. -->
        <p class="hero-support sub-load sub-load-late">
          <span class="hero-support-lede">Built for UK roofers.</span> We'll give
          your customers instant, indicative quotes from satellite imagery, so you
          know which jobs are worth the visit.
        </p>

        <!-- The embed is the real widget, unmodified — the same one roofers put
             on their own sites. Its button says "Get quote" because that is what
             a homeowner is doing; it must NOT be relabelled to something like
             "try it free", which would be nonsense on a customer's site. -->
        <div class="hero-widget widget-load" data-widget-shell>
          <!-- Holds layout while #belpa-widget is position:fixed in overlay mode -->
          <div class="hero-widget-spacer" data-widget-spacer aria-hidden="true"></div>
          <LiveWidget />
        </div>
      </div>

      <div class="hero-scan sub-load sub-load-late">
        <RoofStory />
      </div>
    </div>

    <!-- Nothing sits under the widget. Two attempts have been made: an
         instruction above it ("Try it free. Put in any UK postcode…"), which
         had to shout to earn its space, and a reassurance row underneath
         ("Free to try · No sign-up · Any UK address"), which read as template
         filler — it answered objections this page doesn't create, since the
         flow asks for nothing until the very end. If the demo needs an
         invitation, it belongs inside the control (the embed's placeholder,
         scoped to the belpa-landing-demo roofer) rather than as furniture
         bolted around it. -->

  </div>

  <button
    type="button"
    class="hero-scroll"
    data-hero-scroll
    aria-label="Scroll to see what quoting costs you"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</section>

<style>
  .hero-stage {
    padding-top: max(5.5rem, calc(env(safe-area-inset-top, 0px) + 5rem));
    padding-bottom: clamp(2.5rem, 6svh, 4rem);
  }

  /* —— Brand —— */
  .hero-brand {
    /* Opens the rail, so it needs real air beneath it rather than sitting on
       the headline. It is no longer the biggest thing on screen — the promise
       is, which is the right way round for a brand nobody recognises yet.
       Kept in svh so short laptops give the space back on their own instead of
       pushing the widget out of the fold. */
    margin: 0 0 clamp(3rem, 8svh, 6rem);
    /* Zero strut so the inline-block spacer isn't sitting on a baseline with a
       descender gap under it — the line box is then exactly the logo's height. */
    line-height: 0;
  }
  /* Desktop only: drop the wordmark a little off the header so it reads as the
     top of the rail rather than something tucked under the nav. Phones keep it
     high — the fold is scarcer there and the header is shorter.

     svh, and capped, for the reason the margin below it is: on a short laptop
     this is height the widget needs more, and svh hands it back automatically
     rather than needing its own breakpoint.

     Nothing in brand-dock.ts needs touching for this. It measures the spacer's
     untransformed offsetTop and ends the flight at `from.y - dockY`, so moving
     the wordmark down lengthens the flight by exactly the same amount and the
     morph stays anchored at both ends. */
  /* Desktop only: drop the wordmark clear of the header so it reads as the top
     of the rail. Phones keep it high — scarcer fold, shorter header.

     Scaled off the height ABOVE 700px rather than a plain svh fraction. A
     fraction cannot separate these cases: 7.5svh is 60px at 800px tall and 81px
     at 1080px, so protecting a short laptop would mean barely moving it on a
     real monitor. Two media queries would do it but leave a ~50px jump at the
     breakpoint, visible as the logo hopping while a window is resized.

     Measuring from 700px makes it continuous and much steeper — ~22px on a
     short laptop, ~84px at 1080p — because on a short laptop this is height the
     widget needs to stay in the fold, and that is the whole constraint the hero
     layout is built around. */
  /* Desktop: sit the wordmark lower without moving anything else.

     .hero-brand is the FIRST child of the rail, so plain margin-top pushes the
     whole left column down — and because .hero-grid is align-items:center, the
     column then re-centres against the roof-story panel and the two visibly
     fall out of line. That is a column offset, not a logo offset.

     So the space is TRADED, not added: whatever margin-top takes, margin-bottom
     gives back. The rail's total height is unchanged, both columns stay
     aligned, and the wordmark alone moves down.

     The cost is unavoidable and worth stating: the gap between the wordmark and
     the promise shrinks by exactly what the wordmark gains above it. --brand-
     drop is capped at 2.5rem so that gap never falls below ~1rem even at its
     tightest. */
  @media (min-width: 1024px) {
    .hero-brand {
      --brand-drop: clamp(0.5rem, 3svh, 2.5rem);
      margin-top: var(--brand-drop);
      margin-bottom: calc(clamp(3rem, 8svh, 6rem) - var(--brand-drop));
    }
  }
  /* font-size is the single size knob: brand-dock.ts reads
     getComputedStyle(spacer).fontSize and drives the docked wordmark off it,
     and the img is sized in `em`. Change the size here, never on the img. */
  .hero-brand-spacer {
    position: relative;
    display: inline-block;
    font-size: clamp(2.7rem, 5vw, 4rem);
    line-height: 0;
    user-select: none;
    pointer-events: none;
    opacity: 0;
    /* ACT ONE. The wordmark opens huge and centred in the viewport, then zooms
       back to its place in the rail — and only once it lands does the rest of
       the hero arrive. Two acts, deliberately: the logo IS the event, and
       everything else is the settle.

       The big transform is measured and set from JS as --bz-*, because centring
       an element that lives in the left rail means knowing where it actually
       is. Without JS this falls through to a plain fade (see below), so the
       wordmark is never left invisible.

       Keep the animation NAMED brand-enter. brand-dock.ts boots the
       scroll-to-nav morph off animationend for exactly that name; rename it and
       the flying wordmark silently stops working. */
    transform: none;
    filter: none;
    animation: brand-fade 0.7s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      0.35s forwards;
  }
  @keyframes brand-fade {
    to {
      opacity: 1;
    }
  }

  :global(html.brand-zoom) .hero-brand-spacer {
    transform-origin: 50% 50%;
    animation: brand-enter 1.4s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      forwards;
  }

  .hero-brand-spacer img {
    display: block;
    height: 1em;
    width: auto;
  }
  /* Sheen clipped to the logo's alpha with a mask — background-clip:text only
     works on glyphs, and this is an image. */
  .hero-brand-spacer::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(91, 140, 255, 0.9) 50%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 200% 50%;
    -webkit-mask-image: url("/belpa-wordmark.png");
    mask-image: url("/belpa-wordmark.png");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: brand-sheen 9s linear 1.4s infinite;
  }
  /* Hidden only once the fixed wordmark is placed — no mid-scroll handoff */
  :global(html.is-brand-morphing) .hero-brand-spacer {
    visibility: hidden;
  }

  /* Lands on transform:none, never an identity transform — a transform left on
     the element keeps it a containing block for fixed descendants, and
     brand-dock hands this element off to a fixed flying mark. */
  @keyframes brand-enter {
    0% {
      opacity: 0;
      transform: translate3d(var(--bz-x, 0px), var(--bz-y, 0px), 0)
        scale(var(--bz-s, 3.4));
      filter: blur(16px);
    }
    14% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes brand-sheen {
    0% { background-position: 200% 50%; }
    32% { background-position: -200% 50%; }
    100% { background-position: -200% 50%; }
  }

  /* —— Copy beside proof —— */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.25rem);
    align-items: center;
    width: 100%;
  }
  /* The rail is a FIXED 680px, not a fraction.

     Two reasons. It has to clear 640px or the embed inside it switches to its
     mobile fullscreen layout (the overlay flap warned about at the top of this
     file) — a fractional column silently drops under that at some viewport and
     the bug comes back. And fixing it makes the widget's geometry deterministic,
     so the bar's alignment below is a constant rather than something that has
     to be re-derived per breakpoint.

     Splitting at 1200px rather than 1024px: 680 + gap + a usable panel does not
     fit below that, so the layout stacks instead of cramming. */
  @media (min-width: 1200px) {
    .hero-grid {
      /* Rail stays 680px so the embed never flips to mobile overlay. */
      grid-template-columns: 680px minmax(0, 1.15fr);
      column-gap: clamp(1.75rem, 2.75vw, 3rem);
      align-items: center;
    }
  }

  .hero-copy {
    text-align: left;
  }

  /* Entrance tokens — see the hero-in comment in global.css. Travel grows down
     the rail so nearer elements move further, and the copy column enters from
     the left while .hero-scan enters from the right, converging on the centre
     instead of sliding in parallel. */
  .hero-promise {
    /* Long lateral from the left — the biggest single travel in the hero, so
       the headline is the thing your eye follows in. */
    /* ACT THREE. Starts as the wordmark is finishing its descent, not after —
       overlapping by ~0.4s means no dead beat between the two acts. */
    --in-delay: 1s;
    --in-dur: 0.9s;
    --in-y: 30px;
    --in-x: -26px;
    margin: 0;
    max-width: 15em;
    font-size: clamp(1.8rem, 3.9vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.06;
    color: var(--color-ink);
  }

  .hero-support {
    /* Follows the headline on the same axis but shorter and lower, so the two
       read as one column arriving rather than two lines. */
    --in-delay: 1.08s;
    --in-dur: 0.9s;
    --in-y: 34px;
    --in-x: -20px;
    margin: 1.05rem 0 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.7vw, 1.1rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* Full ink rather than the paragraph's soft grey, and a step heavier. That
     is enough to read as a lead-in on its own — brand blue was the other
     option but the widget's button is the only blue in this rail and it should
     stay the one thing pulling the eye. */
  .hero-support-lede {
    color: var(--color-ink);
    font-weight: 650;
  }


  /* The panel is support, not a second hero. Beside the rail it takes whatever
     the grid leaves (~480px), which keeps it clearly secondary to the control
     on the left — the two used to sit at matching weight, which is why the page
     read as having two competing search bars. */
  .hero-scan {
    /* Enters from the RIGHT while the copy column enters from the left, so the
       two halves converge. Slightly longer than the copy so the proof settles
       last, under the same curve. */
    /* Swings in from the right on its own axis. rotateY is what makes this
       genuinely a different direction rather than a mirrored slide — the panel
       turns to face you as it arrives, which is also the only 3D move in the
       hero, so it reads as the proof presenting itself. */
    --in-delay: 1.12s;
    --in-dur: 1s;
    --in-y: 26px;
    --in-x: 44px;
    --in-ry: -10deg;
    --in-s: 0.965;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }
  @media (min-width: 1200px) {
    .hero-scan {
      max-width: none;
      margin-inline: 0;
      width: 100%;
      align-self: center;
    }
  }

  /* —— The widget ——
     Last item in the rail: the control you actually use, directly under the
     sentence that promises it. Everything above sets it up. */
  .hero-widget {
    position: relative;
    width: 100%;
    max-width: 740px;
    margin-top: clamp(1.85rem, 4svh, 2.9rem);
    margin-inline: auto;
  }

  /* Line the visible BAR up with the headline, not the iframe.

     The embed centres its own card inside the frame, so left-aligning the
     frame still leaves the bar floating inside it. The offset is half the
     leftover — and `min()` makes it self-correcting across both stages rather
     than two hand-written numbers: collapsed the card is 620 in a 680 frame
     (-30px), in flow it wants 700 but the frame caps it at 680, so the
     leftover is zero and the bar simply stays put as the panel opens.

     ⚠️ 620/700 mirror --quote-collapsed-width / --quote-shell-width in
     belpa-widget-frontend/app/globals.css. If those move, move these. */
  @media (min-width: 1200px) {
    .hero-widget {
      --q-frame-w: 680px;
      --q-card-w: 620px;
      margin-inline: calc(
          (min(var(--q-card-w), var(--q-frame-w)) - var(--q-frame-w)) / 2
        )
        auto;
    }
    .hero-widget:has(#belpa-widget[data-stage="flow"]) {
      --q-card-w: 700px;
    }
  }
  .hero-widget-spacer {
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  /* —— Responsive —— */
  @media (max-width: 1023px) {
    .hero-stage {
      padding-top: max(5rem, calc(env(safe-area-inset-top, 0px) + 4.75rem));
    }
  }

  @media (max-width: 640px) {
    .hero { min-height: 100svh; }
    .hero-stage {
      padding-top: max(4.5rem, calc(env(safe-area-inset-top, 0px) + 4.25rem));
      padding-bottom: max(2rem, env(safe-area-inset-bottom, 0px));
    }
    .hero-brand-spacer { font-size: clamp(2.75rem, 11vw, 3.5rem); }
    .hero-grid { gap: 1.3rem; }
    .hero-promise {
      font-size: clamp(1.75rem, 7.4vw, 2.15rem);
      line-height: 1.1;
      max-width: 13em;
    }
    .hero-support {
      margin-top: 0.8rem;
      font-size: 1rem;
      line-height: 1.5;
      max-width: 24rem;
    }
    .hero-scroll {
      bottom: max(0.65rem, calc(env(safe-area-inset-bottom, 0px) + 0.35rem));
    }
  }

  /* Short laptops: keep the whole stack inside the fold. */
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero-stage {
      padding-top: 5rem;
      padding-bottom: 1.75rem;
    }
    .hero-brand-spacer { font-size: clamp(2.6rem, 4.9vw, 3.6rem); }
    .hero-promise { font-size: clamp(1.65rem, 3vw, 2.2rem); }
  }

  /* Keep the roof-story scan on phones. It used to hide under
     (max-width: 640px) and (max-height: 780px), which is why DevTools
     "mobile" (tall desktop window) still showed it while real handsets did
     not. On narrow viewports it stacks under the widget in the single-column
     grid — same reading order as a narrowed desktop window. */
  @media (max-width: 640px) {
    .hero-scan {
      display: block;
      max-width: 100%;
      margin-top: 0.35rem;
    }
    /* Recover a little fold height now that the scan stays. */
    .hero-brand {
      margin-bottom: clamp(1.75rem, 5svh, 3rem);
    }
  }

  /* —— Scroll cue —— */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    z-index: 12;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translate3d(-50%, 6px, 0);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.7s var(--ease-out-soft, ease),
      transform 0.7s var(--ease-out-soft, ease),
      color 0.15s ease;
  }
  .hero-scroll.is-shown {
    opacity: 0.62;
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
    animation: hero-scroll-drift 2.2s var(--ease-out-soft, ease-in-out) 0.5s infinite;
  }
  .hero-scroll.is-gone {
    opacity: 0;
    transform: translate3d(-50%, 8px, 0);
    pointer-events: none;
    animation: none;
  }
  .hero-scroll:hover { opacity: 0.85; color: var(--color-ink); }
  .hero-scroll:focus-visible {
    opacity: 0.9;
    color: var(--color-ink);
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .hero-scroll svg { width: 24px; height: 24px; }

  @keyframes hero-scroll-drift {
    0%, 100% { transform: translate3d(-50%, 0, 0); }
    50% { transform: translate3d(-50%, 5px, 0); }
  }

  @media (max-height: 700px) {
    .hero-scroll { bottom: 0.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brand-spacer {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-brand-spacer::after { content: none; animation: none; }
    .hero-scroll.is-shown { animation: none; }
  }
</style>

<script>
  function initTryCta() {
    const card = document.getElementById("belpa-widget");
    if (!card) return;
    document.querySelectorAll("[data-try]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.tryBound === "1") return;
      (btn as HTMLElement).dataset.tryBound = "1";
      btn.addEventListener("click", () => {
        // Always return to the top search
        window.scrollTo({ top: 0, behavior: "smooth" });
        // The search input lives inside the widget iframe now — focus it
        // across the frame boundary via the host bridge.
        const focusEmbed = (window as unknown as { __belpaFocus?: () => void })
          .__belpaFocus;
        const input = card.querySelector("[data-input]") as HTMLInputElement | null;
        window.setTimeout(() => {
          if (focusEmbed) focusEmbed();
          else input?.focus({ preventScroll: true });
        }, 650);
      });
    });
  }

  // Freeze the rise at its end state so the compositor doesn't snap when
  // keyframes finish.
  function settleLoad(selector: string) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el || el.dataset.settleBound === "1") return;
    el.dataset.settleBound = "1";
    const done = (e: AnimationEvent) => {
      if (e.target !== el) return;
      if (e.animationName !== "widget-rise") return;
      el.classList.add("is-settled");
      el.removeEventListener("animationend", done);
    };
    el.addEventListener("animationend", done);
  }

  function initHeroScrollCue() {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (!cue || cue.dataset.bound === "1") return;
    cue.dataset.bound = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let gone = false;

    const dismiss = () => {
      if (gone) return;
      gone = true;
      cue.classList.remove("is-shown");
      cue.classList.add("is-gone");
    };

    const show = () => {
      if (gone) return;
      // Already scrolled (e.g. restored) — never flash the cue
      const y = window.scrollY;
      if (y > 24) {
        dismiss();
        return;
      }
      cue.classList.add("is-shown");
    };

    window.setTimeout(show, reduce ? 400 : 2600);

    const onScroll = () => {
      const y = window.scrollY;
      if (y > 18) dismiss();
    };
    window.addEventListener("scroll", onScroll, { passive: true });

    cue.addEventListener("click", () => {
      dismiss();
      const target = document.querySelector("#numbers") || document.querySelector("#how");
      if (!target) return;
      (target as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function boot() {
    initTryCta();
    settleLoad("[data-widget-shell]");
    initHeroScrollCue();
  }

  boot();
  document.addEventListener("astro:after-swap", () => {
    const cue = document.querySelector<HTMLElement>("[data-hero-scroll]");
    if (cue) delete cue.dataset.bound;
    boot();
  });
</script>


<script>
  /**
   * Act one: place the wordmark huge and centred, so the CSS can zoom it back.
   *
   * Measured rather than guessed. The wordmark lives in the left rail, so
   * centring it means knowing where it actually is — a viewport-unit
   * approximation would drift with every breakpoint and land the zoom off its
   * own resting place, which is the one thing this animation cannot get wrong.
   *
   * Runs before the fallback fade's 0.35s delay, so in practice the plain fade
   * never starts. If this never runs at all, that fade is what plays and the
   * wordmark still arrives — it simply does not zoom.
   */
  function initBrandZoom() {
    const root = document.documentElement;
    if (root.classList.contains("brand-zoom")) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const spacer = document.querySelector<HTMLElement>("[data-brand-spacer]");
    if (!spacer) return;

    const r = spacer.getBoundingClientRect();
    if (r.width < 1) return;

    // How wide the wordmark should be at its largest, as a share of the
    // viewport. Clamped so it is imposing on a laptop without becoming a
    // billboard on a 5K display.
    const target = Math.min(window.innerWidth * 0.54, 880);
    const scale = Math.max(2, Math.min(target / r.width, 5));

    spacer.style.setProperty(
      "--bz-x",
      `${window.innerWidth / 2 - (r.left + r.width / 2)}px`,
    );
    spacer.style.setProperty(
      "--bz-y",
      `${window.innerHeight / 2 - (r.top + r.height / 2)}px`,
    );
    spacer.style.setProperty("--bz-s", String(scale));

    root.classList.add("brand-zoom");
  }

  initBrandZoom();
  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.remove("brand-zoom");
    initBrandZoom();
  });
</script>
