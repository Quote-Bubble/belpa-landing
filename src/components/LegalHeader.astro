---
/**
 * Top chrome for /terms and /privacy — keeps Belpa branded and gives a clear
 * way home, plus a cross-link to the other legal page (feedback: logo top-right,
 * Privacy/Terms handy without scrolling to the footer).
 */
interface Props {
  /** Path of the sibling policy to surface on the right. */
  otherHref: "/terms" | "/privacy";
  otherLabel: string;
}

const { otherHref, otherLabel } = Astro.props;
---

<div class="legal-header">
  <a href="/" class="legal-back">&larr; Back to Belpa</a>
  <div class="legal-header-right">
    <a href={otherHref} class="legal-sibling">{otherLabel}</a>
    <a href="/" class="legal-logo" aria-label="Belpa home">
      <img
        src="/belpa-wordmark.png"
        alt="Belpa"
        width="900"
        height="279"
      />
    </a>
  </div>
</div>

<style>
  .legal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .legal-back {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-brand-600, #2f6bff);
    text-decoration: none;
    flex-shrink: 0;
  }
  .legal-back:hover {
    text-decoration: underline;
  }

  .legal-header-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .legal-sibling {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-soft, #3a3f4a);
    text-decoration: none;
    white-space: nowrap;
  }
  .legal-sibling:hover {
    color: var(--color-brand-600, #2f6bff);
    text-decoration: underline;
  }

  .legal-logo {
    display: block;
    flex-shrink: 0;
    line-height: 0;
  }
  .legal-logo img {
    height: 22px;
    width: auto;
    display: block;
  }

  @media (min-width: 640px) {
    .legal-logo img {
      height: 26px;
    }
  }
</style>
