---
/**
 * Legal page chrome. Hierarchy is deliberate:
 *   1. Brand mark (home) — only strong identity in the chrome
 *   2. Sibling policy — quiet utility, never competes with the mark
 *   3. Hairline — separates navigation from the document
 * Title and body live below this; they own the page.
 */
interface Props {
  otherHref: "/terms" | "/privacy";
  otherLabel: string;
}

const { otherHref, otherLabel } = Astro.props;
---

<header class="legal-chrome">
  <div class="legal-chrome-row">
    <a href={otherHref} class="legal-sibling">{otherLabel}</a>
    <a href="/" class="legal-mark" aria-label="Belpa home">
      <img
        src="/belpa-wordmark.png"
        alt="Belpa"
        width="900"
        height="279"
      />
    </a>
  </div>
  <div class="legal-rule" aria-hidden="true"></div>
</header>

<style>
  .legal-chrome {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .legal-chrome-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  /* Secondary only — muted, small, no brand colour until hover. */
  .legal-sibling {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .legal-sibling:hover {
    color: var(--color-ink);
  }
  .legal-sibling:focus-visible {
    outline: 2px solid var(--color-brand-400);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Primary chrome identity. Click = home. */
  .legal-mark {
    display: block;
    flex-shrink: 0;
    line-height: 0;
    opacity: 0.92;
    transition: opacity 160ms ease;
  }
  .legal-mark:hover {
    opacity: 1;
  }
  .legal-mark:focus-visible {
    outline: 2px solid var(--color-brand-400);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .legal-mark img {
    display: block;
    height: 20px;
    width: auto;
  }

  .legal-rule {
    height: 1px;
    background: var(--color-line);
  }

  @media (min-width: 640px) {
    .legal-chrome {
      gap: 1.35rem;
    }
    .legal-mark img {
      height: 24px;
    }
  }
</style>
