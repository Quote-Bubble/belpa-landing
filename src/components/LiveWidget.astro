---
// The real, working Belpa widget — embedded via iframe from
// belpa-widget-frontend. Replaces the former in-page mock.
//
// The widget has exactly two on-screen sizes: a fixed collapsed search bar
// and a fixed expanded panel. The iframe is ALWAYS absolutely positioned over
// a reserved, constant-height slot, so no size change the widget makes ever
// moves anything on the host page. The panel simply overlays downward, like a
// dropdown. This is what killed the whole class of layout bugs (the Book-a-call
// gap, the hero jump, the morph recomputes) that the old dynamic-resize iframe
// caused.
//
//   embed -> host : { source:"belpa-embed", mode, height, stage }
//   host  -> embed: { source:"belpa-host", action:"focus" | "close" }
//
// mode is one of: collapsed | suggesting | expanded | overlay. `stage` is
// mirrored onto #belpa-widget so existing selectors keep working.
//
// On desktop `expanded` is presented as a CENTRED MODAL over a blurred page,
// not as a panel growing downward — see the modal block in the styles below.
// That is this host's presentation choice only: the embed still reports plain
// `expanded`, and the roofer loader (widget.js, serving /w/[slug]) still grows
// it in place. `action:"close"` exists because the close control belongs to
// the modal chrome out here while the flow state belongs to the widget.
// ⚠️ COUPLED WITH vercel.json — the CSP `frame-src` there MUST list this exact
// origin or the browser silently blocks this iframe (no error on the page, only
// a CSP violation in the console). If you ever move the widget to a new URL
// (e.g. a custom domain), change it in BOTH places. vercel.json can't read an
// env var, so this stays a manual, hand-kept pair.
// In `astro dev` this points at a locally-running belpa-widget-frontend so
// widget changes are actually visible here. Without this the DEV site embeds
// PRODUCTION, and local widget work appears to do nothing at all.
// Override with PUBLIC_BELPA_EMBED_ORIGIN; builds always use the live origin
// (which is the one vercel.json's frame-src allows).
const EMBED_ORIGIN =
  import.meta.env.PUBLIC_BELPA_EMBED_ORIGIN ??
  (import.meta.env.DEV
    ? "http://localhost:3000"
    : "https://widget.belpa.co.uk");
const EMBED_SRC = `${EMBED_ORIGIN}/embed?roofer=belpa-landing-demo`;

// Keep in sync with QUOTE_SIZES in the widget repo (lib/motion.ts).
const COLLAPSED_H = 120;
const COLLAPSED_H_MOBILE = 82;
---

<div class="q" id="belpa-widget" data-stage="input" data-mode="collapsed">
  <iframe
    data-belpa-frame
    src={EMBED_SRC}
    title="Get an instant, free roof quote"
    loading="eager"
    scrolling="no"
    sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
  ></iframe>
</div>

<!-- Desktop modal chrome. Inert and invisible until the flow opens; both live
     outside .q so they aren't inside the frame's stacking/paint context. -->
<div class="q-backdrop" data-q-backdrop hidden></div>
<div class="q-modal-chrome" data-q-chrome hidden>
  <!-- Matches the modal's box so the close control can sit on its corner
       without hard-coding a position. Only the button takes pointer events —
       the rest of this layer must let backdrop clicks through. -->
  <div class="q-modal-box">
    <button type="button" class="q-close" data-q-close aria-label="Close quote">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<style define:vars={{ collapsedH: `${COLLAPSED_H}px`, collapsedHMobile: `${COLLAPSED_H_MOBILE}px` }}>
  /* Reserved slot: a fixed height that never changes, so surrounding
     elements (Book a call, the scroll cue) never move. */
  .q {
    position: relative;
    width: 100%;
    height: var(--collapsedH);
  }
  /* The iframe is ALWAYS absolute over the slot, so growing it (suggestions,
     panel) overlays the page instead of pushing it. */
  .q iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--collapsedH);
    border: 0;
    background: transparent;
    /* Matches the widget's internal SHELL_TRANSITION (320ms, ease-soft) so
       the iframe and the card inside it grow/shrink in lockstep. */
    transition: height 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (max-width: 640px) {
    .q {
      height: var(--collapsedHMobile);
    }
    .q iframe {
      height: var(--collapsedHMobile);
    }
  }
  /* Suggestions dropdown / expanded panel float above the content below. */
  .q[data-mode="suggesting"] iframe,
  .q[data-mode="expanded"] iframe {
    z-index: 60;
  }
  /* —— Desktop modal ——
     The flow opens centred over a blurred page rather than growing downward
     in place. The frame is the same iframe, just re-positioned, so none of the
     embed's own layout changes — which matters, because its layout is chosen
     from its own width and dropping under 640px would flip it to the mobile
     overlay. The clamp floor keeps it above that on narrow desktops. */
  .q-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(9, 18, 40, 0.42);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out-soft, ease);
  }
  :global(html.belpa-modal) .q-backdrop {
    opacity: 1;
  }

  :global(html.belpa-modal) .q iframe {
    position: fixed;
    top: 50%;
    left: 50%;
    width: clamp(640px, calc(100vw - 2rem), 700px);
    z-index: 2001;
    transform: translate(-50%, -50%) scale(0.96);
    opacity: 0;
    transition:
      transform 0.34s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      opacity 0.24s ease,
      height 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Second class, set a frame later, so the browser has a start state to
     animate FROM — toggling both at once would paint the end state directly. */
  :global(html.belpa-modal-in) .q iframe {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }

  .q-modal-chrome {
    position: fixed;
    inset: 0;
    z-index: 2002;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Clicks must reach the backdrop underneath; only the button opts back in. */
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.24s ease 0.08s;
  }
  :global(html.belpa-modal-in) .q-modal-chrome {
    opacity: 1;
  }
  .q-modal-box {
    position: relative;
    width: clamp(640px, calc(100vw - 2rem), 700px);
    height: var(--q-modal-h, 574px);
  }
  .q-close {
    position: absolute;
    top: -14px;
    right: -14px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(16, 24, 40, 0.08);
    border-radius: 999px;
    background: #ffffff;
    color: var(--color-ink);
    cursor: pointer;
    pointer-events: auto;
    box-shadow:
      0 2px 8px rgba(16, 24, 40, 0.12),
      0 12px 28px -12px rgba(23, 60, 160, 0.5);
    transition:
      transform 0.18s var(--ease-out-soft, ease),
      color 0.15s ease;
  }
  .q-close:hover {
    transform: scale(1.06);
    color: var(--color-brand-600);
  }
  .q-close:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .q-backdrop,
    .q-modal-chrome,
    :global(html.belpa-modal) .q iframe {
      transition: none;
    }
  }

  /* While the page is scrolling, let the wheel through to the document.
     Lenis drives the scroll by listening for `wheel` on the parent, but a
     cross-origin iframe consumes wheel events entirely — nothing bubbles out.
     So the moment the widget passed under the cursor mid-scroll, Lenis stopped
     receiving input and its glide stalled, which reads as the scroll snagging.
     Only ever applied while collapsed and actively scrolling (see the script
     below); it's removed as soon as scrolling stops, so the widget is
     clickable at rest. */
  .q.is-page-scrolling iframe {
    pointer-events: none;
  }
  /* Mobile overlay: sized to the visual viewport in JS. CSS here is a
     fallback if JS styles haven't applied yet. */
  .q[data-mode="overlay"] iframe {
    position: fixed !important;
    inset: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    z-index: 2147483000;
    background: #ffffff;
    transition: none;
  }
</style>

<script>
  function initBelpaEmbed() {
    const holder = document.getElementById("belpa-widget");
    if (!holder || holder.dataset.embedBound === "1") return;
    holder.dataset.embedBound = "1";
    const frame = holder.querySelector(
      "[data-belpa-frame]",
    ) as HTMLIFrameElement | null;
    if (!frame) return;

    // Only trust messages that actually came from the widget's origin. The
    // `source: "belpa-embed"` marker below is just a field inside the payload
    // — any page or iframe can send that — so it identifies the protocol, it
    // does not authenticate the sender. Derived from the iframe's own src so
    // it stays correct if the embed moves.
    let embedOrigin: string | null = null;
    try {
      embedOrigin = new URL(frame.src, window.location.href).origin;
    } catch {
      return; // unparseable src — don't listen at all rather than listen to everyone
    }

    // Expanded iframe height — fallback synced with QUOTE_SIZES.expanded
    // (expandedPanel 544 + shadow room). Prefer the live height EmbedFrame
    // posts so host layout stays correct if the widget changes sizes.
    let panelH = 574;
    const desktopMq = window.matchMedia("(min-width: 640px)");

    // .page-lower padding is reset on close; nothing sets it any more now the
    // desktop flow is a centred modal rather than a panel growing into the page.
    const lower = document.querySelector<HTMLElement>(".page-lower");
    function resetLowerSections() {
      if (lower) lower.style.paddingTop = "";
    }

// iOS-safe fullscreen. A transformed hero ancestor (.widget-load) traps
    // position:fixed so the iframe only covers the search slot — then the
    // locked backdrop shows the satellite section under the flow. We break
    // that containing block via CSS, size the iframe to the visual viewport
    // in place (no reparent — moving iframes can reload on some browsers),
    // pin scroll to the top, and hide below-fold host copy.
    let restoreY = 0;
    let scrollLocked = false;
    let overlayMounted = false;
    // Keeps the iframe fullscreen while the widget's close fade plays, so the
    // exiting flow is never clipped back to the collapsed slot mid-fade.
    let overlayCloseTimer = 0;
    // Must match the widget overlay's exit transition (QuoteBubble ~0.26s).
    const OVERLAY_EXIT_MS = 300;

    function applyOverlayFrameStyles() {
      // Size to the LAYOUT viewport, not the visual viewport. iOS shrinks the
      // visual viewport when the software keyboard opens; sizing the iframe to
      // it made the whole flow squeeze/reflow and shoved the Continue button up
      // as the keyboard appeared. window.innerHeight stays constant across the
      // keyboard on iOS, so the sheet keeps its full height and the keyboard
      // simply OVERLAYS it — the widget scrolls the focused field into view.
      frame.style.position = "fixed";
      frame.style.top = "0";
      frame.style.left = "0";
      frame.style.right = "auto";
      frame.style.bottom = "auto";
      frame.style.width = `${window.innerWidth}px`;
      frame.style.height = `${window.innerHeight}px`;
      frame.style.zIndex = "2147483000";
      frame.style.background = "#ffffff";
      frame.style.border = "0";
      frame.style.transition = "none";
      frame.style.margin = "0";
      frame.style.maxWidth = "none";
      frame.style.maxHeight = "none";
    }

    // Re-size only on real viewport changes (orientation / URL-bar), NOT on the
    // keyboard — that's the whole point of using the layout viewport above.
    function onViewportChange() {
      if (overlayMounted) applyOverlayFrameStyles();
    }

    function mountOverlayFrame() {
      // Re-opened before a pending close finished — cancel the shrink.
      if (overlayCloseTimer) {
        window.clearTimeout(overlayCloseTimer);
        overlayCloseTimer = 0;
      }
      if (overlayMounted) {
        applyOverlayFrameStyles();
        return;
      }
      overlayMounted = true;
      restoreY = window.scrollY || window.pageYOffset || 0;
      const lenis = (window as unknown as {
        __lenis?: {
          stop?: () => void;
          scrollTo?: (t: number, o?: unknown) => void;
        };
      }).__lenis;
      // Pin to top before locking so the frozen backdrop is the hero, not
      // satellite copy that a desktop scroll-nudge may have revealed.
      if (lenis?.scrollTo) lenis.scrollTo(0, { immediate: true, force: true });
      else window.scrollTo(0, 0);
      lenis?.stop?.();

      applyOverlayFrameStyles();
      window.addEventListener("resize", onViewportChange);
      window.addEventListener("orientationchange", onViewportChange);

      scrollLocked = true;
      document.documentElement.classList.add("belpa-overlay-open");
      document.body.style.position = "fixed";
      document.body.style.top = "0";
      document.body.style.left = "0";
      document.body.style.right = "0";
      document.body.style.width = "100%";
      document.body.style.overflow = "hidden";
    }

    function unmountOverlayFrame() {
      if (!overlayMounted && !scrollLocked) return;
      overlayMounted = false;
      window.removeEventListener("resize", onViewportChange);
      window.removeEventListener("orientationchange", onViewportChange);

      frame.style.position = "";
      frame.style.top = "";
      frame.style.left = "";
      frame.style.right = "";
      frame.style.bottom = "";
      frame.style.width = "";
      frame.style.height = "";
      frame.style.zIndex = "";
      frame.style.background = "";
      frame.style.border = "";
      frame.style.transition = "";
      frame.style.margin = "";
      frame.style.maxWidth = "";
      frame.style.maxHeight = "";

      scrollLocked = false;
      document.documentElement.classList.remove("belpa-overlay-open");
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.left = "";
      document.body.style.right = "";
      document.body.style.width = "";
      document.body.style.overflow = "";
      const lenis = (window as unknown as {
        __lenis?: { start?: () => void };
      }).__lenis;
      lenis?.start?.();
      window.scrollTo(0, restoreY);
    }

    window.addEventListener("message", (e: MessageEvent) => {
      if (e.origin !== embedOrigin) return;
      const d = e.data;
      if (!d || d.source !== "belpa-embed") return;

      // The embed picks overlay-vs-panel from ITS OWN width, but inside a hero
      // column that width is ~581px — under the widget's 640px mobile
      // breakpoint. So on a desktop page the embed asks for the fullscreen
      // mobile overlay; mounting it makes the iframe window-wide, the embed
      // re-reads itself as desktop and asks for `expanded`, we shrink it back
      // to 581px, and it asks for overlay again. That flapped ~15 times per
      // submit and re-ran the postcode lookup every cycle (16 duplicate
      // /api/geocode calls), which is what made the live site look broken.
      //
      // Only the HOST knows the real device context — the embed can only ever
      // measure its own box — so the host wins: on a desktop viewport an
      // overlay request is served as the expanded panel.
      const rawMode = typeof d.mode === "string" ? d.mode : "collapsed";
      const coercedFromOverlay = rawMode === "overlay" && desktopMq.matches;
      const mode = coercedFromOverlay ? "expanded" : rawMode;
      const hRaw = typeof d.height === "number" && d.height > 0 ? d.height : 0;
      // An overlay-mode height is the device viewport, not the panel, so it
      // must never drive desktop layout — use the known panel height instead.
      const h = coercedFromOverlay ? panelH : hRaw;
      const wasOverlay = holder.dataset.mode === "overlay";

      // Mirror stage + mode so host CSS/selectors keep working.
      if (typeof d.stage === "string") holder.dataset.stage = d.stage;
      holder.dataset.mode = mode;

      // Prefer the height EmbedFrame reports for expanded layout math.
      if (mode === "expanded" && h) panelH = h;

      // Hide Book-a-call whenever the widget isn't a plain collapsed bar:
      //  - expanded / overlay (flow open): the panel covers that area anyway.
      //  - suggesting: the dropdown floats over it.
      // Both toggles map to the same global.css rules that hide the button
      // and its nav flying-clone.
      document.documentElement.classList.toggle(
        "belpa-flow-open",
        mode === "expanded" || mode === "overlay",
      );
      document.documentElement.classList.toggle(
        "belpa-suggesting",
        mode === "suggesting",
      );
      // Marks the expanded state for host CSS (panel elevation).
      document.documentElement.classList.toggle(
        "belpa-expanded",
        mode === "expanded",
      );

      if (mode === "overlay") {
        resetLowerSections();
        mountOverlayFrame();
      } else if (wasOverlay) {
        // Closing the mobile flow: hold the iframe fullscreen while the
        // widget's overlay fades out, THEN shrink + unlock in one step so the
        // exiting flow is never clipped back to the collapsed slot. Do NOT set
        // the collapsed height now — that would shrink the frame immediately.
        if (overlayCloseTimer) window.clearTimeout(overlayCloseTimer);
        overlayCloseTimer = window.setTimeout(() => {
          overlayCloseTimer = 0;
          if (holder.dataset.mode !== "overlay") unmountOverlayFrame();
        }, OVERLAY_EXIT_MS);
      } else {
        if (h) frame.style.height = `${h}px`;
      }

      if (mode === "expanded" && desktopMq.matches) {
        enterModal();
        // The panel is centred over the page now instead of growing downward
        // into it, so there is nothing below to make room for. Both the
        // push-down and the scroll-into-view existed only for the inline
        // panel and would now fight the modal.
        resetLowerSections();
      } else {
        exitModal();
        if (mode !== "overlay") resetLowerSections();
      }
    });

    // —— Desktop modal ——

    const backdrop = document.querySelector<HTMLElement>("[data-q-backdrop]");
    const chrome = document.querySelector<HTMLElement>("[data-q-chrome]");
    const closeBtn = document.querySelector<HTMLElement>("[data-q-close]");
    let closeFallback = 0;
    let modalOpen = false;

    function enterModal() {
      if (modalOpen) return;
      modalOpen = true;
      // Sizes the invisible box the close button hangs off, so the control
      // tracks the panel's real height rather than a hard-coded one.
      document.documentElement.style.setProperty("--q-modal-h", `${panelH}px`);
      backdrop?.removeAttribute("hidden");
      chrome?.removeAttribute("hidden");
      document.documentElement.classList.add("belpa-modal");
      // Lenis owns the scroll; CSS overflow alone wouldn't stop it.
      window.__lenis?.stop?.();
      // Next frame, so the transition has a start state to run from.
      requestAnimationFrame(() =>
        requestAnimationFrame(() =>
          document.documentElement.classList.add("belpa-modal-in"),
        ),
      );
    }

    function exitModal() {
      if (!modalOpen) return;
      modalOpen = false;
      window.clearTimeout(closeFallback);
      document.documentElement.classList.remove("belpa-modal-in");
      window.__lenis?.start?.();
      // Let it fade before the frame snaps back to the collapsed slot.
      window.setTimeout(() => {
        if (modalOpen) return;
        document.documentElement.classList.remove("belpa-modal");
        backdrop?.setAttribute("hidden", "");
        chrome?.setAttribute("hidden", "");
      }, 240);
    }

    /**
     * Ask the embed to drop the flow. The close control is ours, but the flow
     * state is the widget's, so this is a message rather than a direct call.
     *
     * The fallback is the important half: if that message is ever not acted on
     * — an older embed, a dropped frame, a script error inside it — the visitor
     * would be sealed behind a backdrop with no way out. Reloading the iframe
     * always returns it to the collapsed bar, so being stuck is not reachable.
     */
    function requestClose() {
      frame!.contentWindow?.postMessage(
        { source: "belpa-host", action: "close" },
        embedOrigin!,
      );
      window.clearTimeout(closeFallback);
      closeFallback = window.setTimeout(() => {
        if (holder!.dataset.stage !== "flow") return;
        exitModal();
        frame!.src = frame!.src;
      }, 700);
    }

    closeBtn?.addEventListener("click", requestClose);
    backdrop?.addEventListener("click", requestClose);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modalOpen) requestClose();
    });

    // Bridge for [data-try] buttons: focus the sealed input across the frame.
    (window as unknown as { __belpaFocus?: () => void }).__belpaFocus = () => {
      frame.contentWindow?.postMessage(
        { source: "belpa-host", action: "focus" },
        embedOrigin!,
      );
    };
  }
  /**
   * Keep the page scrolling when the cursor crosses the embed.
   *
   * Lenis reads `wheel` off the parent document. A cross-origin iframe eats
   * those events outright — they are delivered to the frame's own document and
   * nothing reaches us — so as soon as the widget slid under a stationary
   * cursor mid-scroll, Lenis went input-starved and its 2.1s glide stalled.
   *
   * The cursor doesn't move here; the PAGE does. So by the time the widget
   * reaches the cursor we have already seen wheel/scroll events on the parent,
   * which is what lets us pre-emptively make the frame transparent to the
   * pointer. (Detecting it any later is impossible for exactly the reason the
   * bug exists.) Pointer events come back ~200ms after scrolling stops.
   *
   * Skipped unless the widget is collapsed: with the suggestions list or the
   * panel open the user is working inside the frame and must keep the pointer.
   */
  function initScrollPassThrough() {
    const holder = document.getElementById("belpa-widget");
    if (!holder || holder.dataset.passThroughBound === "1") return;
    holder.dataset.passThroughBound = "1";

    let idle: number | undefined;
    const settle = () => holder.classList.remove("is-page-scrolling");

    const mark = () => {
      if (holder.dataset.mode !== "collapsed") {
        settle();
        return;
      }
      holder.classList.add("is-page-scrolling");
      window.clearTimeout(idle);
      idle = window.setTimeout(settle, 200);
    };

    // `scroll` covers the whole Lenis glide (it scrolls the window natively,
    // so real scroll events still fire); `wheel` catches the very first notch
    // before the page has actually moved.
    window.addEventListener("scroll", mark, { passive: true });
    window.addEventListener("wheel", mark, { passive: true });
  }

  initBelpaEmbed();
  initScrollPassThrough();
  document.addEventListener("astro:after-swap", () => {
    initBelpaEmbed();
    initScrollPassThrough();
  });
</script>
