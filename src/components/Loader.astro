---
/**
 * Load state for the landing page.
 *
 * The page is not slow to arrive — the document is served in under 200ms — but
 * it is slow to SETTLE: ~650KB of subresources, three font files, two large
 * aerials and a widget iframe, all landing at different moments. That staggered
 * assembly is what reads as lag, and it is what this covers.
 *
 * Three rules, all learned the hard way:
 *
 *   1. It must not flash. A loader that appears for 120ms on a warm cache is
 *      worse than none — it turns an instant load into a visible blink. So it
 *      stays invisible for the first 250ms and only fades in if the page is
 *      genuinely still working.
 *
 *   2. Once seen, it must not blink out. A minimum on-screen time stops it
 *      appearing and vanishing in the same breath.
 *
 *   3. It must never be the reason someone is stuck. A hard cap in the module,
 *      and a second failsafe in the inline script that put it there, so a
 *      failure to load the module cannot leave the page behind a curtain.
 *
 * It sits in the page's own background colour rather than a branded takeover,
 * so on a fast connection the transition reads as the page simply drawing.
 */
---

{/*
  Inline and synchronous so the overlay exists on the first frame. Deciding in
  a module script would let the half-assembled page show before it was covered,
  which is the exact thing being hidden.
*/}
<script is:inline>
  (() => {
    try {
      const doc = document.documentElement;
      if (sessionStorage.getItem("belpa:loaded")) return;
      sessionStorage.setItem("belpa:loaded", "1");
      doc.classList.add("ld-on");
      // Failsafe. This script created the overlay, so it owns getting rid of
      // it: if the module below never runs, nothing else will. Longer than the
      // module's own cap, so in normal operation it never fires.
      setTimeout(() => doc.classList.add("ld-done", "ld-released"), 4000);
    } catch {
      /* Private mode can throw on sessionStorage. Skip the loader. */
    }
  })();
</script>

<div class="ld" data-loader aria-hidden="true">
  <div class="ld-mark">
    {/* Two copies of the wordmark, one ghosted and one full-strength, with the
        top one revealed left to right by a clip. The brand assembling itself is
        the progress bar — there is no separate bar to design, and no asset
        beyond the logo the page already loads. */}
    <img class="ld-ghost" src="/belpa-wordmark.png" alt="" width="900" height="279" />
    <img
      class="ld-fill"
      src="/belpa-wordmark.png"
      alt=""
      width="900"
      height="279"
      data-ld-fill
    />
  </div>
</div>

<style>
  .ld {
    display: none;
  }

  :global(html.ld-on) .ld {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 9000;
    /* The page's own canvas colour, not a branded panel. On a quick load this
       reads as the page still drawing rather than as a splash screen. */
    background: var(--color-canvas, #fff);
    pointer-events: none;
    /* Invisible for the first beat. If the page is ready inside 250ms the
       visitor never sees anything at all — the overlay is removed before this
       delay elapses. */
    opacity: 0;
    animation: ld-appear 0.28s ease-out 0.25s forwards;
  }
  @keyframes ld-appear {
    to {
      opacity: 1;
    }
  }

  :global(html.ld-done) .ld {
    display: none;
  }

  :global(html.ld-leaving) .ld {
    animation: none;
    opacity: 0;
    transition: opacity 0.34s ease-in;
  }

  .ld-mark {
    position: relative;
    width: clamp(9rem, 22vw, 15rem);
    line-height: 0;
  }

  .ld-ghost,
  .ld-fill {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Ghost sits underneath at low contrast: the shape is present from the first
     frame, so the fill reads as completion rather than as arrival. */
  .ld-ghost {
    opacity: 0.12;
    filter: grayscale(1);
  }

  .ld-fill {
    position: absolute;
    inset: 0;
    /* Driven from JS. inset() rather than a width change so nothing reflows —
       the clip is a paint-only property. */
    clip-path: inset(0 100% 0 0);
    will-change: clip-path;
  }

  /* Reduced motion gets the mark at full strength and no sweep. The overlay
     still does its job of covering the assembly; it simply does not animate. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.ld-on) .ld {
      animation-duration: 0.01s;
    }
    .ld-ghost {
      opacity: 0;
    }
    .ld-fill {
      clip-path: none !important;
    }
  }
</style>

<style is:global>
  /* Hold the hero's entrance while the loader is up, or it plays to nobody and
     the page is already static by the time it is uncovered. Released the
     moment the loader starts fading, so the two overlap. */
  html.ld-on:not(.ld-released) .sub-load,
  html.ld-on:not(.ld-released) .widget-load,
  html.ld-on:not(.ld-released) .hero-brand-spacer {
    animation-play-state: paused !important;
  }
</style>

<script>
  function initLoader() {
    const root = document.documentElement;
    if (!root.classList.contains("ld-on") || root.classList.contains("ld-done")) {
      return;
    }

    const fill = document.querySelector<HTMLElement>("[data-ld-fill]");
    const shownAt = performance.now();
    // Matches the CSS appear delay. Below this the overlay was never visible,
    // so it can be torn down with no fade at all.
    const APPEAR_AT = 250;
    // Once it HAS been seen, keep it long enough that it does not blink.
    const MIN_VISIBLE = 420;

    let done = false;
    let raf = 0;

    function finish() {
      if (done) return;
      done = true;
      cancelAnimationFrame(raf);

      const elapsed = performance.now() - shownAt;
      if (elapsed < APPEAR_AT) {
        // Never rendered. Remove it outright rather than fading nothing out.
        root.classList.add("ld-done", "ld-released");
        root.classList.remove("ld-on");
        return;
      }

      const wait = Math.max(0, APPEAR_AT + MIN_VISIBLE - elapsed);
      window.setTimeout(() => {
        if (fill) fill.style.clipPath = "inset(0 0 0 0)";
        root.classList.add("ld-leaving", "ld-released");
        window.setTimeout(() => {
          root.classList.add("ld-done");
          root.classList.remove("ld-on", "ld-leaving");
        }, 360);
      }, wait);
    }

    /**
     * Progress creeps toward 92% and only completes when the page actually is.
     *
     * Deliberately not a fake fixed-duration bar: it eases so that a slow load
     * keeps moving without ever claiming to be finished, and the last 8% is
     * real. A bar that hits 100% and then waits is the thing that makes a load
     * feel broken rather than slow.
     */
    function tick() {
      const t = (performance.now() - shownAt) / 1400;
      const eased = 1 - Math.pow(1 - Math.min(1, t), 2.2);
      const pct = Math.min(92, eased * 92);
      if (fill) fill.style.clipPath = `inset(0 ${(100 - pct).toFixed(2)}% 0 0)`;
      if (!done) raf = requestAnimationFrame(tick);
    }
    raf = requestAnimationFrame(tick);

    /**
     * Ready means THE HERO is ready, not the whole document.
     *
     * window.load was the obvious signal and the wrong one: it waits for every
     * image on the page — a 189KB aerial, a 126KB scan, the widget iframe and
     * its own bundle — none of which are above the fold or block the hero from
     * looking right. Waiting for them would routinely park the loader on screen
     * for seconds after the page was perfectly usable, which is a slower site,
     * not a smoother one.
     *
     * What actually has to be true is that text will not reflow and the visible
     * imagery has decoded. Everything below the fold can keep arriving behind
     * the curtain being lifted.
     */
    // Only the wordmark. Not ".hero img" — that pulls in RoofStory's 189KB
    // aerial, which is decorative, sits in a panel that can fade in on its own,
    // and would drag the curtain out by hundreds of milliseconds on a slow
    // connection. The wordmark is different: the loader is DRAWING it, so if it
    // has not decoded the loader itself is the broken thing on screen.
    const heroImages = Array.from(
      document.querySelectorAll<HTMLImageElement>("[data-brand-spacer] img"),
    );

    const ready = Promise.all([
      document.fonts?.ready?.catch(() => undefined) ?? Promise.resolve(),
      new Promise<void>((resolve) => {
        if (document.readyState !== "loading") return resolve();
        document.addEventListener("DOMContentLoaded", () => resolve(), {
          once: true,
        });
      }),
      ...heroImages.map((img) =>
        img.decode ? img.decode().catch(() => undefined) : Promise.resolve(),
      ),
    ]);

    // Ceiling. A stalled font or a third-party script must not hold the page.
    const cap = new Promise<void>((resolve) => window.setTimeout(resolve, 2600));

    Promise.race([ready, cap]).then(finish).catch(finish);
  }

  initLoader();
</script>
