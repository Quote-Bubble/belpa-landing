---
const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
const dashboardUrl =
  import.meta.env.PUBLIC_DASHBOARD_URL ??
  "https://quoter-dashboard-frontend.vercel.app";

const links = [
  { href: "#product", label: "Product" },
  { href: "#pricing", label: "Pricing" },
  { href: "/privacy", label: "Docs" },
  { href: "#contact", label: "Contact" },
] as const;
---

<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a href="/" class="site-logo" aria-label="Quoter home">Quoter</a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="site-nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header-actions">
      <a
        href={dashboardUrl}
        class="site-header-login"
        aria-label="Log in to your dashboard"
      >
        Log in
      </a>
      <a
        href={meetingUrl}
        class="site-header-book"
        data-track="nav_book_call_click"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call
      </a>
      <a href="#demo" class="site-header-demo" data-try data-track="nav_try_demo_click">
        Get instant estimate
      </a>
      <button
        type="button"
        class="site-header-menu"
        data-nav-menu
        aria-expanded="false"
        aria-controls="site-mobile-panel"
        aria-label="Open menu"
      >
        <span class="site-header-menu-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div
    id="site-mobile-panel"
    class="site-mobile-panel"
    data-nav-panel
    hidden
  >
    <nav aria-label="Mobile">
      <ul class="site-mobile-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="site-mobile-link" data-nav-close>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-mobile-actions">
      <a
        href={meetingUrl}
        class="site-mobile-book"
        data-track="nav_book_call_click"
        data-nav-close
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call
      </a>
      <a
        href="#demo"
        class="site-mobile-demo"
        data-try
        data-track="nav_try_demo_click"
        data-nav-close
      >
        Get instant estimate
      </a>
      <a href={dashboardUrl} class="site-mobile-login" data-nav-close>
        Log in
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    width: 100%;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    border-bottom: 1px solid transparent;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.94);
    border-bottom-color: rgba(16, 24, 40, 0.08);
    box-shadow: 0 8px 28px -20px rgba(15, 40, 100, 0.35);
  }

  .site-header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: 0.85rem 1.25rem;
    padding-top: max(0.85rem, env(safe-area-inset-top, 0px));
  }
  @media (min-width: 1024px) {
    .site-header-inner {
      padding-inline: 1.5rem;
    }
  }

  .site-logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
  }
  .site-logo:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .site-nav {
    display: none;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .site-nav {
      display: flex;
    }
  }
  .site-nav-list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav-link {
    display: inline-flex;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #1c2430;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .site-nav-link:hover {
    background: rgba(47, 107, 255, 0.08);
    color: var(--color-brand-700);
  }
  .site-nav-link:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
  }

  .site-header-login {
    display: none;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1c2430;
    text-decoration: none;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;
  }
  .site-header-login:hover {
    color: var(--color-brand-700);
  }
  .site-header-login:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  @media (min-width: 900px) {
    .site-header-login {
      display: inline-flex;
    }
  }

  .site-header-book {
    display: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-brand-700);
    text-decoration: none;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
  }
  .site-header-book:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site-header-book:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  @media (min-width: 640px) {
    .site-header-book {
      display: inline-flex;
    }
  }

  .site-header-demo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.62rem 1.05rem;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 18px -8px rgba(31, 87, 240, 0.55);
  }
  .site-header-demo:hover {
    filter: brightness(1.05);
  }
  .site-header-demo:focus-visible {
    outline: 2px solid var(--color-brand-700);
    outline-offset: 3px;
  }

  .site-header-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(16, 24, 40, 0.12);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    cursor: pointer;
  }
  .site-header-menu:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .site-header-menu-bars,
  .site-header-menu-bars::before,
  .site-header-menu-bars::after {
    display: block;
    width: 1rem;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }
  .site-header-menu-bars {
    position: relative;
  }
  .site-header-menu-bars::before,
  .site-header-menu-bars::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .site-header-menu-bars::before {
    top: -5px;
  }
  .site-header-menu-bars::after {
    top: 5px;
  }
  @media (min-width: 900px) {
    .site-header-menu {
      display: none;
    }
  }

  .site-mobile-panel {
    border-top: 1px solid rgba(16, 24, 40, 0.08);
    background: rgba(255, 255, 255, 0.98);
    padding: 0.75rem 1.25rem 1.15rem;
  }
  .site-mobile-panel[hidden] {
    display: none;
  }
  @media (min-width: 900px) {
    .site-mobile-panel {
      display: none !important;
    }
  }
  .site-mobile-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-mobile-link {
    display: block;
    padding: 0.85rem 0.15rem;
    border-bottom: 1px solid rgba(16, 24, 40, 0.06);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .site-mobile-link:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .site-mobile-actions {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
  }
  .site-mobile-book,
  .site-mobile-demo,
  .site-mobile-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .site-mobile-book {
    border: 1.5px solid rgba(31, 87, 240, 0.35);
    color: var(--color-brand-700);
    background: #fff;
  }
  .site-mobile-demo {
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
  }
  .site-mobile-login {
    color: #1c2430;
  }
  .site-mobile-book:focus-visible,
  .site-mobile-demo:focus-visible,
  .site-mobile-login:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
  }
</style>

<script>
  import { track, bindAnalytics } from "../scripts/analytics";

  function initSiteHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header || header.dataset.bound === "1") return;
    header.dataset.bound = "1";

    bindAnalytics();

    const onScroll = () => {
      const y = window.__lenis?.scroll ?? window.scrollY;
      header.classList.toggle("is-scrolled", y > 8);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.__lenis?.on?.("scroll", onScroll);

    const menu = header.querySelector<HTMLButtonElement>("[data-nav-menu]");
    const panel = header.querySelector<HTMLElement>("[data-nav-panel]");
    const setOpen = (open: boolean) => {
      if (!menu || !panel) return;
      menu.setAttribute("aria-expanded", open ? "true" : "false");
      menu.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
    };
    menu?.addEventListener("click", () => {
      const open = menu.getAttribute("aria-expanded") !== "true";
      setOpen(open);
    });
    header.querySelectorAll("[data-nav-close]").forEach((el) => {
      el.addEventListener("click", () => setOpen(false));
    });

    header.querySelectorAll<HTMLElement>("[data-track]").forEach((el) => {
      el.addEventListener("click", () => {
        const name = el.dataset.track;
        if (name) track(name);
      });
    });
  }

  initSiteHeader();
  document.addEventListener("astro:after-swap", () => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (header) delete header.dataset.bound;
    initSiteHeader();
  });
</script>
