---
const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
// Roofer login. Points at the dashboard root, which auto-routes: logged-out to
// /login, logged-in straight to /quotes. Env-overridable like the embed origin.
const dashboardUrl =
  import.meta.env.PUBLIC_DASHBOARD_URL ?? "https://app.belpa.co.uk";
---

<!--
  A plain sticky header. This replaced the scroll-morph (a giant centred hero
  wordmark that flew into a glass pill): the morph looked good but it dictated
  the layout — the logo had to be huge and centred to have somewhere to fly
  FROM, and the top of the fold had to stay empty to have somewhere to fly TO.
  The brand belongs up here at nav size so the headline can lead.

  Transparent over the hero, densifying into glass once you scroll past it.
-->
<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a href="/" class="header-brand" aria-label="Belpa home">
      <img src="/belpa-wordmark.png" alt="" width="900" height="279" />
    </a>

    <nav class="header-actions" aria-label="Main">
      <a href={dashboardUrl} class="header-login">Log in</a>
      <a
        href={meetingUrl}
        class="header-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="2"/>
          <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>Book a call</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    padding: max(0.7rem, env(safe-area-inset-top, 0px)) 0 0.7rem;
    /* Glass only once scrolled — over the hero it's invisible chrome so the
       blob and the headline own the fold. */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      backdrop-filter 0.28s ease;
  }
  .site-header.is-stuck {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(22px) saturate(1.7);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    border-bottom-color: rgba(16, 24, 40, 0.07);
    box-shadow: 0 10px 30px -22px rgba(23, 60, 160, 0.5);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 3vw, 1.75rem);
  }

  /* font-size is the logo's size knob — the img is sized in em. */
  .header-brand {
    display: block;
    flex: none;
    font-size: 26px;
    line-height: 0;
    text-decoration: none;
  }
  .header-brand img {
    display: block;
    height: 1em;
    width: auto;
  }
  .header-brand:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 6px;
    border-radius: 4px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.5rem);
  }

  /* Quiet utility for returning roofers — deliberately subordinate to the
     filled CTA so it never reads as a competing button. */
  .header-login {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .header-login:hover {
    color: var(--color-brand-600);
  }
  .header-login:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.68rem 1.15rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--color-brand-500), var(--color-brand-600));
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 20px -8px rgba(31, 87, 240, 0.55);
    transition:
      filter 0.15s ease,
      box-shadow 0.2s ease;
  }
  .header-cta:hover {
    filter: brightness(1.05);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.32) inset,
      0 12px 26px -8px rgba(31, 87, 240, 0.6);
  }
  .header-cta:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 3px;
  }
  .header-cta svg {
    flex: none;
  }

  @media (max-width: 480px) {
    .header-brand {
      font-size: 22px;
    }
    .header-cta {
      padding: 0.6rem 0.95rem;
      font-size: 0.85rem;
    }
    .header-cta svg {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  let cleanup: (() => void) | null = null;

  // Threshold toggle, not a scroll-linked morph: crossing the line flips a
  // class and CSS runs a fixed-duration transition, so it stays smooth however
  // fast you scroll. Hysteresis on the two edges stops it flickering.
  function initHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;
    let stuck = false;
    let raf = 0;

    const evaluate = () => {
      raf = 0;
      const y = window.__lenis?.scroll ?? window.scrollY;
      if (!stuck && y > 24) {
        stuck = true;
        header.classList.add("is-stuck");
      } else if (stuck && y < 8) {
        stuck = false;
        header.classList.remove("is-stuck");
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(evaluate);
    };

    evaluate();
    window.addEventListener("scroll", onScroll, { passive: true });
    const lenis = window.__lenis;
    lenis?.on?.("scroll", onScroll);

    cleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      window.removeEventListener("scroll", onScroll);
    };
  }

  initHeader();
  document.addEventListener("astro:after-swap", () => {
    cleanup?.();
    cleanup = null;
    initHeader();
  });
</script>
