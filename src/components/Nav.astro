---
const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
const dashboardUrl =
  import.meta.env.PUBLIC_DASHBOARD_URL ??
  "https://quoter-dashboard-frontend.vercel.app";

const links = [
  { href: "#product", label: "Product" },
  { href: "#pricing", label: "Pricing" },
  { href: "/privacy", label: "Docs" },
  { href: "#contact", label: "Contact" },
] as const;
---

<!--
  Glass hero nav → docked bar. One element; --nav-t (0→1) drives the morph.
  Quoter lives here from the start — no hero wordmark / brand-dock flight.
-->
<header class="hero-nav" data-site-header inert>
  <div class="hero-nav-glass">
    <div class="hero-nav-inner">
      <a href="/" class="hero-nav-brand" aria-label="Quoter home">Quoter</a>

      <nav class="hero-nav-links" aria-label="Primary">
        <ul class="hero-nav-list">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="hero-nav-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hero-nav-actions">
        <a
          href={dashboardUrl}
          class="hero-nav-login"
          aria-label="Log in to your dashboard"
        >
          Log in
        </a>

        <a href="#demo" class="hero-nav-demo" data-try>
          Get instant estimate
        </a>

        <button
          type="button"
          class="hero-nav-menu"
          data-nav-menu
          aria-expanded="false"
          aria-controls="site-mobile-panel"
          aria-label="Open menu"
        >
          <span class="hero-nav-menu-bars" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <div id="site-mobile-panel" class="hero-nav-panel" data-nav-panel hidden>
      <nav aria-label="Mobile">
        <ul class="hero-nav-mobile-list">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="hero-nav-mobile-link" data-nav-close>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="hero-nav-mobile-actions">
        <a href="#demo" class="hero-nav-mobile-demo" data-try data-nav-close>
          Get instant estimate
        </a>
        <a
          href={meetingUrl}
          class="hero-nav-mobile-book"
          data-nav-close
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
        </a>
        <a href={dashboardUrl} class="hero-nav-mobile-login" data-nav-close>
          Log in
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero-nav {
    --nav-t: 0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    pointer-events: none;
    /* Inset float → flush edge as t rises */
    padding-top: calc(
      max(0.7rem, env(safe-area-inset-top, 0px)) * (1 - var(--nav-t))
    );
    padding-inline: calc(0.85rem * (1 - var(--nav-t)));
    opacity: 0;
    transform: translate3d(0, -10px, 0);
    transition:
      opacity 0.7s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1)),
      transform 0.75s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .hero-nav.is-ready {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .hero-nav-glass {
    pointer-events: auto;
    width: 100%;
    max-width: calc(68rem * (1 - var(--nav-t)) + 100% * var(--nav-t));
    margin-inline: auto;
    /* Widget-matched glass: soft float → solid docked bar */
    border-radius: calc(28px * (1 - var(--nav-t)));
    background: rgba(
      255,
      255,
      255,
      calc(0.52 + 0.4 * var(--nav-t))
    );
    border: 1px solid
      rgba(
        255,
        255,
        255,
        calc(0.72 - 0.22 * var(--nav-t))
      );
    border-bottom: 1px solid
      rgba(
        16,
        24,
        40,
        calc(0.04 + 0.08 * var(--nav-t))
      );
    box-shadow:
      0 1px 0 rgba(255, 255, 255, calc(0.72 - 0.2 * var(--nav-t))) inset,
      0 18px 44px -22px rgba(31, 87, 240, calc(0.38 * (1 - var(--nav-t)))),
      0 10px 32px -18px rgba(15, 40, 100, calc(0.12 + 0.28 * var(--nav-t)));
    backdrop-filter: blur(calc(20px + 8px * var(--nav-t))) saturate(1.55);
    -webkit-backdrop-filter: blur(calc(20px + 8px * var(--nav-t))) saturate(1.55);
    overflow: hidden;
  }

  .hero-nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.55rem 0.85rem;
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: calc(0.62rem - 0.08rem * var(--nav-t))
      calc(0.95rem + 0.2rem * var(--nav-t));
    padding-top: calc(
      (0.62rem - 0.08rem * var(--nav-t)) +
        env(safe-area-inset-top, 0px) * var(--nav-t)
    );
  }
  @media (min-width: 1024px) {
    .hero-nav-inner {
      padding-inline: calc(1.15rem + 0.35rem * var(--nav-t));
    }
  }

  .hero-nav-brand {
    font-family: var(--font-display);
    font-size: calc(1.22rem - 0.06rem * var(--nav-t));
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .hero-nav-brand:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
    border-radius: 6px;
  }

  .hero-nav-links {
    display: none;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .hero-nav-links {
      display: flex;
    }
  }
  .hero-nav-list {
    display: flex;
    align-items: center;
    gap: 0.05rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-nav-link {
    display: inline-flex;
    padding: 0.42rem 0.68rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #1c2430;
    text-decoration: none;
  }
  .hero-nav-link:hover {
    background: rgba(47, 107, 255, 0.1);
    color: var(--color-brand-700);
  }
  .hero-nav-link:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .hero-nav-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .hero-nav-login {
    display: none;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #1c2430;
    text-decoration: none;
  }
  .hero-nav-login:hover {
    color: var(--color-brand-700);
  }
  .hero-nav-login:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  @media (min-width: 900px) {
    .hero-nav-login {
      display: inline-flex;
    }
  }

  .hero-nav-demo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.58rem 0.98rem;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 18px -8px rgba(31, 87, 240, 0.55);
  }
  .hero-nav-demo:hover {
    filter: brightness(1.05);
  }
  .hero-nav-demo:focus-visible {
    outline: 2px solid var(--color-brand-700);
    outline-offset: 3px;
  }

  .hero-nav-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid rgba(16, 24, 40, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-ink);
    cursor: pointer;
  }
  .hero-nav-menu:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .hero-nav-menu-bars,
  .hero-nav-menu-bars::before,
  .hero-nav-menu-bars::after {
    display: block;
    width: 1rem;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }
  .hero-nav-menu-bars {
    position: relative;
  }
  .hero-nav-menu-bars::before,
  .hero-nav-menu-bars::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .hero-nav-menu-bars::before {
    top: -5px;
  }
  .hero-nav-menu-bars::after {
    top: 5px;
  }
  @media (min-width: 900px) {
    .hero-nav-menu {
      display: none;
    }
  }

  .hero-nav-panel {
    border-top: 1px solid rgba(16, 24, 40, 0.08);
    background: rgba(255, 255, 255, 0.92);
    padding: 0.75rem 1.1rem 1.1rem;
  }
  .hero-nav-panel[hidden] {
    display: none;
  }
  @media (min-width: 900px) {
    .hero-nav-panel {
      display: none !important;
    }
  }
  .hero-nav-mobile-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-nav-mobile-link {
    display: block;
    padding: 0.85rem 0.15rem;
    border-bottom: 1px solid rgba(16, 24, 40, 0.06);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .hero-nav-mobile-actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .hero-nav-mobile-demo,
  .hero-nav-mobile-book,
  .hero-nav-mobile-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .hero-nav-mobile-demo {
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
  }
  .hero-nav-mobile-book {
    border: 1.5px solid rgba(31, 87, 240, 0.35);
    color: var(--color-brand-700);
    background: #fff;
  }
  .hero-nav-mobile-login {
    color: #1c2430;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-nav {
      transition: opacity 0.25s ease;
      transform: none;
    }
  }
</style>

<script>
  import { ensureScrollFlight } from "../scripts/scroll-flight";
  import { initNavMorph } from "../scripts/nav-morph";

  let menuCleanup: (() => void) | null = null;

  function initMenu() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;

    const menu = header.querySelector<HTMLButtonElement>("[data-nav-menu]");
    const panel = header.querySelector<HTMLElement>("[data-nav-panel]");
    const setOpen = (open: boolean) => {
      if (!menu || !panel) return;
      menu.setAttribute("aria-expanded", open ? "true" : "false");
      menu.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
    };
    const onMenu = () => setOpen(menu.getAttribute("aria-expanded") !== "true");
    menu?.addEventListener("click", onMenu);
    const closers: Array<() => void> = [];
    header.querySelectorAll("[data-nav-close]").forEach((el) => {
      const fn = () => setOpen(false);
      el.addEventListener("click", fn);
      closers.push(() => el.removeEventListener("click", fn));
    });

    header.removeAttribute("inert");
    header.style.pointerEvents = "";

    menuCleanup = () => {
      menu?.removeEventListener("click", onMenu);
      closers.forEach((fn) => fn());
    };
  }

  function bootNav() {
    ensureScrollFlight();
    initNavMorph();
    initMenu();
  }

  bootNav();
  document.addEventListener("astro:after-swap", () => {
    (
      window as Window & { __scrollFlight?: { destroy?: () => void } | null }
    ).__scrollFlight?.destroy?.();
    menuCleanup?.();
    menuCleanup = null;
    bootNav();
  });
</script>
