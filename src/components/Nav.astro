---
const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
---

<!--
  One fixed wordmark for the whole journey. No handoff at the top — that was
  the "click". Spacer is layout-only; fly is always the visible Quoter once ready.
-->
<a href="/" class="brand-fly" data-brand-fly aria-label="Quoter home">Quoter</a>

<!-- Docked nav pill. Sits at its normal (wordmark-only) size until the hero's
     own "Book a call" has scrolled out of view; then a discrete, NON-scroll-
     linked animation lengthens the pill and reveals the CTA next to the
     wordmark (the .is-expanded toggle is driven by initNavExpand below). -->
<div class="glass-nav" data-glass-nav inert>
  <span class="glass-nav-brand-slot" data-nav-brand-slot aria-hidden="true">Quoter</span>
  <span class="glass-nav-cta-wrap" data-nav-cta-wrap>
    <a
      href={meetingUrl}
      class="glass-nav-cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="2"/>
        <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span class="glass-nav-cta-label">Book a call</span>
    </a>
  </span>
</div>

<!-- Mobile nav: the desktop scroll-morph can't stay smooth on touch (native
     momentum + blur recompositing), so on phones the hero wordmark just scrolls
     away and this plain bar fades in. -->
<div class="mobile-nav" data-mobile-nav>
  <a href="/" class="mobile-nav-brand">Quoter</a>
  <a
    href={meetingUrl}
    class="mobile-nav-cta"
    target="_blank"
    rel="noopener noreferrer"
  >Book a call</a>
</div>

<style>
  .brand-fly {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.92;
    white-space: nowrap;
    text-decoration: none;
    transform-origin: 0 0;
    color: var(--color-ink);
    -webkit-text-fill-color: var(--color-ink);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: geometricPrecision;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .brand-fly.is-ready {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  /*
    Solid wordmark always. A highlight layer sweeps through the glyphs —
    the logo itself never slides away.
  */
  .brand-fly.is-hero::after {
    content: "Quoter";
    position: absolute;
    left: 0;
    top: 0;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    white-space: nowrap;
    pointer-events: none;
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(91, 140, 255, 0.9) 50%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 200% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: brand-sheen 9s linear infinite;
  }
  .brand-fly:not(.is-hero)::after {
    content: none;
    animation: none;
  }

  @keyframes brand-sheen {
    /* Pass through, then a long rest before the next sweep */
    0% {
      background-position: 200% 50%;
    }
    32% {
      background-position: -200% 50%;
    }
    100% {
      background-position: -200% 50%;
    }
  }

  .glass-nav {
    position: fixed;
    top: max(10px, env(safe-area-inset-top, 0px));
    left: 50%;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Starts wordmark-only. The CTA collapses to zero width via the grid trick
       on .glass-nav-cta-wrap, so the pill hugs the wordmark until .is-expanded
       fires — then the wrap animates open and the whole bar lengthens. */
    gap: 0;
    max-width: min(640px, calc(100vw - 24px));
    padding: 8px 26px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(24px) saturate(1.7);
    -webkit-backdrop-filter: blur(24px) saturate(1.7);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.7) inset,
      0 2px 6px rgba(16, 24, 40, 0.05),
      0 18px 44px -18px rgba(23, 60, 160, 0.35);
    transform: translate(-50%, 0);
    opacity: 0;
    pointer-events: none;
    box-sizing: border-box;
  }
  .glass-nav.is-expanded {
    padding-left: 26px;
    padding-right: 8px;
  }

  .glass-nav-brand-slot {
    flex: none;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.92;
    color: transparent;
    user-select: none;
    pointer-events: none;
  }

  /* Collapsible CTA. grid-template-columns 0fr → 1fr animates the child from
     zero to its natural width (the standard animate-to-auto trick), so the
     pill lengthens smoothly when .is-expanded toggles. */
  .glass-nav-cta-wrap {
    display: grid;
    grid-template-columns: 0fr;
    margin-left: 0;
    transition:
      grid-template-columns 0.55s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1)),
      margin-left 0.55s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .glass-nav.is-expanded .glass-nav-cta-wrap {
    grid-template-columns: 1fr;
    margin-left: 18px;
  }
  .glass-nav-cta {
    overflow: hidden;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.58rem 1.1rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--color-brand-500), var(--color-brand-600));
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 20px -8px rgba(31, 87, 240, 0.55);
    opacity: 0;
    transform: translateX(-6px);
    pointer-events: none;
    transition:
      opacity 0.35s ease 0.1s,
      transform 0.45s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1)) 0.1s;
  }
  .glass-nav.is-expanded .glass-nav-cta {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .glass-nav-cta svg {
    flex: none;
  }
  .glass-nav-cta:hover {
    filter: brightness(1.05);
  }
  .glass-nav-cta:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-fly.is-hero::after {
      content: none;
      animation: none;
    }
  }
  /* Mobile nav: hidden on desktop (the morph owns the nav there). On phones a
     plain fixed bar that fades in once you scroll past the hero — opacity only,
     no per-frame scroll morph, so it stays smooth. */
  .mobile-nav {
    display: none;
  }
  @media (max-width: 639px) {
    .mobile-nav {
      position: fixed;
      top: max(8px, env(safe-area-inset-top, 0px));
      left: 12px;
      right: 12px;
      z-index: 65;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 7px 8px 7px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(20px) saturate(1.7);
      -webkit-backdrop-filter: blur(20px) saturate(1.7);
      border: 1px solid rgba(255, 255, 255, 0.65);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.7) inset,
        0 10px 30px -14px rgba(23, 60, 160, 0.4);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition:
        opacity 0.3s ease,
        transform 0.34s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1));
    }
    .mobile-nav.is-shown {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
  .mobile-nav-brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
  }
  .mobile-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 18px -8px rgba(31, 87, 240, 0.55);
  }
</style>

<script>
  import { ensureScrollFlight } from "../scripts/scroll-flight";
  import { initBrandDock } from "../scripts/brand-dock";

  let mobileNavCleanup: (() => void) | null = null;
  let navExpandCleanup: (() => void) | null = null;

  // Mobile: no scroll-linked morph. Just fade a plain fixed bar in once the
  // hero has mostly scrolled away. A class toggle + CSS transition — cheap and
  // smooth, unlike the per-frame position morph.
  function initMobileNav() {
    const nav = document.querySelector<HTMLElement>("[data-mobile-nav]");
    if (!nav) return;
    let shown = false;
    const update = () => {
      const should = window.scrollY > window.innerHeight * 0.6;
      if (should !== shown) {
        shown = should;
        nav.classList.toggle("is-shown", should);
      }
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    mobileNavCleanup = () => window.removeEventListener("scroll", update);
  }

  // Desktop: the pill lengthens and reveals "Book a call" once the hero's own
  // CTA has scrolled out of sight. This is a THRESHOLD trigger, not a scroll-
  // linked morph — crossing the line flips a class and CSS runs the (fixed-
  // duration) animation, so it plays smoothly regardless of scroll speed.
  // Hysteresis on the two edges stops it flickering right at the boundary.
  function initNavExpand() {
    const nav = document.querySelector<HTMLElement>("[data-glass-nav]");
    const heroCta = document.querySelector<HTMLElement>("[data-meeting-spacer]");
    if (!nav || !heroCta) return;
    let expanded = false;
    let raf = 0;

    // The pill widens/narrows over ~0.55s of CSS transition, sliding the brand
    // slot sideways. The docked wordmark is a fixed element pinned to that
    // slot, so re-measure it every frame for the length of the animation or it
    // ends up sitting under the button.
    let syncRaf = 0;
    let syncUntil = 0;
    const syncBrand = () =>
      (window as Window & { __brandDock?: { sync?: () => void } | null })
        .__brandDock?.sync?.();
    const runSync = () => {
      syncRaf = 0;
      syncBrand();
      if (performance.now() < syncUntil) syncRaf = requestAnimationFrame(runSync);
    };
    const trackExpand = () => {
      syncUntil = performance.now() + 700;
      if (!syncRaf) syncRaf = requestAnimationFrame(runSync);
    };

    const evaluate = () => {
      raf = 0;
      const bottom = heroCta.getBoundingClientRect().bottom;
      // Expand once the hero CTA is fully gone above the top; collapse only
      // after it comes well back into view.
      if (!expanded && bottom < 6) {
        expanded = true;
        nav.classList.add("is-expanded");
        trackExpand();
      } else if (expanded && bottom > 56) {
        expanded = false;
        nav.classList.remove("is-expanded");
        trackExpand();
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(evaluate);
    };
    evaluate();
    window.addEventListener("scroll", onScroll, { passive: true });
    navExpandCleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      if (syncRaf) cancelAnimationFrame(syncRaf);
      window.removeEventListener("scroll", onScroll);
    };
  }

  function bootNavMotion() {
    // The scroll-morph is a desktop showpiece; on touch it can't stay smooth
    // (native momentum + blur recompositing), so phones get a plain fade nav.
    if (window.matchMedia("(min-width: 640px)").matches) {
      ensureScrollFlight();
      initBrandDock();
      initNavExpand();
    } else {
      initMobileNav();
    }
  }

  bootNavMotion();
  document.addEventListener("astro:after-swap", () => {
    (window as Window & { __scrollFlight?: { destroy?: () => void } | null }).__scrollFlight?.destroy?.();
    mobileNavCleanup?.();
    mobileNavCleanup = null;
    navExpandCleanup?.();
    navExpandCleanup = null;
    bootNavMotion();
  });
</script>
