---
const meetingUrl = "https://cal.com/rafil-gohar-43ssls/15min";
const dashboardUrl =
  import.meta.env.PUBLIC_DASHBOARD_URL ??
  "https://quoter-dashboard-frontend.vercel.app";

const links = [
  { href: "#product", label: "Product" },
  { href: "#pricing", label: "Pricing" },
  { href: "/privacy", label: "Docs" },
  { href: "#contact", label: "Contact" },
] as const;
---

<!--
  Hybrid header: always-visible landing chrome + morph dock targets.
  data-brand-fly / data-nav-brand-slot / data-glass-nav keep brand-dock working:
  the hero Quoter still flies into the left slot on scroll.
-->
<a href="/" class="brand-fly" data-brand-fly aria-label="Quoter home">Quoter</a>

<header class="site-header" data-site-header data-glass-nav inert>
  <div class="site-header-inner">
    <div class="site-brand">
      <!-- Transparent sizing slot — brand-dock lands the flying wordmark here. -->
      <span class="site-brand-slot" data-nav-brand-slot aria-hidden="true">Quoter</span>
    </div>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="site-nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header-actions">
      <a
        href={dashboardUrl}
        class="site-header-login"
        aria-label="Log in to your dashboard"
      >
        Log in
      </a>

      <!-- Collapses until hero Book a call scrolls away (initNavExpand). -->
      <span class="site-header-book-wrap" data-nav-cta-wrap>
        <span class="site-header-book-inner">
          <a
            href={meetingUrl}
            class="site-header-book"
            data-nav-book
            target="_blank"
            rel="noopener noreferrer"
          >
            Book a call
          </a>
        </span>
      </span>

      <a href="#demo" class="site-header-demo" data-try>
        Get instant estimate
      </a>

      <button
        type="button"
        class="site-header-menu"
        data-nav-menu
        aria-expanded="false"
        aria-controls="site-mobile-panel"
        aria-label="Open menu"
      >
        <span class="site-header-menu-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="site-mobile-panel" class="site-mobile-panel" data-nav-panel hidden>
    <nav aria-label="Mobile">
      <ul class="site-mobile-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="site-mobile-link" data-nav-close>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-mobile-actions">
      <a
        href={meetingUrl}
        class="site-mobile-book"
        data-nav-close
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call
      </a>
      <a href="#demo" class="site-mobile-demo" data-try data-nav-close>
        Get instant estimate
      </a>
      <a href={dashboardUrl} class="site-mobile-login" data-nav-close>Log in</a>
    </div>
  </div>
</header>

<!-- Mobile fallback wordmark when the morph flyer is hidden. -->
<a href="/" class="site-mobile-logo" aria-label="Quoter home">Quoter</a>

<style>
  .brand-fly {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.92;
    white-space: nowrap;
    text-decoration: none;
    transform-origin: 0 0;
    color: var(--color-ink);
    -webkit-text-fill-color: var(--color-ink);
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .brand-fly.is-ready {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .brand-fly.is-hero::after {
    content: "Quoter";
    position: absolute;
    left: 0;
    top: 0;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    white-space: nowrap;
    pointer-events: none;
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(91, 140, 255, 0.9) 50%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 200% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: brand-sheen 9s linear infinite;
  }
  .brand-fly:not(.is-hero)::after {
    content: none;
    animation: none;
  }
  @keyframes brand-sheen {
    0% {
      background-position: 200% 50%;
    }
    32% {
      background-position: -200% 50%;
    }
    100% {
      background-position: -200% 50%;
    }
  }
  @media (max-width: 639px) {
    .brand-fly {
      display: none;
    }
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    /* brand-dock drives --nav-alpha for background strength as the logo docks */
    --nav-alpha: 0;
    background: rgba(
      255,
      255,
      255,
      calc(0.72 + (var(--nav-alpha, 0) * 0.24))
    );
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    border-bottom: 1px solid
      rgba(16, 24, 40, calc(0.04 + (var(--nav-alpha, 0) * 0.08)));
    box-shadow: 0 8px 28px -20px
      rgba(15, 40, 100, calc(var(--nav-alpha, 0) * 0.4));
    transition: box-shadow 0.25s ease;
  }
  .site-header.is-scrolled,
  .site-header.is-brand-docked {
    --nav-alpha: 1;
  }

  .site-header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem 1rem;
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: 0.7rem 1.25rem;
    padding-top: max(0.7rem, env(safe-area-inset-top, 0px));
  }
  @media (min-width: 1024px) {
    .site-header-inner {
      padding-inline: 1.5rem;
    }
  }

  .site-brand {
    min-width: 4.5rem;
  }
  .site-brand-slot {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.92;
    color: transparent;
    user-select: none;
    pointer-events: none;
  }

  .site-nav {
    display: none;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .site-nav {
      display: flex;
    }
  }
  .site-nav-list {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav-link {
    display: inline-flex;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #1c2430;
    text-decoration: none;
  }
  .site-nav-link:hover {
    background: rgba(47, 107, 255, 0.08);
    color: var(--color-brand-700);
  }
  .site-nav-link:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .site-header-login {
    display: none;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1c2430;
    text-decoration: none;
  }
  .site-header-login:hover {
    color: var(--color-brand-700);
  }
  .site-header-login:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  @media (min-width: 900px) {
    .site-header-login {
      display: inline-flex;
    }
  }

  .site-header-book-wrap {
    display: none;
    grid-template-columns: 0fr;
    transition: grid-template-columns 0.55s
      var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1));
  }
  @media (min-width: 640px) {
    .site-header-book-wrap {
      display: grid;
    }
  }
  .site-header.is-expanded .site-header-book-wrap {
    grid-template-columns: 1fr;
  }
  .site-header-book-inner {
    overflow: hidden;
    min-width: 0;
  }
  .site-header-book {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-brand-700);
    text-decoration: none;
    opacity: 0;
    transform: translateX(-6px);
    pointer-events: none;
    transition:
      opacity 0.35s ease 0.08s,
      transform 0.45s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1)) 0.08s;
  }
  .site-header.is-expanded .site-header-book {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .site-header-book:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site-header-book:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .site-header-demo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.62rem 1.05rem;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 18px -8px rgba(31, 87, 240, 0.55);
  }
  .site-header-demo:hover {
    filter: brightness(1.05);
  }
  .site-header-demo:focus-visible {
    outline: 2px solid var(--color-brand-700);
    outline-offset: 3px;
  }

  .site-header-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(16, 24, 40, 0.12);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    cursor: pointer;
  }
  .site-header-menu:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .site-header-menu-bars,
  .site-header-menu-bars::before,
  .site-header-menu-bars::after {
    display: block;
    width: 1rem;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }
  .site-header-menu-bars {
    position: relative;
  }
  .site-header-menu-bars::before,
  .site-header-menu-bars::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .site-header-menu-bars::before {
    top: -5px;
  }
  .site-header-menu-bars::after {
    top: 5px;
  }
  @media (min-width: 900px) {
    .site-header-menu {
      display: none;
    }
  }

  .site-mobile-panel {
    border-top: 1px solid rgba(16, 24, 40, 0.08);
    background: rgba(255, 255, 255, 0.98);
    padding: 0.75rem 1.25rem 1.15rem;
  }
  .site-mobile-panel[hidden] {
    display: none;
  }
  @media (min-width: 900px) {
    .site-mobile-panel {
      display: none !important;
    }
  }
  .site-mobile-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-mobile-link {
    display: block;
    padding: 0.85rem 0.15rem;
    border-bottom: 1px solid rgba(16, 24, 40, 0.06);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .site-mobile-actions {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
  }
  .site-mobile-book,
  .site-mobile-demo,
  .site-mobile-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .site-mobile-book {
    border: 1.5px solid rgba(31, 87, 240, 0.35);
    color: var(--color-brand-700);
    background: #fff;
  }
  .site-mobile-demo {
    background: linear-gradient(
      180deg,
      var(--color-brand-500),
      var(--color-brand-600)
    );
    color: #fff;
  }
  .site-mobile-login {
    color: #1c2430;
  }

  /* Static logo for mobile — morph flyer is desktop-only. */
  .site-mobile-logo {
    display: none;
  }
  @media (max-width: 639px) {
    .site-mobile-logo {
      position: fixed;
      top: max(0.95rem, calc(env(safe-area-inset-top, 0px) + 0.85rem));
      left: 1.35rem;
      z-index: 85;
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 600;
      letter-spacing: -0.045em;
      line-height: 1;
      color: var(--color-ink);
      text-decoration: none;
      pointer-events: auto;
    }
    .site-brand {
      /* Room for the fixed mobile logo; slot still sizes layout. */
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-fly.is-hero::after {
      content: none;
      animation: none;
    }
  }
</style>

<script>
  import { ensureScrollFlight } from "../scripts/scroll-flight";
  import { initBrandDock } from "../scripts/brand-dock";

  let navExpandCleanup: (() => void) | null = null;
  let scrollChromeCleanup: (() => void) | null = null;

  function initHeaderChrome() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;

    const onScroll = () => {
      const y = window.__lenis?.scroll ?? window.scrollY;
      header.classList.toggle("is-scrolled", y > 12);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.__lenis?.on?.("scroll", onScroll);
    scrollChromeCleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.__lenis?.off?.("scroll", onScroll);
    };

    const menu = header.querySelector<HTMLButtonElement>("[data-nav-menu]");
    const panel = header.querySelector<HTMLElement>("[data-nav-panel]");
    const setOpen = (open: boolean) => {
      if (!menu || !panel) return;
      menu.setAttribute("aria-expanded", open ? "true" : "false");
      menu.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
    };
    menu?.addEventListener("click", () => {
      setOpen(menu.getAttribute("aria-expanded") !== "true");
    });
    header.querySelectorAll("[data-nav-close]").forEach((el) => {
      el.addEventListener("click", () => setOpen(false));
    });

    // Header is always interactive for nav — brand-dock no longer sets inert.
    header.removeAttribute("inert");
    header.style.pointerEvents = "auto";
  }

  function initNavExpand() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const heroCta = document.querySelector<HTMLElement>("[data-meeting-spacer]");
    if (!header || !heroCta) return;
    if (!window.matchMedia("(min-width: 640px)").matches) {
      header.classList.add("is-expanded");
      return;
    }

    let expanded = false;
    let raf = 0;
    let syncRaf = 0;
    let syncUntil = 0;
    const syncBrand = () =>
      (window as Window & { __brandDock?: { sync?: () => void } | null })
        .__brandDock?.sync?.();
    const runSync = () => {
      syncRaf = 0;
      syncBrand();
      if (performance.now() < syncUntil) syncRaf = requestAnimationFrame(runSync);
    };
    const trackExpand = () => {
      syncUntil = performance.now() + 700;
      if (!syncRaf) syncRaf = requestAnimationFrame(runSync);
    };

    const evaluate = () => {
      raf = 0;
      const bottom = heroCta.getBoundingClientRect().bottom;
      if (!expanded && bottom < 6) {
        expanded = true;
        header.classList.add("is-expanded");
        trackExpand();
      } else if (expanded && bottom > 56) {
        expanded = false;
        header.classList.remove("is-expanded");
        trackExpand();
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(evaluate);
    };
    evaluate();
    window.addEventListener("scroll", onScroll, { passive: true });
    const onLenis = () => onScroll();
    window.__lenis?.on?.("scroll", onLenis);
    navExpandCleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      if (syncRaf) cancelAnimationFrame(syncRaf);
      window.removeEventListener("scroll", onScroll);
      window.__lenis?.off?.("scroll", onLenis);
    };
  }

  function bootNavMotion() {
    initHeaderChrome();
    if (window.matchMedia("(min-width: 640px)").matches) {
      ensureScrollFlight();
      initBrandDock();
      initNavExpand();
    } else {
      // Mobile: no morph — expand book call, show static logo.
      const header = document.querySelector<HTMLElement>("[data-site-header]");
      header?.classList.add("is-expanded", "is-brand-docked");
      header?.removeAttribute("inert");
    }
  }

  bootNavMotion();
  document.addEventListener("astro:after-swap", () => {
    (
      window as Window & { __scrollFlight?: { destroy?: () => void } | null }
    ).__scrollFlight?.destroy?.();
    navExpandCleanup?.();
    navExpandCleanup = null;
    scrollChromeCleanup?.();
    scrollChromeCleanup = null;
    bootNavMotion();
  });
</script>
