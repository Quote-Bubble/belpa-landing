---
/**
 * Desktop intro: a descent from orbit onto the roof, which then pulls back and
 * becomes the hero.
 *
 * This is the page's LOADING STATE, not an animation played before it. Two
 * rules follow from that and both are load-bearing:
 *
 *   1. It never adds time. The choreography holds at one beat while the page
 *      finishes, then resolves. Ready early and it resolves early; a hard cap
 *      ends it regardless, so a slow network cannot strand anybody.
 *
 *   2. It never withholds content. The hero is in the DOM and painted from the
 *      first frame, underneath the overlay. Largest Contentful Paint is
 *      measured on what the browser paints, so an intro that gated the markup
 *      would trade a real SEO metric for a flourish.
 *
 * The handoff is what makes it one animation rather than two. The roof does not
 * fade out for the hero to fade in: it flies to the measured position of the
 * hero's own RoofStory panel, and the hero's entrance — which is paused until
 * this moment — begins as it lands. Same technique as brand-dock.ts, which
 * already measures a destination and animates precisely onto it.
 */
import { ROOF_PATH, ROOF_PHOTO } from "../data/roof-figure";
---

{/*
  Runs before first paint so the overlay is either there from frame one or never
  shown at all. Deciding in a normal module script would let the hero paint,
  then be covered, which reads as a flash.
*/}
<script is:inline>
  (() => {
    try {
      const doc = document.documentElement;
      // Deep links skip it: someone arriving at /#how asked for a section, not
      // a title sequence.
      if (location.hash) return;
      if (sessionStorage.getItem("belpa:intro")) return;
      if (!window.matchMedia("(min-width: 1024px)").matches) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      // Save-Data means the visitor has asked for less. A full-screen photo
      // sequence is exactly the sort of thing they meant.
      const conn = navigator.connection;
      if (conn && (conn.saveData || /2g/.test(conn.effectiveType || ""))) return;
      sessionStorage.setItem("belpa:intro", "1");
      doc.classList.add("ri-on");
      // Failsafe. THIS script adds the class, so this script owns the promise
      // that it comes off again — if the module below never runs (parse error,
      // blocked bundle, an engine that chokes on it), the overlay would sit
      // there forever with the hero frozen underneath it. Deliberately longer
      // than the animation's own hard cap, so in normal operation it never
      // fires.
      setTimeout(() => {
        doc.classList.add("ri-done", "ri-released");
        doc.classList.remove("ri-on");
      }, 4500);
    } catch {
      /* Private mode can throw on sessionStorage — just skip the intro. */
    }
  })();
</script>

<div class="ri" data-roof-intro aria-hidden="true">
  <div class="ri-sky"></div>

  <div class="ri-stage" data-ri-stage>
    <div class="ri-frame" data-ri-frame>
      <img
        class="ri-photo"
        src={ROOF_PHOTO}
        alt=""
        width="1280"
        height="960"
        fetchpriority="high"
        decoding="sync"
        data-ri-photo
      />

      <svg
        class="ri-trace"
        viewBox="0 0 1024 768"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <defs>
          <filter id="ri-glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="7" result="b" />
            <feMerge><feMergeNode in="b" /></feMerge>
          </filter>
        </defs>
        <path class="ri-fill" d={ROOF_PATH} data-ri-fill />
        <path class="ri-glow" d={ROOF_PATH} filter="url(#ri-glow)" data-ri-line />
        <path class="ri-line" d={ROOF_PATH} data-ri-line />
      </svg>

      <div class="ri-sweep" data-ri-sweep></div>
    </div>

    <div class="ri-readout" data-ri-readout>
      <span class="ri-dot"></span>
      <span data-ri-label>Locating roof</span>
      <span class="ri-figure" data-ri-figure></span>
    </div>
  </div>
</div>

<style>
  /* Hidden unless the inline gate above opted in, so the markup costs nothing
     on mobile, on repeat visits, or under reduced motion. */
  .ri {
    display: none;
  }
  :global(html.ri-on) .ri {
    display: block;
    position: fixed;
    inset: 0;
    /* Above the nav (60) and the quote modal (2001). */
    z-index: 9000;
    overflow: hidden;
    background: #05070f;
    /* The overlay is inert: it never takes a click, so a visitor who starts
       typing or scrolling through it is interacting with the real page. */
    pointer-events: none;
  }
  :global(html.ri-done) .ri {
    display: none;
  }

  /* A faint orbital wash so the first frame is not flat black. */
  .ri-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        120% 80% at 50% 0%,
        rgba(47, 107, 255, 0.22) 0%,
        transparent 60%
      ),
      radial-gradient(90% 60% at 50% 100%, rgba(9, 18, 40, 0.9) 0%, #05070f 70%);
    opacity: 0;
    animation: ri-sky 0.5s ease-out forwards;
  }
  @keyframes ri-sky {
    to {
      opacity: 1;
    }
  }

  /* The camera. The pull-back at the end transforms THIS, so everything inside
     travels together as one rigid object. */
  .ri-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .ri-frame {
    position: relative;
    width: min(78vw, 108vh);
    aspect-ratio: 4 / 3;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.9);
    /* The descent. Starts far out and blurred, resolves as it falls. Scale and
       filter only, so it composites. */
    opacity: 0;
    transform: scale(2.6);
    filter: blur(18px) saturate(0.7);
    animation: ri-descend 1s cubic-bezier(0.16, 1, 0.3, 1) 0.06s forwards;
  }
  @keyframes ri-descend {
    0% {
      opacity: 0;
      transform: scale(2.6);
      filter: blur(18px) saturate(0.7);
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scale(1);
      filter: blur(0) saturate(1);
    }
  }

  .ri-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ri-trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ri-fill {
    fill: rgba(47, 107, 255, 0.16);
    opacity: 0;
    transition: opacity 0.45s ease-out;
  }
  :global(html.ri-traced) .ri-fill {
    opacity: 1;
  }
  .ri-glow {
    fill: none;
    stroke: rgba(120, 170, 255, 0.85);
    stroke-width: 5;
    stroke-linejoin: round;
  }
  .ri-line {
    fill: none;
    stroke: #eaf1ff;
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  /* Scan sweep. Crosses once during the trace. */
  .ri-sweep {
    position: absolute;
    top: -10%;
    bottom: -10%;
    left: 0;
    width: 45%;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgba(150, 195, 255, 0.06) 35%,
      rgba(190, 220, 255, 0.5) 50%,
      rgba(150, 195, 255, 0.06) 65%,
      transparent 100%
    );
    opacity: 0;
    transform: translate3d(-120%, 0, 0);
    animation: ri-sweep 0.95s cubic-bezier(0.4, 0, 0.2, 1) 0.72s forwards;
  }
  @keyframes ri-sweep {
    0% {
      opacity: 0;
      transform: translate3d(-120%, 0, 0);
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(260%, 0, 0);
    }
  }

  .ri-readout {
    position: absolute;
    left: 50%;
    bottom: clamp(2.5rem, 9vh, 6rem);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(215, 230, 255, 0.75);
    opacity: 0;
    animation: ri-readout 0.5s ease-out 0.55s forwards;
  }
  @keyframes ri-readout {
    to {
      opacity: 1;
    }
  }
  .ri-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #6ea8ff;
    box-shadow: 0 0 12px 2px rgba(110, 168, 255, 0.8);
    animation: ri-pulse 1.1s ease-in-out infinite;
  }
  @keyframes ri-pulse {
    50% {
      opacity: 0.25;
    }
  }
  .ri-figure {
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  /* Leaving. Opacity only — the stage's transform is driven from JS, and an
     animation on the same property would fight it. */
  :global(html.ri-leaving) .ri-stage {
    transition:
      transform 0.62s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.42s ease-in 0.2s;
    opacity: 0;
  }
  :global(html.ri-leaving) .ri-sky {
    transition: opacity 0.5s ease-in;
    opacity: 0;
  }
  :global(html.ri-leaving) .ri-readout,
  :global(html.ri-leaving) .ri-sweep {
    transition: opacity 0.2s ease-in;
    opacity: 0;
  }
</style>

<style is:global>
  /* Hold the hero's own entrance while the intro is up.
   *
   * Without this the hero would play its rise behind an opaque overlay and be
   * sitting still by the time it was uncovered — two animations, one wasted.
   * Paused, they resume the instant the intro releases, so the roof landing in
   * the panel and the copy rising are consecutive beats of one move.
   *
   * animation-play-state rather than a display/opacity trick: it holds each
   * element on its own first keyframe, so nothing needs to know what any of
   * these animations actually do. */
  html.ri-on:not(.ri-released) .sub-load,
  html.ri-on:not(.ri-released) .widget-load,
  html.ri-on:not(.ri-released) .hero-brand-spacer,
  html.ri-on:not(.ri-released) [data-reveal] {
    animation-play-state: paused !important;
  }

  /* Compress the hero entrance when it follows the intro.
   *
   * Those delays (0.58s subtitle, 1.2s widget, 2.4s to settle) were written for
   * a cold load where the entrance IS the opening. Replayed unchanged after a
   * ~2s intro they become a second opening: the widget would not be usable
   * until about 4.4s, which is the exact sluggishness this whole session has
   * been removing.
   *
   * Shortened, the copy rises while the roof is still travelling to its panel
   * and the widget lands just after it arrives — one continuous move instead of
   * two sequential ones. The cold-load timings are untouched. */
  html.ri-released .hero-brand-spacer {
    animation-duration: 0.72s !important;
    animation-delay: 0s !important;
  }
  html.ri-released .sub-load {
    animation-duration: 0.66s !important;
    animation-delay: 0.08s !important;
  }
  html.ri-released .sub-load-late {
    animation-delay: 0.2s !important;
  }
  html.ri-released .widget-load {
    animation-duration: 0.72s !important;
    animation-delay: 0.34s !important;
  }
</style>

<script>
  import { ROOF_AREA_M2 } from "../data/roof-figure";

  function initRoofIntro() {
    const root = document.documentElement;
    if (!root.classList.contains("ri-on")) return;
    if (root.classList.contains("ri-done")) return;

    const overlay = document.querySelector<HTMLElement>("[data-roof-intro]");
    const stage = document.querySelector<HTMLElement>("[data-ri-stage]");
    const frame = document.querySelector<HTMLElement>("[data-ri-frame]");
    const photo = document.querySelector<HTMLImageElement>("[data-ri-photo]");
    const label = document.querySelector<HTMLElement>("[data-ri-label]");
    const figure = document.querySelector<HTMLElement>("[data-ri-figure]");
    const lines = Array.from(
      document.querySelectorAll<SVGPathElement>("[data-ri-line]"),
    );

    if (!overlay || !stage || !frame) {
      root.classList.remove("ri-on");
      return;
    }

    // Every exit runs through here exactly once: natural end, skip, cap, or a
    // thrown error. Leaving the overlay up because a promise never settled is
    // the one failure this must not have.
    let finished = false;
    function release(immediate = false) {
      if (finished) return;
      finished = true;

      window.removeEventListener("wheel", onSkip);
      window.removeEventListener("pointerdown", onSkip);
      window.removeEventListener("keydown", onSkip);

      if (immediate) {
        root.classList.add("ri-done", "ri-released");
        root.classList.remove("ri-on");
        return;
      }

      // Fly the roof to where the hero's own panel sits. Measured, not guessed,
      // so it lands on the real thing at any viewport size.
      const target = document.querySelector<HTMLElement>("[data-roof-story]");
      const from = frame!.getBoundingClientRect();
      let flight = "";
      if (target && from.width > 0) {
        const to = target.getBoundingClientRect();
        if (to.width > 0) {
          const scale = to.width / from.width;
          const dx = to.left + to.width / 2 - (from.left + from.width / 2);
          const dy = to.top + to.height / 2 - (from.top + from.height / 2);
          flight = `translate3d(${dx}px, ${dy}px, 0) scale(${scale})`;
        }
      }

      // Establish the transition, let the browser see that state, and only then
      // set the target transform. Doing both in one task computes style once
      // and the roof would jump to the panel instead of flying to it.
      root.classList.add("ri-leaving");
      requestAnimationFrame(() => {
        if (flight) stage!.style.transform = flight;
      });

      root.classList.add("ri-released");

      window.setTimeout(() => {
        root.classList.add("ri-done");
        root.classList.remove("ri-on", "ri-leaving");
      }, 700);
    }

    const onSkip = () => release(false);
    window.addEventListener("wheel", onSkip, { passive: true, once: true });
    window.addEventListener("pointerdown", onSkip, { once: true });
    window.addEventListener("keydown", onSkip, { once: true });

    // Draw the outline by stroke, using the real path length so the dash maths
    // is exact rather than a guessed overshoot.
    for (const line of lines) {
      const len = line.getTotalLength();
      line.style.strokeDasharray = `${len}`;
      line.style.strokeDashoffset = `${len}`;
      line.style.transition =
        "stroke-dashoffset 0.72s cubic-bezier(0.65, 0, 0.35, 1)";
    }

    const t: number[] = [];
    const at = (ms: number, fn: () => void) => t.push(window.setTimeout(fn, ms));

    at(780, () => {
      for (const line of lines) line.style.strokeDashoffset = "0";
      if (label) label.textContent = "Measuring";
    });

    at(1420, () => {
      root.classList.add("ri-traced");
      if (label) label.textContent = "Roof measured";
      // Count the area up rather than printing it, so the number reads as a
      // result being computed.
      if (figure) {
        const start = performance.now();
        const dur = 420;
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          figure.textContent = `${Math.round(ROOF_AREA_M2 * eased)} m²`;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    });

    /**
     * The hold.
     *
     * Everything above is fixed choreography; this is where the animation
     * becomes a loading state. It waits for the page to actually be usable,
     * then leaves. Ready early and the wait is zero.
     */
    const ready = Promise.all([
      document.fonts?.ready?.catch(() => undefined) ?? Promise.resolve(),
      photo?.decode?.().catch(() => undefined) ?? Promise.resolve(),
      new Promise<void>((resolve) => {
        if (document.readyState === "complete") return resolve();
        window.addEventListener("load", () => resolve(), { once: true });
      }),
    ]);

    // Floor: never cut the trace off mid-draw, even on a warm cache.
    const floor = new Promise<void>((resolve) => at(1900, resolve));
    // Ceiling: a stalled font or a slow image must not hold the page hostage.
    const cap = new Promise<void>((resolve) => at(3200, resolve));

    Promise.race([Promise.all([ready, floor]), cap])
      .then(() => release(false))
      .catch(() => release(true));

    document.addEventListener(
      "astro:before-swap",
      () => {
        t.forEach((id) => window.clearTimeout(id));
        release(true);
      },
      { once: true },
    );
  }

  initRoofIntro();
</script>
