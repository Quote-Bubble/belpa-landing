  .st-detail {
    display: grid;
    grid-template-rows: 0fr;
    background: rgba(10, 11, 13, 0.02);
    border-bottom: 1px solid rgba(233, 234, 238, 0.7);
    transition: none;
  }
  .st-detail.is-open {
    grid-template-rows: 1fr;
  }
  .st-detail-inner {
    overflow: hidden;
    min-height: 0;
  }
  .st-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 0.85rem;
    padding: 0.7rem 0.85rem 0.8rem;
  }
  .st-detail-price {
    margin: 0;
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .st-detail-vat {
    margin: 0.1rem 0 0;
    font-size: 0.62rem;
    color: var(--color-muted);
  }
  .st-detail-job {
    margin: 0.35rem 0 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .st-detail-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem 0.6rem;
  }
  .st-detail-k {
    display: block;
    font-size: 0.58rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .st-detail-v {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--color-ink);
    text-transform: capitalize;
  }

  @media (max-width: 640px) {
    .st-dim {
      display: none;
    }
    .st-area-text {
      font-size: 56px;
    }
    .st-lead {
      padding: 4% 4%;
    }
    .st-notif-title {
      font-size: 0.9rem;
    }
    .st-notif-price {
      font-size: 1.05rem;
    }
    .st-dash-cols,
    .st-row {
      grid-template-columns: 1.3fr 0.9fr 1fr 0.7fr;
    }
    .st-detail-grid {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .st-meta {
      font-size: 0.7rem;
    }
    .st-opts--2 {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-ask,
    .st-flow,
    .st-contact,
    .st-lead {
      display: none;
    }
    .st-map {
      opacity: 1;
    }
    .st-fill,
    .st-dim,
    .st-area,
    .st-meta {
      opacity: 1;
    }
    .st-vert {
      opacity: 1;
    }
    .st-progress {
      display: none;
    }
  }
</style>

<script>
  import type { RoofScene } from "./roof-story-scenes";

  // ~21.5s. Customer flow is readable; measure stays the hero beat; the
  // roofer inbox gets the longest settled hold — that is the B2B proof.
  const DUR = 21500;
  const BEATS = {
    typeFrom: 0.02,
    typeTo: 0.09,
    press: 0.095,

    askOutFrom: 0.1,
    askOutTo: 0.13,

    flowInFrom: 0.115,
    flowInTo: 0.145,
    jobPick: 0.16,
    propShow: 0.195,
    propPick: 0.22,
    storeysShow: 0.255,
    storeysPick: 0.28,
    flowOutFrom: 0.305,
    flowOutTo: 0.33,

    contactInFrom: 0.32,
    contactInTo: 0.345,
    nameFrom: 0.35,
    nameTo: 0.4,
    phoneFrom: 0.405,
    phoneTo: 0.44,
    emailFrom: 0.445,
    emailTo: 0.485,
    continueReady: 0.49,
    contactOutFrom: 0.505,
    contactOutTo: 0.53,

    whipFrom: 0.52,
    whipTo: 0.565,
    traceFrom: 0.565,
    traceTo: 0.655,
    fillFrom: 0.64,
    fillTo: 0.69,
    dimsFrom: 0.675,
    dimsTo: 0.73,
    areaFrom: 0.695,
    areaTo: 0.745,

    mapOutFrom: 0.77,
    mapOutTo: 0.805,

    leadFrom: 0.795,
    leadTo: 0.825,
    notifFrom: 0.82,
    notifTo: 0.855,
    notifOutFrom: 0.875,
    notifOutTo: 0.9,

    dashFrom: 0.885,
    dashTo: 0.915,
    rowFrom: 0.905,
    rowTo: 0.93,
    detailFrom: 0.935,
    detailTo: 0.955,
    holdTo: 0.985,
  };

  const JOB_PICK = "full";

  function picksFor(s: RoofScene) {
    if (s.id === "terrace") return { prop: "terrace", storeys: "2" };
    if (s.id === "bungalow") return { prop: "bungalow", storeys: "1" };
    return { prop: "detached", storeys: "2" };
  }

  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const span = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));
  const outCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const inOutCubic = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  const SVG_NS = "http://www.w3.org/2000/svg";

  function probeScene(scene: RoofScene): Promise<RoofScene | null> {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => resolve(scene);
      img.onerror = () => resolve(null);
      img.src = scene.photo;
    });
  }

  function initRoofStory() {
    document.querySelectorAll<HTMLElement>("[data-roof-story]").forEach((root) => {
      if (root.dataset.stBound === "1") return;
      root.dataset.stBound = "1";

      const scenesEl = root.querySelector<HTMLScriptElement>("[data-st-scenes]");
      let allScenes: RoofScene[] = [];
      try {
        allScenes = JSON.parse(scenesEl?.textContent ?? "[]") as RoofScene[];
      } catch {
        allScenes = [];
      }
      if (!allScenes.length) return;

      const CONTACT_NAME = root.dataset.contactName ?? "James Whitaker";
      const CONTACT_PHONE = root.dataset.contactPhone ?? "";
      const CONTACT_EMAIL = root.dataset.contactEmail ?? "";

      const q = <T extends Element>(s: string) => root.querySelector<T>(s);
      const ask = q<HTMLElement>("[data-st-ask]")!;
      const flow = q<HTMLElement>("[data-st-flow]")!;
      const contact = q<HTMLElement>("[data-st-contact]")!;
      const map = q<HTMLElement>("[data-st-map]")!;
      const stage = q<HTMLElement>("[data-st-stage]")!;
      const photo = q<HTMLImageElement>("[data-st-photo]")!;
      const typed = q<HTMLElement>("[data-st-typed]")!;
      const caret = q<HTMLElement>("[data-st-caret]")!;
      const btn = q<HTMLElement>("[data-st-btn]")!;
      const fill = q<SVGPathElement>("[data-st-fill]")!;
      const lines = [...root.querySelectorAll<SVGPathElement>("[data-st-line]")];
      const vertsG = q<SVGGElement>("[data-st-verts]")!;
      const dimsG = q<SVGGElement>("[data-st-dims]")!;
      const area = q<SVGGElement>("[data-st-area]")!;
      const areaPlate = q<SVGRectElement>("[data-st-area-plate]")!;
      const areaText = q<SVGTextElement>("[data-st-area-text]")!;
      const meta = q<HTMLElement>("[data-st-meta]")!;
      const lead = q<HTMLElement>("[data-st-lead]")!;
      const notif = q<HTMLElement>("[data-st-notif]")!;
      const dash = q<HTMLElement>("[data-st-dash]")!;
      const rowNew = q<HTMLElement>("[data-st-row-new]")!;
      const detail = q<HTMLElement>("[data-st-detail]")!;
      const progress = q<HTMLElement>("[data-st-progress]");
      const nameEl = q<HTMLElement>("[data-st-name]")!;
      const phoneEl = q<HTMLElement>("[data-st-phone]")!;
      const emailEl = q<HTMLElement>("[data-st-email]")!;
      const nameCaret = q<HTMLElement>("[data-st-name-caret]")!;
      const phoneCaret = q<HTMLElement>("[data-st-phone-caret]")!;
      const emailCaret = q<HTMLElement>("[data-st-email-caret]")!;
      const continueBtn = q<HTMLElement>("[data-st-continue]")!;
      const notifBody = q<HTMLElement>("[data-st-notif-body]")!;
      const notifPrice = q<HTMLElement>("[data-st-notif-price]")!;
      const leadName = q<HTMLElement>("[data-st-lead-name]")!;
      const leadPc = q<HTMLElement>("[data-st-lead-pc]")!;
      const leadPrice = q<HTMLElement>("[data-st-lead-price]")!;
      const detailPrice = q<HTMLElement>("[data-st-detail-price]")!;
      const detailArea = q<HTMLElement>("[data-st-detail-area]")!;
      const detailShape = q<HTMLElement>("[data-st-detail-shape]")!;
      const detailPc = q<HTMLElement>("[data-st-detail-pc]")!;

      const panels = {
        job: q<HTMLElement>('[data-st-panel="job"]')!,
        prop: q<HTMLElement>('[data-st-panel="prop"]')!,
        storeys: q<HTMLElement>('[data-st-panel="storeys"]')!,
      };
      const jobOpts = [...root.querySelectorAll<HTMLElement>('[data-st-opt="job"]')];
      const propOpts = [...root.querySelectorAll<HTMLElement>('[data-st-opt="prop"]')];
      const storeysOpts = [...root.querySelectorAll<HTMLElement>('[data-st-opt="storeys"]')];

      let verts = [...root.querySelectorAll<SVGCircleElement>(".st-vert")];
      let dims = [...root.querySelectorAll<SVGGElement>(".st-dim")];
      let lens = lines.map((l) => Math.ceil(l.getTotalLength()) + 2);
      lines.forEach((l, i) => {
        l.style.strokeDasharray = String(lens[i]);
      });

      let scene = allScenes[0];
      let available: RoofScene[] = [allScenes[0]];
      let sceneIdx = 0;
      let postcode = scene.postcode;
      let areaM2 = scene.areaM2;

      function rebuildGeometry(s: RoofScene) {
        fill.setAttribute("d", s.roofPath);
        lines.forEach((l) => l.setAttribute("d", s.roofPath));
        lens = lines.map((l) => Math.ceil(l.getTotalLength()) + 2);
        lines.forEach((l, i) => {
          l.style.strokeDasharray = String(lens[i]);
          l.style.strokeDashoffset = String(lens[i]);
        });

        vertsG.replaceChildren();
        s.corners.forEach((p, i) => {
          const el = document.createElementNS(SVG_NS, "circle");
          el.setAttribute("class", "st-vert");
          el.setAttribute("cx", String(p.x));
          el.setAttribute("cy", String(p.y));
          el.setAttribute("r", "4.5");
          el.style.setProperty("--i", String(i));
          el.style.opacity = "0";
          vertsG.appendChild(el);
        });
        verts = [...vertsG.querySelectorAll<SVGCircleElement>(".st-vert")];

        dimsG.replaceChildren();
        s.edges.forEach((e, i) => {
          const g = document.createElementNS(SVG_NS, "g");
          g.setAttribute("class", "st-dim");
          g.style.setProperty("--i", String(i));
          g.style.opacity = "0";
          const rot = `rotate(${e.angle.toFixed(2)} ${e.x.toFixed(1)} ${e.y.toFixed(1)})`;
          const rect = document.createElementNS(SVG_NS, "rect");
          rect.setAttribute("class", "st-dim-plate");
          rect.setAttribute("x", String(e.x - 34));
          rect.setAttribute("y", String(e.y - 15));
          rect.setAttribute("width", "68");
          rect.setAttribute("height", "30");
          rect.setAttribute("rx", "8");
          rect.setAttribute("transform", rot);
          const text = document.createElementNS(SVG_NS, "text");
          text.setAttribute("class", "st-dim-text");
          text.setAttribute("x", String(e.x));
          text.setAttribute("y", String(e.y));
          text.setAttribute("transform", rot);
          text.textContent = `${e.metres} m`;
          g.append(rect, text);
          dimsG.appendChild(g);
        });
        dims = [...dimsG.querySelectorAll<SVGGElement>(".st-dim")];

        areaPlate.setAttribute("x", String(s.centroid.x - 108));
        areaPlate.setAttribute("y", String(s.centroid.y - 40));
        areaText.setAttribute("x", s.centroid.x.toFixed(1));
        areaText.setAttribute("y", s.centroid.y.toFixed(1));
      }

      function applyScene(s: RoofScene) {
        scene = s;
        postcode = s.postcode;
        areaM2 = s.areaM2;
        root.dataset.postcode = s.postcode;
        root.dataset.area = String(s.areaM2);

        photo.src = s.photo;
        photo.srcset = `${s.photo760} 760w, ${s.photo} 1280w`;
        rebuildGeometry(s);

        meta.textContent = s.meta;
        notifBody.textContent = `${s.postcode} · ${s.areaM2} m² ${s.shape}`;
        notifPrice.textContent = s.price;
        leadName.textContent = CONTACT_NAME;
        leadPc.textContent = s.postcode;
        leadPrice.textContent = s.price;
        detailPrice.textContent = s.price;
        detailArea.textContent = `${s.areaM2} m²`;
        detailShape.textContent = s.shape;
        detailPc.textContent = s.postcode;
      }

      function showPanel(which: "job" | "prop" | "storeys") {
        (Object.keys(panels) as Array<keyof typeof panels>).forEach((k) => {
          panels[k].classList.toggle("is-on", k === which);
        });
      }

      function pickOpt(opts: HTMLElement[], value: string, on: boolean) {
        opts.forEach((o) => {
          o.classList.toggle("is-sel", on && o.dataset.value === value);
        });
      }

      function typeField(
        el: HTMLElement,
        caretEl: HTMLElement,
        full: string,
        p: number,
        from: number,
        to: number,
      ) {
        const t = span(p, from, to);
        const n = Math.round(t * full.length);
        el.textContent = full.slice(0, n);
        const live = p >= from && p < to + 0.01;
        caretEl.style.opacity = live
          ? Math.floor((p * DUR) / 450) % 2
            ? "0.2"
            : "1"
          : "0";
      }

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) {
        lines.forEach((l) => (l.style.strokeDashoffset = "0"));
        areaText.textContent = `${areaM2} m²`;
        return;
      }

      function render(p: number) {
        if (progress) progress.style.transform = `scaleX(${clamp01(p)})`;

        // —— Ask ——
        const t = span(p, BEATS.typeFrom, BEATS.typeTo);
        typed.textContent = postcode.slice(0, Math.round(t * postcode.length));
        const liveAsk = p > 0.015 && p < BEATS.press;
        caret.style.opacity = liveAsk
          ? Math.floor((p * DUR) / 500) % 2
            ? "0.25"
            : "1"
          : "0";
        const press = span(p, BEATS.press, BEATS.press + 0.015);
        btn.style.transform = `scale(${1 - 0.06 * Math.sin(press * Math.PI)})`;

        const askOut = inOutCubic(span(p, BEATS.askOutFrom, BEATS.askOutTo));
        ask.style.opacity = String(1 - askOut);
        ask.style.transform = `scale(${1 + 0.2 * askOut})`;
        ask.style.filter = askOut > 0 ? `blur(${14 * askOut}px)` : "none";
        ask.style.pointerEvents = askOut > 0.9 ? "none" : "auto";

        // —— Flow choices ——
        const flowIn = outCubic(span(p, BEATS.flowInFrom, BEATS.flowInTo));
        const flowOut = span(p, BEATS.flowOutFrom, BEATS.flowOutTo);
        flow.style.opacity = String(flowIn * (1 - flowOut));
        flow.style.transform = `scale(${0.96 + 0.04 * flowIn})`;

        if (p < BEATS.propShow) showPanel("job");
        else if (p < BEATS.storeysShow) showPanel("prop");
        else showPanel("storeys");

        const picks = picksFor(scene);
        pickOpt(jobOpts, JOB_PICK, p >= BEATS.jobPick);
        pickOpt(propOpts, picks.prop, p >= BEATS.propPick);
        pickOpt(storeysOpts, picks.storeys, p >= BEATS.storeysPick);

        // —— Contact ——
        const cIn = outCubic(span(p, BEATS.contactInFrom, BEATS.contactInTo));
        const cOut = span(p, BEATS.contactOutFrom, BEATS.contactOutTo);
        contact.style.opacity = String(cIn * (1 - cOut));
        contact.style.transform = `translate3d(0, ${(1 - cIn) * 10}px, 0)`;

        typeField(nameEl, nameCaret, CONTACT_NAME, p, BEATS.nameFrom, BEATS.nameTo);
        typeField(phoneEl, phoneCaret, CONTACT_PHONE, p, BEATS.phoneFrom, BEATS.phoneTo);
        typeField(emailEl, emailCaret, CONTACT_EMAIL, p, BEATS.emailFrom, BEATS.emailTo);
        continueBtn.classList.toggle("is-ready", p >= BEATS.continueReady && p < BEATS.contactOutTo);

        // —— Map whip + measure ——
        const w = inOutCubic(span(p, BEATS.whipFrom, BEATS.whipTo));
        const mapOut = span(p, BEATS.mapOutFrom, BEATS.mapOutTo);
        const settle = span(p, BEATS.whipTo, BEATS.traceTo);
        stage.style.transform = `scale(${1.16 - 0.13 * outCubic(settle) - 0.04 * mapOut})`;
        stage.style.filter = w < 1 && w > 0 ? `blur(${10 * (1 - w)}px)` : "none";
        map.style.opacity = String(w * (1 - mapOut));

        const tr = span(p, BEATS.traceFrom, BEATS.traceTo);
        verts.forEach((v, i) => {
          const local = clamp01((tr - (i / Math.max(verts.length, 1)) * 0.55) / 0.12);
          v.style.opacity = String(local);
          v.style.transform = `scale(${0.3 + 0.7 * outCubic(local)})`;
        });
        const draw = outCubic(clamp01((tr - 0.18) / 0.82));
        lines.forEach((l, i) => {
          l.style.strokeDashoffset = String(lens[i] * (1 - draw));
        });
        fill.style.opacity = String(span(p, BEATS.fillFrom, BEATS.fillTo));

        const d = span(p, BEATS.dimsFrom, BEATS.dimsTo);
        dims.forEach((g, i) => {
          g.style.opacity = String(clamp01((d - i * 0.16) / 0.3));
        });
        const a = span(p, BEATS.areaFrom, BEATS.areaTo);
        area.style.opacity = String(clamp01(a * 3));
        areaText.textContent = `${Math.round(outCubic(a) * areaM2)} m²`;
        meta.style.opacity = String(span(p, BEATS.dimsFrom, BEATS.dimsTo) * (1 - mapOut));

        // —— Roofer ——
        const leadIn = span(p, BEATS.leadFrom, BEATS.leadTo);
        const leadOut = span(p, BEATS.holdTo, 1);
        lead.style.opacity = String(leadIn * (1 - leadOut));

        const nf = span(p, BEATS.notifFrom, BEATS.notifTo);
        const nfOut = span(p, BEATS.notifOutFrom, BEATS.notifOutTo);
        notif.style.opacity = String(nf * (1 - nfOut));
        notif.style.transform = `translate3d(0, ${-22 * (1 - outCubic(nf)) - 8 * nfOut}px, 0) scale(${
          0.96 + 0.04 * outCubic(nf) - 0.04 * nfOut
        })`;

        const df = outCubic(span(p, BEATS.dashFrom, BEATS.dashTo));
        dash.style.opacity = String(df * (1 - leadOut));
        dash.style.transform = `translate3d(0, ${(1 - df) * 16}px, 0) scale(${0.97 + 0.03 * df})`;

        const rowT = span(p, BEATS.rowFrom, BEATS.rowTo);
        rowNew.classList.toggle("is-in", rowT > 0.2);
        rowNew.style.opacity = String(rowT);
        detail.classList.toggle("is-open", span(p, BEATS.detailFrom, BEATS.detailTo) > 0.35);
      }

      const params = new URLSearchParams(location.search);
      const forced = params.get("rs");
      const forcedScene = params.get("rsScene");

      async function boot() {
        const probed = await Promise.all(allScenes.map(probeScene));
        available = probed.filter((s): s is RoofScene => Boolean(s));
        if (!available.length) available = [allScenes[0]];

        if (forcedScene) {
          const hit = available.find((s) => s.id === forcedScene);
          if (hit) {
            sceneIdx = available.indexOf(hit);
            applyScene(hit);
          }
        }

        if (forced !== null) {
          render(clamp01(Number(forced)));
          return;
        }

        let raf = 0;
        let t0 = 0;
        let lastCycle = -1;

        const loop = (now: number) => {
          if (!t0) t0 = now;
          const elapsed = now - t0;
          const cycle = Math.floor(elapsed / DUR);
          if (cycle !== lastCycle) {
            if (lastCycle >= 0 && available.length > 1) {
              sceneIdx = (sceneIdx + 1) % available.length;
              applyScene(available[sceneIdx]);
            }
            lastCycle = cycle;
          }
          render((elapsed % DUR) / DUR);
          raf = requestAnimationFrame(loop);
        };

        const io = new IntersectionObserver(
          ([e]) => {
            if (e.isIntersecting) {
              if (!raf) raf = requestAnimationFrame(loop);
            } else {
              cancelAnimationFrame(raf);
              raf = 0;
              t0 = 0;
              lastCycle = -1;
            }
          },
          { threshold: 0.2 },
        );
        io.observe(root);
      }

      void boot();
    });
  }

  initRoofStory();
  document.addEventListener("astro:after-swap", initRoofStory);
</script>
