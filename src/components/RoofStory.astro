---
// The hero's story animation: customer journey → satellite measure → roofer
// inbox payoff. One scrubbed JS clock (BEATS). Progress bar tracks the cycle.
//
// Loops cycle through ROOF_SCENES (westminster → terrace → bungalow) whenever
// the matching satellite images are present in /public. Scene 1 always ships;
// 2–3 join automatically once their .webp files exist.
//
// Scrub: ?rs=0.42 freezes the timeline. ?rsScene=terrace picks a scene.
import { ROOF_SCENES } from "./roof-story-scenes";

const boot = ROOF_SCENES[0];
const roofPath = boot.roofPath;
const corners = boot.corners;
const edges = boot.edges;
const c = boot.centroid;
const POSTCODE = boot.postcode;
const PRICE = boot.price;
const META = boot.meta;
const AREA_M2 = boot.areaM2;
const scenesJson = JSON.stringify(ROOF_SCENES);

const CONTACT = {
  name: "James Whitaker",
  phone: "07700 900142",
  email: "james@whitaker.co.uk",
};
---

<figure
  class="st"
  data-roof-story
  data-postcode={POSTCODE}
  data-area={String(AREA_M2)}
  data-contact-name={CONTACT.name}
  data-contact-phone={CONTACT.phone}
  data-contact-email={CONTACT.email}
  aria-hidden="true"
>
  <script type="application/json" data-st-scenes set:html={scenesJson}></script>

  <!-- 1 — Customer types a postcode (mirrors the collapsed embed bar). -->
  <div class="st-scene st-ask" data-st-ask>
    <div class="st-ask-inner">
      <div class="st-bar">
        <svg class="st-pin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
          />
          <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2" />
        </svg>
        <span class="st-typed" data-st-typed></span><span class="st-caret" data-st-caret></span>
        <span class="st-btn" data-st-btn>Get quote</span>
      </div>
    </div>
  </div>

  <!-- 2 — Widget choice steps (job → property → storeys). Not pixel-perfect. -->
  <div class="st-scene st-flow" data-st-flow>
    <div class="st-sheet">
      <div class="st-sheet-panel is-on" data-st-panel="job">
        <p class="st-sheet-h">What do you need doing?</p>
        <div class="st-opts">
          <span class="st-opt" data-st-opt="job" data-value="full">Full roof replacement</span>
          <span class="st-opt" data-st-opt="job" data-value="repair">Tile or slate repair</span>
          <span class="st-opt" data-st-opt="job" data-value="gutter">Gutters &amp; fascias</span>
        </div>
      </div>
      <div class="st-sheet-panel" data-st-panel="prop">
        <p class="st-sheet-h">What type of property is it?</p>
        <div class="st-opts st-opts--2">
          <span class="st-opt" data-st-opt="prop" data-value="detached">Detached</span>
          <span class="st-opt" data-st-opt="prop" data-value="semi">Semi-detached</span>
          <span class="st-opt" data-st-opt="prop" data-value="terrace">Terrace</span>
          <span class="st-opt" data-st-opt="prop" data-value="bungalow">Bungalow</span>
        </div>
      </div>
      <div class="st-sheet-panel" data-st-panel="storeys">
        <p class="st-sheet-h">How many storeys?</p>
        <div class="st-opts st-opts--2">
          <span class="st-opt" data-st-opt="storeys" data-value="1">1 storey</span>
          <span class="st-opt" data-st-opt="storeys" data-value="2">2 storeys</span>
          <span class="st-opt" data-st-opt="storeys" data-value="3">3 storeys</span>
          <span class="st-opt" data-st-opt="storeys" data-value="4">4+</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3 — Contact details. -->
  <div class="st-scene st-contact" data-st-contact>
    <div class="st-sheet">
      <p class="st-sheet-h">Where should we send the quote?</p>
      <div class="st-fields">
        <label class="st-field">
          <span class="st-field-l">Name</span>
          <span class="st-field-v"
            ><span data-st-name></span><span class="st-caret st-caret--field" data-st-name-caret
            ></span></span
          >
        </label>
        <label class="st-field">
          <span class="st-field-l">Mobile</span>
          <span class="st-field-v"
            ><span data-st-phone></span><span class="st-caret st-caret--field" data-st-phone-caret
            ></span></span
          >
        </label>
        <label class="st-field">
          <span class="st-field-l">Email</span>
          <span class="st-field-v"
            ><span data-st-email></span><span class="st-caret st-caret--field" data-st-email-caret
            ></span></span
          >
        </label>
      </div>
      <span class="st-continue" data-st-continue>Continue</span>
    </div>
  </div>

  <!-- 4 — Satellite measure (the hero beat). -->
  <div class="st-scene st-map" data-st-map>
    <div class="st-stage" data-st-stage>
      <img
        class="st-photo"
        data-st-photo
        src={boot.photo}
        srcset={`${boot.photo760} 760w, ${boot.photo} 1280w`}
        sizes="(min-width: 1024px) 46vw, 92vw"
        alt=""
        width="1280"
        height="960"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <svg class="st-overlay" viewBox="0 0 1024 768" preserveAspectRatio="xMidYMid slice">
        <defs>
          <filter id="st-glow-soft" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="6" result="b" />
            <feMerge><feMergeNode in="b" /></feMerge>
          </filter>
          <filter id="st-glow-core" x="-35%" y="-35%" width="170%" height="170%">
            <feGaussianBlur stdDeviation="2" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>

        <path class="st-fill" d={roofPath} data-st-fill />
        <path class="st-glow" d={roofPath} filter="url(#st-glow-soft)" data-st-line />
        <path class="st-line" d={roofPath} filter="url(#st-glow-core)" data-st-line />

        <g data-st-verts>
          {corners.map((p, i) => (
            <circle class="st-vert" cx={p.x} cy={p.y} r="4.5" style={`--i:${i}`} />
          ))}
        </g>

        <g data-st-dims>
          {edges.map((e, i) => (
            <g class="st-dim" style={`--i:${i}`}>
              <rect
                class="st-dim-plate"
                x={e.x - 34}
                y={e.y - 15}
                width="68"
                height="30"
                rx="8"
                transform={`rotate(${e.angle.toFixed(2)} ${e.x.toFixed(1)} ${e.y.toFixed(1)})`}
              />
              <text
                class="st-dim-text"
                x={e.x}
                y={e.y}
                transform={`rotate(${e.angle.toFixed(2)} ${e.x.toFixed(1)} ${e.y.toFixed(1)})`}
              >{e.metres} m</text>
            </g>
          ))}
        </g>

        <g data-st-area class="st-area">
          <rect
            class="st-area-plate"
            data-st-area-plate
            x={c.x - 108}
            y={c.y - 40}
            width="216"
            height="80"
            rx="16"
          />
          <text
            class="st-area-text"
            x={c.x.toFixed(1)}
            y={c.y.toFixed(1)}
            data-st-area-text
          >0 m²</text>
        </g>
      </svg>
    </div>

    <figcaption class="st-meta" data-st-meta>{META}</figcaption>
  </div>

  <!-- 5 — Roofer payoff: notification, then quotes inbox + lead detail. -->
  <div class="st-scene st-lead" data-st-lead>
    <div class="st-notif" data-st-notif>
      <div class="st-notif-top">
        <img
          class="st-notif-mark"
          src="/belpa-wordmark.png"
          alt=""
          width="900"
          height="279"
        />
        <span class="st-notif-time">now</span>
      </div>
      <p class="st-notif-title">New lead</p>
      <p class="st-notif-body" data-st-notif-body>
        {POSTCODE} · {AREA_M2} m² {boot.shape}
      </p>
      <p class="st-notif-price">
        <span data-st-notif-price>{PRICE}</span><span class="st-notif-vat"> ex VAT</span>
      </p>
    </div>

    <div class="st-dash" data-st-dash>
      <div class="st-dash-head">
        <div>
          <p class="st-dash-title">Quotes</p>
          <p class="st-dash-sub">Every lead your widget has captured.</p>
        </div>
        <img class="st-dash-mark" src="/belpa-wordmark.png" alt="" width="900" height="279" />
      </div>

      <div class="st-dash-filters">
        <span class="st-pill is-on">All <em>12</em></span>
        <span class="st-pill">New <em>4</em></span>
        <span class="st-pill">Contacted <em>5</em></span>
        <span class="st-pill">Completed <em>2</em></span>
      </div>

      <div class="st-dash-table">
        <div class="st-dash-cols">
          <span>Contact</span><span>Job</span><span>Estimate</span><span>Status</span>
        </div>

        <!-- Incoming lead — slides in mid-beat. -->
        <div class="st-row st-row--new" data-st-row-new>
          <div class="st-row-dot" aria-hidden="true"></div>
          <div class="st-row-contact">
            <strong data-st-lead-name>{CONTACT.name}</strong>
            <span data-st-lead-pc>{POSTCODE}</span>
          </div>
          <span class="st-row-job">Full replacement</span>
          <span class="st-row-price" data-st-lead-price>{PRICE}</span>
          <span class="st-status">New</span>
        </div>

        <div class="st-detail" data-st-detail>
          <div class="st-detail-inner">
            <div class="st-detail-grid">
              <div>
                <p class="st-detail-price" data-st-detail-price>{PRICE}</p>
                <p class="st-detail-vat">ex. VAT · indicative band</p>
                <p class="st-detail-job">Full roof replacement</p>
                <span class="st-status">New</span>
              </div>
              <div class="st-detail-stats">
                <div>
                  <span class="st-detail-k">Measured</span>
                  <span class="st-detail-v" data-st-detail-area>{AREA_M2} m²</span>
                </div>
                <div>
                  <span class="st-detail-k">Roof</span>
                  <span class="st-detail-v" data-st-detail-shape>{boot.shape}</span>
                </div>
                <div>
                  <span class="st-detail-k">Postcode</span>
                  <span class="st-detail-v" data-st-detail-pc>{POSTCODE}</span>
                </div>
                <div>
                  <span class="st-detail-k">Phone</span>
                  <span class="st-detail-v">{CONTACT.phone}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="st-row st-row--muted">
          <div class="st-row-contact">
            <strong>Priya Raval</strong>
            <span>HP13 5BP</span>
          </div>
          <span class="st-row-job">Tile repair</span>
          <span class="st-row-price">£1,350</span>
          <span class="st-status st-status--contacted">Contacted</span>
        </div>
        <div class="st-row st-row--muted">
          <div class="st-row-contact">
            <strong>Tom Whitfield</strong>
            <span>CF10 1EP</span>
          </div>
          <span class="st-row-job">Full replacement</span>
          <span class="st-row-price">£9,200</span>
          <span class="st-status">New</span>
        </div>
      </div>
    </div>
  </div>

  <div class="st-progress" aria-hidden="true">
    <div class="st-progress-fill" data-st-progress></div>
  </div>
</figure>

<style>
  .st {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 0;
    aspect-ratio: 7 / 5;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: #0d1220;
    box-shadow:
      0 0 0 1px rgba(21, 55, 140, 0.16),
      0 2px 8px rgba(16, 24, 40, 0.08),
      0 28px 60px -28px rgba(23, 60, 160, 0.5);
  }
  @media (min-width: 1200px) {
    .st {
      aspect-ratio: 5 / 4;
      border-radius: 24px;
      min-height: min(28rem, 48vh);
    }
  }

  .st-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 8;
    height: 3px;
    background: rgba(255, 255, 255, 0.14);
    pointer-events: none;
  }
  .st-progress-fill {
    height: 100%;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(
      90deg,
      rgba(91, 140, 255, 0.85),
      var(--color-brand-500, #2f6bff)
    );
    will-change: transform;
  }

  .st-scene {
    position: absolute;
    inset: 0;
  }

  /* —— Ask —— */
  .st-ask {
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse 70% 60% at 50% 40%, #ffffff 0%, #f3f6fc 60%, #e8eefb 100%);
    z-index: 4;
  }
  .st-ask-inner {
    width: min(82%, 460px);
  }
  .st-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.7rem 0.7rem 0.95rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(23, 60, 160, 0.12);
    box-shadow: 0 18px 40px -22px rgba(10, 32, 90, 0.55);
    font-size: clamp(0.8rem, 1.5cqw, 0.95rem);
  }
  .st-pin {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    color: var(--color-ink-soft);
  }
  .st-typed {
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    white-space: pre;
  }
  .st-caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 1px;
    background: var(--color-brand-500);
    opacity: 0;
  }
  .st-caret--field {
    height: 1em;
    vertical-align: -0.1em;
  }
  .st-btn {
    margin-left: auto;
    flex: none;
    padding: 0.5em 0.95em;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--color-brand-500), var(--color-brand-600));
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
  }

  /* —— Flow / contact sheets —— */
  .st-flow,
  .st-contact {
    display: grid;
    place-items: center;
    padding: 6% 7%;
    background:
      radial-gradient(ellipse 70% 60% at 50% 35%, #ffffff 0%, #f2f5fc 55%, #e6edfa 100%);
    opacity: 0;
    z-index: 3;
  }
  .st-sheet {
    width: min(100%, 420px);
    padding: 1.15rem 1.15rem 1.2rem;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(23, 60, 160, 0.1);
    box-shadow: 0 22px 48px -28px rgba(10, 32, 90, 0.55);
  }
  .st-sheet-h {
    margin: 0 0 0.85rem;
    text-align: center;
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(1.05rem, 2.4cqw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .st-sheet-panel {
    display: none;
  }
  .st-sheet-panel.is-on {
    display: block;
  }
  .st-opts {
    display: grid;
    gap: 0.45rem;
  }
  .st-opts--2 {
    grid-template-columns: 1fr 1fr;
  }
  .st-opt {
    display: flex;
    align-items: center;
    min-height: 2.55rem;
    padding: 0.55rem 0.85rem;
    border-radius: 14px;
    border: 1.5px solid rgba(23, 60, 160, 0.12);
    background: #fff;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-ink);
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease,
      box-shadow 0.15s ease, transform 0.15s ease;
  }
  .st-opt.is-sel {
    border-color: var(--color-brand-500, #2f6bff);
    background: var(--color-brand-50, #eef4ff);
    color: var(--color-brand-700, #1546c9);
    box-shadow: 0 0 0 1px rgba(47, 107, 255, 0.2);
    transform: scale(1.02);
  }
  .st-fields {
    display: grid;
    gap: 0.55rem;
  }
  .st-field {
    display: grid;
    gap: 0.25rem;
  }
  .st-field-l {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .st-field-v {
    display: block;
    min-height: 2.4rem;
    padding: 0.55rem 0.75rem;
    border-radius: 12px;
    border: 1.5px solid rgba(23, 60, 160, 0.14);
    background: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink);
    white-space: pre;
  }
  .st-continue {
    display: block;
    margin-top: 0.85rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    text-align: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: #fff;
    background: linear-gradient(180deg, var(--color-brand-500), var(--color-brand-600));
    opacity: 0.35;
    transform: scale(0.98);
  }
  .st-continue.is-ready {
    opacity: 1;
    transform: scale(1);
  }

  /* —— Map —— */
  .st-map {
    opacity: 0;
    z-index: 2;
  }
  .st-stage {
    position: absolute;
    inset: 0;
    transform-origin: center center;
    will-change: transform, filter;
  }
  .st-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .st-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .st-fill {
    fill: rgba(47, 107, 255, 0.17);
    opacity: 0;
  }
  .st-glow,
  .st-line {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .st-glow {
    stroke: rgba(120, 175, 255, 1);
    stroke-width: 14;
    opacity: 0.9;
  }
  .st-line {
    stroke: #e8f1ff;
    stroke-width: 3;
  }
  .st-vert {
    fill: #fff;
    stroke: rgba(47, 107, 255, 0.9);
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .st-dim,
  .st-area {
    opacity: 0;
  }
  .st-dim-plate,
  .st-area-plate {
    fill: rgba(7, 16, 36, 0.82);
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1.5;
  }
  .st-dim-text,
  .st-area-text {
    fill: #fff;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-variant-numeric: tabular-nums;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .st-dim-text {
    font-size: 19px;
    font-weight: 600;
  }
  .st-area-text {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .st-meta {
    position: absolute;
    left: clamp(0.85rem, 3%, 1.25rem);
    bottom: clamp(0.85rem, 3.2%, 1.25rem);
    z-index: 3;
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 6px rgba(4, 12, 32, 0.9);
    opacity: 0;
  }

  /* —— Roofer —— */
  .st-lead {
    display: grid;
    place-items: center;
    padding: 5% 6%;
    z-index: 5;
    opacity: 0;
    background:
      radial-gradient(ellipse 90% 70% at 50% 35%, #16224a 0%, #0a1024 55%, #05080f 100%);
  }
  .st-notif {
    width: 100%;
    max-width: 400px;
    padding: 0.85rem 1rem 0.95rem;
    border-radius: 20px;
    background: rgba(244, 247, 255, 0.94);
    box-shadow: 0 10px 24px -12px rgba(3, 10, 28, 0.8);
    opacity: 0;
    transform: translate3d(0, -10px, 0);
    position: absolute;
  }
  .st-notif-top {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .st-notif-mark {
    height: 15px;
    width: auto;
    display: block;
  }
  .st-notif-time {
    margin-left: auto;
    font-size: 0.68rem;
    color: rgba(20, 30, 55, 0.45);
  }
  .st-notif-title {
    margin: 0.45rem 0 0;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #0d1730;
  }
  .st-notif-body {
    margin: 0.15rem 0 0;
    font-size: 0.86rem;
    line-height: 1.35;
    color: rgba(20, 30, 55, 0.66);
  }
  .st-notif-price {
    margin: 0.4rem 0 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-600, #1746c8);
  }
  .st-notif-vat {
    font-size: 0.72em;
    font-weight: 600;
    color: rgba(20, 30, 55, 0.5);
  }

  .st-dash {
    width: 100%;
    max-width: 520px;
    padding: 0.95rem 1rem 0.85rem;
    border-radius: 20px;
    background: rgba(252, 253, 255, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 18px 40px -20px rgba(3, 10, 28, 0.75);
    opacity: 0;
    transform: translate3d(0, 14px, 0) scale(0.98);
  }
  .st-dash-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .st-dash-title {
    margin: 0;
    font-family: var(--font-display, var(--font-sans));
