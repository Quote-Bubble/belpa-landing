  }
  .st-status {
    display: inline-flex;
    width: fit-content;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 700;
    color: #1546c9;
    background: #eef4ff;
  }
  .st-status--contacted {
    color: #6d28d9;
