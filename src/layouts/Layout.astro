---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Belpa: Free roof quotes on your website",
  description = "Free roof quotes on your website. Customers type an address and see a price. You don’t need to drive out first.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    <!-- The blob is the page visual anchor: fetch it before the CSS asks -->
    <link rel="preload" as="image" href="/bg-v3.webp" fetchpriority="high" />
    <!--
      Kill scroll restoration before first paint. Otherwise refresh-on-hero
      restores a few px (or animates there) while fonts/morph shift layout.
    -->
    <script is:inline>
      try {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      } catch (_) {}
      if (!location.hash) {
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        // This block runs in <head>, so document.body is still null here —
        // assigning to it threw on every single page load and aborted the
        // rest of this script. documentElement is the scroller anyway.
        if (document.body) document.body.scrollTop = 0;
      }
    </script>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="site-dots" aria-hidden="true"></div>
    <slot />

    {/*
      Real Belpa widget embed goes here when it's ready, e.g.:
      <script src="https://cdn.belpa.app/embed.js" data-belpa="YOUR_SITE_KEY" defer></script>
      It replaces the placeholder demo in DemoSection.astro (#belpa-widget).
    */}

    <SpeedInsights />
  </body>
</html>

<script>
  // Lenis smooth scrolling — a soft ease-out curve on wheel scrolling.
  // Desktop-feel only: touch keeps native momentum (hijacking touch feels
  // wrong on phones). Skipped entirely for reduced-motion users.
  import Lenis from "lenis";

  declare global {
    interface Window {
      __lenis?: Lenis;
    }
  }

  function pinTop() {
    window.scrollTo(0, 0);
    document.documentElement.scrollTop = 0;
    document.body.scrollTop = 0;
    window.__lenis?.scrollTo(0, { immediate: true, force: true });
  }

  function initLenis() {
    if (window.__lenis) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const lenis = new Lenis({
      // Longer glide. At 1.1 each wheel notch resolved fast enough that a
      // normal mouse (which fires discrete, chunky deltas rather than a
      // trackpad's stream) read as a series of steps instead of one motion.
      // A softer multiplier keeps a single notch from overshooting now that
      // it decays more slowly.
      duration: 2.1,
      wheelMultiplier: 0.85,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });
    window.__lenis = lenis;
    window.dispatchEvent(new CustomEvent("belpa:lenis"));

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // Anchor links ride the same curve
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        if (!a.hash || a.hash === "#") return;
        const target = document.querySelector(a.hash);
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -24 });
      });
    });

    // Fresh loads should start at top; Lenis can inherit a restored offset
    if (!location.hash) pinTop();
  }

  // Hold the top through hero entrance layout shifts unless the user scrolls.
  function holdHeroTop() {
    if (location.hash) return;

    let userScrolled = false;
    const mark = () => {
      userScrolled = true;
    };
    window.addEventListener("wheel", mark, { passive: true, once: true });
    window.addEventListener("touchmove", mark, { passive: true, once: true });
    window.addEventListener("pointerdown", mark, { passive: true, once: true });
    window.addEventListener("keydown", (e) => {
      if (
        e.key === "ArrowDown" ||
        e.key === "ArrowUp" ||
        e.key === "PageDown" ||
        e.key === "PageUp" ||
        e.key === " " ||
        e.key === "Home" ||
        e.key === "End"
      ) {
        mark();
      }
    }, { passive: true, once: true });

    pinTop();

    const started = performance.now();
    const tick = () => {
      if (!userScrolled && !location.hash && window.scrollY > 40) {
        userScrolled = true;
      } else if (!userScrolled && !location.hash && window.scrollY > 0) {
        pinTop();
      }
      if (performance.now() - started < 3200) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    window.addEventListener(
      "pageshow",
      (e) => {
        // bfcache restore can bring back a mid-scroll Lenis state
        if (e.persisted && !location.hash) pinTop();
      },
      { passive: true }
    );
  }

  initLenis();
  holdHeroTop();
  document.addEventListener("astro:after-swap", () => {
    initLenis();
    holdHeroTop();
  });
</script>

<script>
  /**
   * Mobile only: pin the hero blob behind the search + Book a call cluster.
   * Hide until the first measure, then bloom from the correct place so the
   * user never sees a default→shift jump.
   */
  function initBlobAnchor() {
    const bg = document.querySelector<HTMLElement>(".site-bg");
    if (!bg) return;

    const mq = window.matchMedia("(max-width: 640px)");
    // Mask opaque band midpoint on the 1650px mobile layer:
    // ((32% + 48%) / 2) * 1650 + top(-90) ≈ 570px from document top at shift 0.
    const NATURAL_BAND_MID = -90 + 1650 * 0.4;

    const measureShift = (): number | null => {
      const widget = document.querySelector<HTMLElement>("[data-widget-shell]");
      if (!widget) return null;
      const meeting = document.querySelector<HTMLElement>("[data-meeting-spacer]");
      const w = widget.getBoundingClientRect();
      const m = meeting?.getBoundingClientRect();
      const target = m
        ? (w.top + m.bottom) / 2
        : w.top + w.height * 0.55;
      return Math.round(target - NATURAL_BAND_MID);
    };

    const reveal = () => {
      // Force a style flush so the browser applies --blob-shift before bloom.
      void bg.offsetWidth;
      bg.classList.add("is-anchored");
    };

    const pinAndReveal = () => {
      if (!mq.matches) {
        bg.style.removeProperty("--blob-shift");
        bg.classList.add("is-anchored");
        return;
      }
      const shift = measureShift();
      if (shift == null) {
        // Widget not ready — try again next frame, still hidden.
        requestAnimationFrame(pinAndReveal);
        return;
      }
      bg.style.setProperty("--blob-shift", `${shift}px`);
      reveal();
    };

    // Quiet re-pin on orientation / width change only (no mid-bloom nudges).
    let lastW = window.innerWidth;
    const onResize = () => {
      if (window.innerWidth === lastW) return;
      lastW = window.innerWidth;
      if (!mq.matches) {
        bg.style.removeProperty("--blob-shift");
        bg.classList.add("is-anchored");
        return;
      }
      const shift = measureShift();
      if (shift != null) bg.style.setProperty("--blob-shift", `${shift}px`);
    };

    // Double-rAF: layout has the centred hero before we measure.
    requestAnimationFrame(() => {
      requestAnimationFrame(pinAndReveal);
    });

    window.addEventListener("resize", onResize, { passive: true });
    mq.addEventListener("change", () => {
      bg.classList.remove("is-anchored");
      pinAndReveal();
    });

    document.addEventListener("astro:after-swap", () => {
      lastW = window.innerWidth;
      bg.classList.remove("is-anchored");
      requestAnimationFrame(() => {
        requestAnimationFrame(pinAndReveal);
      });
    });
  }

  initBlobAnchor();
</script>

<script>
  // Scroll-triggered reveals — transform/opacity only, one observer for the page.
  function initReveals() {
    const nodes = document.querySelectorAll<HTMLElement>("[data-reveal], [data-stagger]");
    if (!nodes.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      nodes.forEach((el) => el.classList.add("is-in"));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-in");
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
    );

    nodes.forEach((el) => {
      // Already visible on first paint (e.g. tall screens) — reveal immediately
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.9 && rect.bottom > 0) {
        // Stagger a frame so CSS transitions still fire
        requestAnimationFrame(() => el.classList.add("is-in"));
      } else {
        io.observe(el);
      }
    });
  }

  initReveals();
  document.addEventListener("astro:after-swap", initReveals);
</script>

<script>
  // Scroll-linked "cinematic" section effects (desktop). Composes with the
  // reveals above via the individual scale/translate/rotate properties.
  import { initSectionFx } from "../scripts/section-fx";

  let cleanupFx = initSectionFx();
  document.addEventListener("astro:after-swap", () => {
    cleanupFx?.();
    cleanupFx = initSectionFx();
  });
</script>
